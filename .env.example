# REPuLse environment variables
# Copy to .env.local and fill in values (.env*.local is gitignored; never commit it)

# Supabase project URL — found in Project Settings > API
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key — safe to expose to the browser
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase service-role key — server-side only, never expose to client
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional: extra origins allowed to call /api/* (comma-separated)
# ALLOWED_ORIGINS=https://repulse.example.com
