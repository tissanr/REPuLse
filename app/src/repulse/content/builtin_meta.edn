              :see-also ["western" "koto" "lute" "synth"]}

 ;; ── FM instrument presets ───────────────────────────────────────────────────

 :sax        {:type "keyword"
              :detail "(synth :sax) — FM saxophone, reed-like with bore formant shaping and breath noise"
              :signature "(synth :sax)"
              :doc "FM saxophone: reed-like, with bore formant shaping and breath noise."
              :category "synth"
              :description "FM saxophone — index=5, bore formant peaks at ~900 Hz and ~2.2 kHz, subtle breath noise."
              :returns "event-param-map"
              :side-effects []
              :examples ["(->> (scale :minor :c3 (seq 0 3 5 7)) (synth :sax))"
                         "(->> (seq :c3 :eb3 :g3 :bb3) (synth :sax) (amp 0.7))"]
              :see-also ["trumpet" "flute" "fm" "synth"]}

 :trumpet    {:type "keyword"
              :detail "(synth :trumpet) — FM trumpet, bright brass with bell resonance filters and air noise"
              :signature "(synth :trumpet)"
              :doc "FM trumpet: bright brass with bell resonance filters and air noise."
              :category "synth"
              :description "FM trumpet — index=5.5, bell resonance filters at 1.2/2.4/3.5 kHz, breath air noise."
              :returns "event-param-map"
              :side-effects []
              :examples ["(->> (scale :major :c4 (seq 0 2 4 7)) (synth :trumpet))"
                         "(->> (pure :c4) (synth :trumpet) (amp 0.6))"]
              :see-also ["trumpet-muted" "trombone" "harmon-out" "harmon-in" "sax" "synth"]}

 :trumpet-muted {:type "keyword"
                 :detail "(synth :trumpet-muted) — FM straight-muted trumpet, nasal mid peak, cuts lows and highs"
                 :signature "(synth :trumpet-muted)"
                 :doc "FM straight-muted trumpet with a nasal mid peak; cuts lows and highs."
                 :category "synth"
                 :description "FM straight-muted trumpet — cuts lows (<250 Hz), nasal peak at 1.7 kHz, heavy hi-cut above 4 kHz."
                 :returns "event-param-map"
                 :side-effects []
                 :examples ["(->> (scale :major :c4 (seq 0 2 4)) (synth :trumpet-muted))"
                            "(->> (pure :g4) (synth :trumpet-muted) (amp 0.5))"]
                 :see-also ["trumpet" "harmon-out" "harmon-in" "synth-brass" "synth"]}

 :trombone   {:type "keyword"
              :detail "(synth :trombone) — FM trombone, warm with 120ms attack setup time"
              :signature "(synth :trombone)"
              :doc "FM trombone: warm, with a 120 ms attack setup time."
              :category "synth"
              :description "FM trombone — 120ms attack for the characteristic 'setup' time, warm body filters, low breath noise."
              :returns "event-param-map"
              :side-effects []
              :examples ["(->> (scale :minor :c2 (slow 2 (seq 0 3 5 7))) (synth :trombone))"
                         "(->> (pure :c3) (synth :trombone) (amp 0.7))"]
              :see-also ["trumpet" "sax" "synth"]}

 :synth-brass {:type "keyword"
               :detail "(synth :synth-brass) — synthetic lo-fi brass texture, inharmonic ratio for grit"
               :signature "(synth :synth-brass)"
               :doc "Synthetic lo-fi brass texture; an inharmonic ratio adds grit."
               :category "synth"
               :description "Synthetic lo-fi brass — inharmonic ratio (√2) and high index=7 produce gritty nasal texture. Formerly :trumpet-muted."
               :returns "event-param-map"
               :side-effects []
               :examples ["(->> (scale :major :c4 (seq 0 2 4)) (synth :synth-brass))"
                          "(->> (pure :g4) (synth :synth-brass) (amp 0.5))"]
               :see-also ["trumpet-muted" "harmon-out" "synth"]}

 :harmon-out  {:type "keyword"
               :detail "(synth :harmon-out) — harmon mute stem out, Miles Davis nasal peak around 1.1kHz"
               :signature "(synth :harmon-out)"
               :doc "FM harmon mute with the stem out: a nasal peak around 1.1 kHz."
               :category "synth"
               :description "Harmon mute stem out — heavy bandpass around 1.1 kHz, cuts lows and everything above 2.8 kHz. Classic Miles Davis sound."
               :returns "event-param-map"
               :side-effects []
               :examples ["(->> (scale :minor :c4 (seq 0 3 5 7)) (synth :harmon-out))"
                          "(->> (pure :d4) (synth :harmon-out) (slow 2) (amp 0.6))"]
               :see-also ["harmon-in" "trumpet-muted" "synth"]}

 :harmon-in   {:type "keyword"
               :detail "(synth :harmon-in) — harmon mute stem in, more closed and buzzy than stem-out"
               :signature "(synth :harmon-in)"
               :doc "FM harmon mute with the stem in: more closed and buzzy than stem-out."
               :category "synth"
               :description "Harmon mute stem in — tighter peak at ~850 Hz, heavier hi-cut than stem-out. More closed, buzzier character."
               :returns "event-param-map"
               :side-effects []
               :examples ["(->> (scale :minor :c4 (seq 0 3 5 7)) (synth :harmon-in))"
                          "(->> (pure :d4) (synth :harmon-in) (slow 2) (amp 0.6))"]
               :see-also ["harmon-out" "trumpet-muted" "synth"]}

 :epiano     {:type "keyword"
              :detail "(synth :epiano) — FM electric piano, Rhodes-style metallic shimmer"
              :signature "(synth :epiano)"
              :doc "FM electric piano with a Rhodes-style metallic shimmer."
              :category "synth"
              :description "FM electric piano (Rhodes-style) — high modulator ratio (14×) gives metallic shimmer; zero sustain means it fades naturally after the transient."
              :returns "event-param-map"
              :side-effects []
              :examples ["(->> (chord :maj7 :c4 (slow 2 (seq 0 4 7 11))) (synth :epiano))"
                         "(->> (scale :major :c4 (seq 0 2 4 5)) (synth :epiano) (amp 0.5))"]
              :see-also ["bell" "marimba" "fm" "synth"]}

 :bell       {:type "keyword"
              :detail "(synth :bell) — FM bell, inharmonic ring over 1s"
              :signature "(synth :bell)"
              :doc "FM bell with an inharmonic ring over about one second."
              :category "synth"
              :description "FM bell — inharmonic ratio (√2) with a slow 1.2s ring; zero sustain, long decay."
              :returns "event-param-map"
              :side-effects []
              :examples ["(->> (fast 2 (scale :major :c5 (seq 0 2 4 5))) (synth :bell))"
                         "(->> (seq :c5 :e5 :g5 :b5) (synth :bell) (slow 2))"]
              :see-also ["marimba" "epiano" "fm" "synth"]}

 :marimba    {:type "keyword"
              :detail "(synth :marimba) — FM marimba, percussive woody attack"
              :signature "(synth :marimba)"
              :doc "FM marimba with a percussive, woody attack."
              :category "synth"
              :description "FM marimba — high modulator ratio (3.5×), percussive 0.35s decay to silence."
              :returns "event-param-map"
              :side-effects []
              :examples ["(->> (scale :major :c4 (fast 2 (seq 0 2 4 5 7))) (synth :marimba))"
                         "(->> (seq :c4 :g4 :c5) (synth :marimba) (amp 0.6))"]
              :see-also ["bell" "epiano" "fm" "synth"]}

 :flute      {:type "keyword"
              :detail "(synth :flute) — FM flute, breathy with slow attack"
              :signature "(synth :flute)"
              :doc "FM flute: breathy, with a slow attack."
              :category "synth"
              :description "FM flute — low modulation index, slow 60ms attack, high sustained level."
              :returns "event-param-map"
              :side-effects []
              :examples ["(->> (scale :major :c5 (seq 0 2 4 5)) (synth :flute))"
                         "(->> (pure :g5) (synth :flute) (slow 2) (amp 0.6))"]
              :see-also ["sax" "fm" "synth"]}

 ;; ── Per-event inserts (Phase TL7a) ─────────────────────────────────────────
 :cutoff     {:type "function"
              :detail "(cutoff hz pat) — alias of lpf: per-event low-pass 20–20000 Hz"
              :signature "(cutoff hz pat) or (cutoff hz)"
              :doc "Alias of lpf: per-event low-pass cutoff in Hz (20–20000)."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(cutoff 800 (seq :c3 :eb3 :g3))"]
              :see-also ["lpf" "resonance"]}

 :resonance  {:type "function"
              :detail "(resonance q pat) — Q of the per-event lpf, 0.1–30 (default 0.707)"
              :signature "(resonance q pat) or (resonance q)"
              :doc "Q of the per-event low-pass, 0.1–30 (default 0.707). No effect without lpf."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :c2 :c2 :eb2 :g1) (synth :saw) (lpf 600) (resonance 8))"]
              :see-also ["lpf" "cutoff" "hpq" "bpq"]}

 :hpq        {:type "function"
              :detail "(hpq q pat) — Q of the per-event hpf, 0.1–30 (default 0.707)"
              :signature "(hpq q pat) or (hpq q)"
              :doc "Q of the per-event high-pass, 0.1–30 (default 0.707). No effect without hpf."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :c3 :g3) (synth :saw) (hpf 800) (hpq 5))"]
              :see-also ["hpf" "resonance"]}

 :bpq        {:type "function"
              :detail "(bpq q pat) — Q of the per-event bpf, 0.1–30 (default 1)"
              :signature "(bpq q pat) or (bpq q)"
              :doc "Q of the per-event band-pass, 0.1–30 (default 1). No effect without bpf."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :sd) (bpf 1500) (bpq 8))"]
              :see-also ["bpf" "resonance"]}

 :shape      {:type "function"
              :detail "(shape amount pat) — per-event soft waveshaper, 0–0.99 (0 = off)"
              :signature "(shape amount pat) or (shape amount)"
              :doc "Per-event soft waveshaper, amount 0–0.99 (0 = off): y = (1+k)·x / (1+k·|x|), k = 2a/(1−a). Runs after the filters and crush."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :bd :_ :bd :_) (shape 0.6))"
                         "(->> (seq :c3 :eb3 :g3) (synth :saw) (hpf 300) (shape 0.4))"]
              :see-also ["crush" "lpf" "gain"]}

 :crush      {:type "function"
              :detail "(crush bits pat) — per-event bit-depth quantiser, 1–16 bits (16 = off)"
              :signature "(crush bits pat) or (crush bits)"
              :doc "Per-event bit-depth quantiser, 1–16 bits (16 = off). Runs after the filters, before shape. For a whole track use (fx :bitcrusher …)."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :bd :sd :bd :sd) (crush (seq 16 4)))"]
              :see-also ["shape" "bitcrush"]}

 :velocity   {:type "function"
              :detail "(velocity v pat) — per-event velocity 0–1; multiplies amp, or picks the recording layer on kit banks"
              :signature "(velocity v pat) or (velocity v)"
              :doc "Per-event velocity 0–1 (default 1). Final voice level = amp × gain × velocity. On layered kit banks ((bank :JazzKit), (bank :StudioKit)) it instead picks the recording layer and a level within it; velocity 0 is silent."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :bd :sd :bd :sd) (velocity (seq 1 0.6)))" "(->> (seq :sd :sd :sd :sd) (velocity \"0.15 0.4 0.7 1\"))"]
              :see-also ["gain" "amp" "bank"]}

 ;; ── Phase TL7b: reverb & delay sends per orbit ─────────────────────────────
 :room       {:type "function"
              :detail "(room level pat) — per-event reverb send 0–1 into the event's orbit"
              :signature "(room level pat) or (room level)"
              :doc "Per-event reverb send 0–1 (default 0) into the reverb of the event's orbit. The dry signal still goes through the track's fx; the orbit returns into the master. Patternable, accepts signals."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :c4 :e4 :g4 :b4) (synth :epiano) (room (seq 0 0.6)) (size 0.8))"]
              :see-also ["size" "orbit" "delay" "fx"]}

 :size       {:type "function"
              :detail "(size s pat) — orbit reverb size 0–1 (IR 0.3 + 5.7·s s, default 0.5); last event wins"
              :signature "(size s pat) or (size s)"
              :doc "Reverb size of the event's orbit, 0–1 (default 0.5): impulse response 0.3 + 5.7·size seconds. Last event wins per orbit; (stop) resets it. Changing it while a tail rings may click."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :sd :_ :sd :_) (room 0.5) (size 1))"]
              :see-also ["room" "orbit"]}

 :delay      {:type "function"
              :detail "(delay level pat) — per-event delay send 0–1 into the event's orbit"
              :signature "(delay level pat) or (delay level)"
              :doc "Per-event delay send 0–1 (default 0) into the feedback delay of the event's orbit. For a delay on a whole track use (fx :delay …)."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :sd :_ :_ :_) (delay 0.4) (delay-time 0.375) (delay-feedback 0.5))"]
              :see-also ["delay-time" "delay-feedback" "orbit" "room"]}

 :delay-time {:type "function"
              :detail "(delay-time secs pat) — orbit delay time 0.01–4 s (default 0.25); last event wins"
              :signature "(delay-time secs pat) or (delay-time secs)"
              :doc "Delay time of the event's orbit in seconds, 0.01–4 (default 0.25). Last event wins per orbit; (stop) resets it."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :sd :_ :_ :_) (delay 0.4) (delay-time 0.375))"]
              :see-also ["delay" "delay-feedback"]}

 :delay-feedback {:type "function"
                  :detail "(delay-feedback fb pat) — orbit delay feedback 0–0.95 (default 0.5); last event wins"
                  :signature "(delay-feedback fb pat) or (delay-feedback fb)"
                  :doc "Feedback of the orbit's delay, 0–0.95 (default 0.5): how much of each echo comes back. Last event wins per orbit; (stop) resets it."
                  :category "param"
                  :returns "Pattern"
                  :side-effects []
                  :examples ["(->> (seq :sd :_ :_ :_) (delay 0.5) (delay-feedback 0.7))"]
                  :see-also ["delay" "delay-time"]}

 :orbit      {:type "function"
              :detail "(orbit n pat) — which orbit's reverb/delay to send into, 0–3 (default 0)"
              :signature "(orbit n pat) or (orbit n)"
              :doc "Which orbit (0–3, default 0) the event's room and delay sends go to. Each orbit has its own reverb and delay with their own settings. Out-of-range values are clamped with a warning."
              :category "param"
              :returns "Pattern"
              :side-effects []
              :examples ["(stack (->> (seq :bd :sd) (room 0.2) (orbit 0)) (->> (slow 2 (seq :c3 :g3)) (synth :saw) (room 0.7) (size 1) (orbit 1)))"]
              :see-also ["room" "delay" "size"]}

 ;; ── Phase TL7c — envelopes, pitch modulation, vowel, coarse, djf, postgain ──
 :lp-env {:type "function"
          :detail "(lp-env oct pat) — low-pass envelope depth in octaves above lpf, −10…10 (0 = off)"
          :signature "(lp-env oct pat) or (lp-env oct)"
          :doc "Depth of the per-event low-pass filter envelope in octaves: the cutoff moves from lpf to lpf·2^depth and back, a straight line in octaves. Negative depths move it down. Needs lpf on the same event. Times: lp-attack, lp-decay, lp-sustain, lp-release."
          :category "param"
         :returns "Pattern"
         :side-effects []
         :examples ["(->> (seq :c2 :c2 :eb2 :g1) (synth :saw) (lpf 300) (resonance 8) (lp-env 4) (lp-decay 0.2))"]
         :see-also ["lpf" "lp-attack" "lp-decay" "lp-sustain" "lp-release"]}

 :lp-attack {:type "function"
             :detail "(lp-attack secs pat) — low-pass envelope attack time (default 0.001 s)"
             :signature "(lp-attack secs pat) or (lp-attack secs)"
             :doc "Low-pass filter envelope attack time (default 0.001 s). No effect without lp-env and lpf."
             :category "param"
            :returns "Pattern"
            :side-effects []
            :examples ["(->> (seq :c2 :c2 :eb2 :g1) (synth :saw) (lpf 300) (resonance 8) (lp-env 4) (lp-decay 0.2) (lp-attack 0.05))"]
            :see-also ["lp-env" "lpf"]}

 :lp-decay {:type "function"
            :detail "(lp-decay secs pat) — low-pass envelope decay time from the peak to the sustain level (default 0.2 s)"
            :signature "(lp-decay secs pat) or (lp-decay secs)"
            :doc "Low-pass filter envelope decay time from the peak to the sustain level (default 0.2 s). No effect without lp-env and lpf."
            :category "param"
           :returns "Pattern"
           :side-effects []
           :examples ["(->> (seq :c2 :c2 :eb2 :g1) (synth :saw) (lpf 300) (resonance 8) (lp-env 4) (lp-decay 0.3))"]
           :see-also ["lp-env" "lpf"]}

 :lp-sustain {:type "function"
              :detail "(lp-sustain level pat) — low-pass envelope sustain level as a fraction of the depth, 0–1 (default 0)"
              :signature "(lp-sustain level pat) or (lp-sustain level)"
              :doc "Low-pass filter envelope sustain level as a fraction of the depth, 0–1 (default 0). No effect without lp-env and lpf."
              :category "param"
             :returns "Pattern"
             :side-effects []
             :examples ["(->> (seq :c2 :c2 :eb2 :g1) (synth :saw) (lpf 300) (resonance 8) (lp-env 4) (lp-decay 0.2) (lp-sustain 0.5))"]
             :see-also ["lp-env" "lpf"]}

 :lp-release {:type "function"
              :detail "(lp-release secs pat) — low-pass envelope release time after the event ends (default 0.1 s)"
              :signature "(lp-release secs pat) or (lp-release secs)"
              :doc "Low-pass filter envelope release time after the event ends (default 0.1 s). No effect without lp-env and lpf. The release starts when the event ends (its duration is the gate)."
              :category "param"
             :returns "Pattern"
             :side-effects []
             :examples ["(->> (seq :c2 :c2 :eb2 :g1) (synth :saw) (lpf 300) (resonance 8) (lp-env 4) (lp-decay 0.2) (lp-release 0.3))"]
             :see-also ["lp-env" "lpf"]}

 :hp-env {:type "function"
          :detail "(hp-env oct pat) — high-pass envelope depth in octaves above hpf, −10…10 (0 = off)"
          :signature "(hp-env oct pat) or (hp-env oct)"
          :doc "Depth of the per-event high-pass filter envelope in octaves: the cutoff moves from hpf to hpf·2^depth and back, a straight line in octaves. Negative depths move it down. Needs hpf on the same event. Times: hp-attack, hp-decay, hp-sustain, hp-release."
          :category "param"
         :returns "Pattern"
         :side-effects []
         :examples ["(->> (seq :c3 :g3) (synth :saw) (hpf 2000) (hp-env -4) (hp-decay 0.3))"]
         :see-also ["hpf" "hp-attack" "hp-decay" "hp-sustain" "hp-release"]}

 :hp-attack {:type "function"
             :detail "(hp-attack secs pat) — high-pass envelope attack time (default 0.001 s)"
             :signature "(hp-attack secs pat) or (hp-attack secs)"
             :doc "High-pass filter envelope attack time (default 0.001 s). No effect without hp-env and hpf."
             :category "param"
            :returns "Pattern"
            :side-effects []
            :examples ["(->> (seq :c3 :g3) (synth :saw) (hpf 2000) (hp-env -4) (hp-decay 0.3) (hp-attack 0.05))"]
            :see-also ["hp-env" "hpf"]}

 :hp-decay {:type "function"
            :detail "(hp-decay secs pat) — high-pass envelope decay time from the peak to the sustain level (default 0.2 s)"
            :signature "(hp-decay secs pat) or (hp-decay secs)"
            :doc "High-pass filter envelope decay time from the peak to the sustain level (default 0.2 s). No effect without hp-env and hpf."
            :category "param"
           :returns "Pattern"
           :side-effects []
           :examples ["(->> (seq :c3 :g3) (synth :saw) (hpf 2000) (hp-env -4) (hp-decay 0.3))"]
           :see-also ["hp-env" "hpf"]}

 :hp-sustain {:type "function"
              :detail "(hp-sustain level pat) — high-pass envelope sustain level as a fraction of the depth, 0–1 (default 0)"
              :signature "(hp-sustain level pat) or (hp-sustain level)"
              :doc "High-pass filter envelope sustain level as a fraction of the depth, 0–1 (default 0). No effect without hp-env and hpf."
              :category "param"
             :returns "Pattern"
             :side-effects []
             :examples ["(->> (seq :c3 :g3) (synth :saw) (hpf 2000) (hp-env -4) (hp-decay 0.3) (hp-sustain 0.5))"]
             :see-also ["hp-env" "hpf"]}

 :hp-release {:type "function"
              :detail "(hp-release secs pat) — high-pass envelope release time after the event ends (default 0.1 s)"
              :signature "(hp-release secs pat) or (hp-release secs)"
              :doc "High-pass filter envelope release time after the event ends (default 0.1 s). No effect without hp-env and hpf. The release starts when the event ends (its duration is the gate)."
              :category "param"
             :returns "Pattern"
             :side-effects []
             :examples ["(->> (seq :c3 :g3) (synth :saw) (hpf 2000) (hp-env -4) (hp-decay 0.3) (hp-release 0.3))"]
             :see-also ["hp-env" "hpf"]}

 :bp-env {:type "function"
          :detail "(bp-env oct pat) — band-pass envelope depth in octaves above bpf, −10…10 (0 = off)"
          :signature "(bp-env oct pat) or (bp-env oct)"
          :doc "Depth of the per-event band-pass filter envelope in octaves: the cutoff moves from bpf to bpf·2^depth and back, a straight line in octaves. Negative depths move it down. Needs bpf on the same event. Times: bp-attack, bp-decay, bp-sustain, bp-release."
          :category "param"
         :returns "Pattern"
         :side-effects []
         :examples ["(->> (fast 2 (seq :c3 :eb3)) (synth :saw) (bpf 400) (bpq 4) (bp-env 3) (bp-decay 0.25))"]
         :see-also ["bpf" "bp-attack" "bp-decay" "bp-sustain" "bp-release"]}

 :bp-attack {:type "function"
             :detail "(bp-attack secs pat) — band-pass envelope attack time (default 0.001 s)"
             :signature "(bp-attack secs pat) or (bp-attack secs)"
             :doc "Band-pass filter envelope attack time (default 0.001 s). No effect without bp-env and bpf."
             :category "param"
            :returns "Pattern"
            :side-effects []
            :examples ["(->> (fast 2 (seq :c3 :eb3)) (synth :saw) (bpf 400) (bpq 4) (bp-env 3) (bp-decay 0.25) (bp-attack 0.05))"]
            :see-also ["bp-env" "bpf"]}

 :bp-decay {:type "function"
            :detail "(bp-decay secs pat) — band-pass envelope decay time from the peak to the sustain level (default 0.2 s)"
            :signature "(bp-decay secs pat) or (bp-decay secs)"
            :doc "Band-pass filter envelope decay time from the peak to the sustain level (default 0.2 s). No effect without bp-env and bpf."
            :category "param"
           :returns "Pattern"
           :side-effects []
           :examples ["(->> (fast 2 (seq :c3 :eb3)) (synth :saw) (bpf 400) (bpq 4) (bp-env 3) (bp-decay 0.3))"]
           :see-also ["bp-env" "bpf"]}

 :bp-sustain {:type "function"
              :detail "(bp-sustain level pat) — band-pass envelope sustain level as a fraction of the depth, 0–1 (default 0)"
              :signature "(bp-sustain level pat) or (bp-sustain level)"
              :doc "Band-pass filter envelope sustain level as a fraction of the depth, 0–1 (default 0). No effect without bp-env and bpf."
              :category "param"
             :returns "Pattern"
             :side-effects []
             :examples ["(->> (fast 2 (seq :c3 :eb3)) (synth :saw) (bpf 400) (bpq 4) (bp-env 3) (bp-decay 0.25) (bp-sustain 0.5))"]
             :see-also ["bp-env" "bpf"]}

 :bp-release {:type "function"
              :detail "(bp-release secs pat) — band-pass envelope release time after the event ends (default 0.1 s)"
              :signature "(bp-release secs pat) or (bp-release secs)"
              :doc "Band-pass filter envelope release time after the event ends (default 0.1 s). No effect without bp-env and bpf. The release starts when the event ends (its duration is the gate)."
              :category "param"
             :returns "Pattern"
             :side-effects []
             :examples ["(->> (fast 2 (seq :c3 :eb3)) (synth :saw) (bpf 400) (bpq 4) (bp-env 3) (bp-decay 0.25) (bp-release 0.3))"]
             :see-also ["bp-env" "bpf"]}

 :penv {:type "function"
        :detail "(penv st pat) — pitch envelope depth in semitones, −48…48 (0 = off)"
        :signature "(penv st pat) or (penv st)"
        :doc "Depth of the per-event pitch envelope in semitones: the pitch moves from the note to note + depth and back. With the default 1 ms attack a note starts depth semitones up and falls. Works on tonal synth voices (sine, saw, square, fm and its presets) and samples; drums, noise, plucked (ks) and defsynth voices ignore it."
        :category "param"
       :returns "Pattern"
       :side-effects []
       :examples ["(->> (seq :c3 :c3) (synth :saw) (penv 12) (p-decay 0.08))"]
       :see-also ["p-attack" "p-decay" "p-sustain" "p-release" "vib"]}

 :p-attack {:type "function"
            :detail "(p-attack secs pat) — pitch envelope attack time (default 0.001 s)"
            :signature "(p-attack secs pat) or (p-attack secs)"
            :doc "Pitch envelope attack time (default 0.001 s). No effect without penv."
            :category "param"
           :returns "Pattern"
           :side-effects []
           :examples ["(->> (seq :c3 :c3) (synth :saw) (penv 12) (p-decay 0.08) (p-attack 0.02))"]
           :see-also ["penv"]}

 :p-decay {:type "function"
           :detail "(p-decay secs pat) — pitch envelope decay time back towards the sustain level (default 0.2 s)"
           :signature "(p-decay secs pat) or (p-decay secs)"
           :doc "Pitch envelope decay time back towards the sustain level (default 0.2 s). No effect without penv."
           :category "param"
          :returns "Pattern"
          :side-effects []
          :examples ["(->> (seq :c3 :c3) (synth :saw) (penv 12) (p-decay 0.3))"]
          :see-also ["penv"]}

 :p-sustain {:type "function"
             :detail "(p-sustain level pat) — pitch envelope sustain level as a fraction of the depth, 0–1 (default 0)"
             :signature "(p-sustain level pat) or (p-sustain level)"
             :doc "Pitch envelope sustain level as a fraction of the depth, 0–1 (default 0). No effect without penv."
             :category "param"
            :returns "Pattern"
            :side-effects []
            :examples ["(->> (seq :c3 :c3) (synth :saw) (penv 12) (p-decay 0.08) (p-sustain 0.5))"]
            :see-also ["penv"]}

 :p-release {:type "function"
             :detail "(p-release secs pat) — pitch envelope release time after the event ends (default 0.1 s)"
             :signature "(p-release secs pat) or (p-release secs)"
             :doc "Pitch envelope release time after the event ends (default 0.1 s). No effect without penv."
             :category "param"
            :returns "Pattern"
            :side-effects []
            :examples ["(->> (seq :c3 :c3) (synth :saw) (penv 12) (p-decay 0.08) (p-release 0.3))"]
            :see-also ["penv"]}

 :vib {:type "function"
       :detail "(vib hz pat) — vibrato rate 0–40 Hz (0 = off)"
       :signature "(vib hz pat) or (vib hz)"
       :doc "Per-event vibrato rate in Hz. Depth: vib-mod (semitones, default 0.5). Works on tonal synth voices and samples (not drums, noise, ks or defsynth)."
       :category "param"
      :returns "Pattern"
      :side-effects []
      :examples ["(->> (seq :a4) (synth :square) (vib 6) (vib-mod 0.3))"]
      :see-also ["vib-mod" "penv"]}

 :vib-mod {:type "function"
           :detail "(vib-mod st pat) — vibrato depth in semitones 0–12 (default 0.5)"
           :signature "(vib-mod st pat) or (vib-mod st)"
           :doc "Vibrato depth in semitones (peak deviation, default 0.5). No effect without vib."
           :category "param"
          :returns "Pattern"
          :side-effects []
          :examples ["(->> (seq :a4) (synth :square) (vib 6) (vib-mod 0.3))"]
          :see-also ["vib"]}

 :vowel {:type "function"
         :detail "(vowel :a pat) — formant filter, :a :e :i :o :u"
         :signature "(vowel v pat) or (vowel v)"
         :doc "Per-event formant filter: five band-passes tuned to the vowel's formants (:a :e :i :o :u, or strings). Unknown vowels are ignored. Brightest on buzzy sources (saw, square)."
         :category "param"
        :returns "Pattern"
        :side-effects []
        :examples ["(->> (seq :a2 :a2 :a2 :a2 :a2) (synth :saw) (decay 0.4) (vowel (seq :a :e :i :o :u)))"]
        :see-also ["bpf" "shape"]}

 :coarse {:type "function"
          :detail "(coarse n pat) — sample-and-hold every n samples, 1–64 (synth voices only)"
          :signature "(coarse n pat) or (coarse n)"
          :doc "Per-event sample-rate reduction: every n-th sample is held for n samples (1 = off). Works on the WASM synth voices only; samples, defsynth voices and tracks with an fx chain ignore it (warned once in the console)."
          :category "param"
         :returns "Pattern"
         :side-effects []
         :examples ["(->> (fast 4 (seq :c5)) (synth :square) (coarse (seq 1 4 8 16)))"]
         :see-also ["crush" "shape"]}

 :djf {:type "function"
       :detail "(djf x pat) — DJ filter 0–1: < 0.5 low-pass, > 0.5 high-pass, 0.5 = off"
       :signature "(djf x pat) or (djf x)"
       :doc "One-knob DJ filter: below 0.5 a low-pass closes towards 20 Hz at 0, above 0.5 a high-pass opens towards 20 kHz at 1; 0.5 is off. An explicit lpf/hpf on the same event wins."
       :category "param"
      :returns "Pattern"
      :side-effects []
      :examples ["(->> (fast 8 (seq :hh :oh)) (djf (slow 4 sine)))"]
      :see-also ["lpf" "hpf"]}

 :postgain {:type "function"
            :detail "(postgain g pat) — linear gain after the insert chain, 0–4 (default 1)"
            :signature "(postgain g pat) or (postgain g)"
            :doc "Linear gain applied after the per-event insert chain (filters, vowel, crush, shape), before pan and sends. Use it to tame or boost a shaped or filtered sound."
            :category "param"
           :returns "Pattern"
           :side-effects []
           :examples ["(->> (seq :c3 :e3) (synth :saw) (shape 0.8) (postgain 0.5))"]
           :see-also ["gain" "shape"]}

 :nudge {:type "function"
         :detail "(nudge secs pat) — move events in time, −1…1 s"
         :signature "(nudge secs pat) or (nudge secs)"
         :doc "Shifts each event's onset by secs seconds (positive = later). The editor flash and MIDI out are not nudged."
         :category "param"
        :returns "Pattern"
        :side-effects []
        :examples ["(->> (fast 4 (seq :hh)) (nudge (seq 0 0.02 0 0.02)))"]
        :see-also ["late" "early"]}

 :delay-sync {:type "function"
              :detail "(delay-sync cycles pat) — orbit delay time in cycles, 1/64–16"
              :signature "(delay-sync cycles pat) or (delay-sync cycles)"
              :doc "Delay time of the event's orbit in cycles, so echoes stay locked to the tempo; overrides delay-time on the same event (clamped to 4 s). Last event wins per orbit."
              :category "param"
             :returns "Pattern"
             :side-effects []
             :examples ["(->> (seq :sd :_ :_ :_) (delay 0.5) (delay-sync 3/16))"]
             :see-also ["delay" "delay-time"]}

 ;; ── UGens (inside defsynth) ─────────────────────────────────────────────────
 :sin        {:type "function"
              :detail "(sin freq) — sine oscillator UGen"
              :signature "(sin freq)"
              :doc "A sine oscillator UGen. Available inside a defsynth body."
              :category "ugen"
              :returns "UGen"
              :side-effects []
              :examples ["(sin freq)" "(->> (sin (* 2 freq)) (gain 0.5))"]
              :see-also ["tri" "lpf" "env-perc" "defsynth"]}

 :lpf        {:type "function"
              :detail "(lpf hz pat) — per-event low-pass 20–20000 Hz (patternable, signals ok). Inside defsynth: (lpf cutoff signal) UGen"
              :signature "(lpf hz pat) or (lpf hz)"
              :doc "Per-event 12 dB/oct low-pass, cutoff 20–20000 Hz. Patternable and signal-driven; the value is sampled once at each event's onset. Alias: cutoff. Pair with resonance. Inside a defsynth body, lpf is the (lpf cutoff signal) UGen instead."
              :category "param"
              :returns "Pattern (outside defsynth) · UGen (inside defsynth)"
              :side-effects []
              :examples ["(->> (fast 8 (seq :hh)) (lpf (range 400 6000 (slow 4 sine))) (resonance 4))"
                         "(lpf 800 (seq :c3 :eb3 :g3))"
                         "(defsynth dark [freq] (lpf 2000 (saw freq)))"]
              :see-also ["cutoff" "resonance" "hpf" "bpf" "defsynth"]}

 :hpf        {:type "function"
              :detail "(hpf hz pat) — per-event high-pass 20–20000 Hz. Inside defsynth: (hpf cutoff signal) UGen"
              :signature "(hpf hz pat) or (hpf hz)"
              :doc "Per-event 12 dB/oct high-pass, cutoff 20–20000 Hz. Pair with hpq. Inside a defsynth body, hpf is the (hpf cutoff signal) UGen instead."
              :category "param"
              :returns "Pattern (outside defsynth) · UGen (inside defsynth)"
              :side-effects []
              :examples ["(->> (seq :c3 :eb3 :g3) (synth :saw) (hpf 300))"
                         "(defsynth thin [freq] (hpf 300 (saw freq)))"]
              :see-also ["hpq" "lpf" "bpf" "defsynth"]}

 :bpf        {:type "function"
              :detail "(bpf hz pat) — per-event band-pass 20–20000 Hz. Inside defsynth: (bpf freq signal) UGen"
              :signature "(bpf hz pat) or (bpf hz)"
              :doc "Per-event band-pass (constant 0 dB peak gain) at 20–20000 Hz. Pair with bpq. Inside a defsynth body, bpf is the (bpf freq signal) UGen instead."
              :category "param"
              :returns "Pattern (outside defsynth) · UGen (inside defsynth)"
              :side-effects []
              :examples ["(->> (fast 4 (seq :hh)) (bpf (seq 1000 3000)) (bpq 5))"
                         "(defsynth nasal [freq] (bpf freq (saw freq)))"]
              :see-also ["bpq" "lpf" "hpf" "defsynth"]}

 :mix        {:type "function"
              :detail "(mix a b) — mix two UGen signals into one"
              :signature "(mix a b)"
              :doc "Mixes two UGen signals into one. Available inside a defsynth body."
              :category "ugen"
              :returns "UGen"
              :side-effects []
              :examples ["(mix (sin freq) (tri freq))"
                         "(mix (lpf 2000 a) (hpf 500 b))"]
              :see-also ["gain" "sin" "defsynth"]}

 :gain       {:type "function"
              :detail "(gain g pat) — per-event linear gain 0–2, multiplies amp. Inside defsynth: (gain level signal) UGen"
              :signature "(gain g pat) or (gain g)"
              :doc "Per-event linear gain 0–2 (default 1). Final voice level = amp × gain × velocity. Inside a defsynth body, gain is the (gain level signal) UGen instead."
              :category "param"
              :returns "Pattern (outside defsynth) · UGen (inside defsynth)"
              :side-effects []
              :examples ["(gain 0.5 (seq :bd :sd))"
                         "(defsynth soft [freq] (gain 0.5 (sin freq)))"]
              :see-also ["amp" "velocity" "mix" "defsynth"]}

 :delay-node {:type "function"
              :detail "(delay-node time signal) — delay line UGen"
              :signature "(delay-node time signal)"
              :doc "A delay line UGen. Available inside a defsynth body."
              :category "ugen"
              :returns "UGen"
              :side-effects []
              :examples ["(delay-node 0.25 (saw freq))"
                         "(mix sig (gain 0.5 (delay-node 0.5 sig)))"]
              :see-also ["mix" "gain" "defsynth"]}

 :env-perc   {:type "function"
              :detail "(env-perc attack decay signal) — percussive envelope UGen"
              :signature "(env-perc attack decay signal)"
              :doc "A percussive envelope UGen applied to a signal. Available inside a defsynth body."
              :category "ugen"
              :returns "UGen"
              :side-effects []
              :examples ["(env-perc 0.01 0.3 (sin freq))"
                         "(env-perc attack decay (lpf 2000 (saw freq)))"]
              :see-also ["env-asr" "env" "env-gen" "gain" "defsynth"]}

 :env-asr    {:type "function"
              :detail "(env-asr attack sustain release signal) — ASR envelope UGen"
              :signature "(env-asr attack sustain release signal)"
              :doc "An attack-sustain-release envelope UGen applied to a signal. Available inside a defsynth body."
              :category "ugen"
              :returns "UGen"
              :side-effects []
              :examples ["(env-asr 0.1 1.0 0.5 (sin freq))"
                         "(env-asr 0.02 0.8 0.3 (lpf cutoff (saw freq)))"]
              :see-also ["env-perc" "env" "env-gen" "defsynth"]}

 :env        {:type "function"
              :detail "(env levels times curves?) — general envelope descriptor; e.g. (env [0 1 0] [0.01 0.5] [:lin :exp])"
              :signature "(env levels times) or (env levels times curves)"
              :doc "Construct a general envelope descriptor from breakpoint levels and segment durations. Pass to env-gen inside a defsynth body. Supported curves: :lin :exp :sin :welch :step or a positive number."
              :category "ugen"
              :returns "EnvelopeDescriptor"
              :side-effects []
              :examples ["(env [0 1 0] [0.01 0.5] [:lin :exp])"
                         "(env [0 1 0.5 0] [0.01 0.1 0.5])"]
              :see-also ["env-gen" "env-perc" "env-asr"]}

 :env-gen    {:type "function"
              :detail "(env-gen env-data signal) — apply a general envelope to a signal UGen"
              :signature "(env-gen env-data signal)"
              :doc "Apply a general envelope (created with env) to a UGen signal. Returns the enveloped signal with duration equal to the total envelope time."
              :category "ugen"
              :returns "UGen"
              :side-effects []
              :examples ["(->> (sin freq) (env-gen (env [0 1 0] [0.01 0.5] [:lin :exp])))"
                         "(env-gen (env [0 1 0] [0.01 0.3]) (mix (sin freq) (tri freq)))"]
              :see-also ["env" "env-perc" "env-asr" "defsynth"]}

 ;; ── Bus system ───────────────────────────────────────────────────────────────
 :bus        {:type "function"
              :detail "(bus :name :control|:audio) — declare a named bus; default type is :control"
              :signature "(bus :name) or (bus :name :control|:audio)"
              :doc "Declare a named bus. :control (default) uses a ConstantSourceNode — ideal for LFOs and modulation signals. :audio uses a GainNode for mixing audio-rate signals."
              :category "audio"
              :returns "nil"
              :side-effects ["audio" "dom"]
              :examples ["(bus :lfo :control)" "(bus :reverb-send :audio)"]
              :see-also ["out" "in" "kr"]}

 :out        {:type "function"
              :detail "(out :bus-name signal) — write signal to a named bus (inside defsynth)"
              :signature "(out :bus-name signal)"
              :doc "Write a UGen signal to a named bus. Use inside defsynth bodies. Re-triggers replace the previous connection for the same synth→bus pair."
              :category "ugen"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(out :lfo (sin 4))" "(out :send (gain 0.3 sig))"]
              :see-also ["in" "bus"]}

 :in         {:type "function"
              :detail "(in :bus-name) — read from a named bus as a UGen source (inside defsynth)"
              :signature "(in :bus-name)"
              :doc "Read from a named bus as a UGen audio source. Returns silence and logs a warning if the bus does not exist."
              :category "ugen"
              :returns "UGen"
              :side-effects []
              :examples ["(in :lfo)" "(lpf (+ 1200 (* 800 (in :lfo))) (saw freq))"]
              :see-also ["out" "bus"]}

 :kr         {:type "function"
              :detail "(kr rate signal) — control-rate pass-through (rate is informational)"
              :signature "(kr rate signal)"
              :doc "Control-rate pass-through. In Web Audio, control-rate is not separately exposed — this is an informational wrapper that returns the signal unchanged."
              :category "ugen"
              :returns "UGen"
              :side-effects []
              :examples ["(kr 100 (in :lfo))"]
              :see-also ["in" "bus"]}

 ;; ── Effects ─────────────────────────────────────────────────────────────────
 :fx         {:type "function"
              :detail "(fx :name param) — global effect; inside ->>: (fx :name param pat) — per-track effect on this track only"
              :signature "(fx :name param) or (->> pat (fx :name param))"
              :doc "Global: sets a master-chain effect parameter. Per-track: use inside ->> to route a track through its own effect chain — re-evaluating play without (fx ...) removes the effect automatically. Use (fx :off :name) / (fx :on :name) to bypass/restore global effects."
              :category "effect"
              :returns "nil"
              :side-effects ["audio" "dom"]
              :examples ["(fx :reverb 0.4)"
                         "(fx :delay :wet 0.3 :time 0.25)"
                         "(->> (seq :bd :_ :bd :_) (fx :filter 1000))"
                         "(fx :reverb :type :hall :decay 3 :wet 0.3)"
                         "(master (fx :limiter -1))"]
              :see-also ["track" "master" "eq" "limiter" "distort" "amp-sim" "cab"]}

 :master     {:type "keyword"
              :detail "(master (fx …) …) — global effect chain block; only (fx …) forms inside, at most one per buffer"
              :signature "(master (fx :name …) …)"
              :doc "Group the global effect chain in one block. Each (fx …) inside runs exactly like a top-level (fx …); anything else is an error. One master per buffer. The signal order stays the built-in chain order."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(master (fx :reverb 0.3))"
                         "(master (fx :delay :time 0.375 :feedback 0.4) (fx :reverb 0.3))"]
              :see-also ["fx" "track" "song"]}

 :distort    {:type "keyword"
              :detail "effect — soft/asymmetric clipping distortion"
              :signature "(fx :distort [:drive N] [:tone Hz] [:mix N] [:asym N] [:algo kw] [:oversample 1|2|4])"
              :doc "Soft-clipping waveshaper distortion. :drive sets pre-clip gain from 1.0–100.0 (default 4.0). :tone sets the post-clip lowpass from 200–20000 Hz (default 3000). :mix blends dry/wet from 0.0–1.0 (default 1.0). :asym sets half-wave asymmetry from -1.0–1.0 for even-harmonic warmth (default 0.0). :algo chooses :tanh, :sigmoid, or :atan clipping curves. :oversample reduces aliasing at high drive (default 1)."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(fx :distort :drive 25)"
                         "(->> (seq :c2 :g2) (synth :saw) (fx :distort :drive 20 :oversample 4))"]
              :see-also ["amp-sim" "waveshape" "cab" "fx"]}

 :amp-sim    {:type "keyword"
              :detail "effect — multi-stage amp simulation"
              :signature "(fx :amp-sim [:gain N] [:stages N] [:tone Hz] [:tonestack kw] [:sag N] [:mix N] [:oversample 1|2|4])"
              :doc "Multi-stage tube preamp simulation. :gain sets total preamp gain from 1.0–100.0 (default 8.0). :stages sets number of gain stages from 1–4 (default 3). :tone sets post-amp lowpass Hz (default 4000). :tonestack chooses :neutral, :bright, :dark, :mid-scoop, or :mid-hump presets. :sag adds power supply sag / transient compression from 0.0–1.0 (default 0.0). :oversample reduces aliasing (default 1)."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(fx :amp-sim :gain 40)"
                         "(->> (seq :e2 :_ :e2 :g2) (synth :saw) (fx :amp-sim :gain 40 :stages 2))"]
              :see-also ["distort" "waveshape" "cab" "fx"]}

 :waveshape  {:type "keyword"
              :detail "effect — arbitrary waveshaper LUT"
              :signature "(fx :waveshape :curve C [:drive N] [:tone Hz] [:mix N])"
              :doc "Arbitrary waveshaper distortion via a user-defined transfer function. :curve accepts a Float32Array, a vector of floats, or a generator function. :drive sets pre-shaper gain from 1.0–20.0 (default 1.0). :tone sets the post-shaper lowpass cutoff (default 20000)."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(fx :waveshape :curve (chebyshev 3) :drive 2)"
                         "(fx :waveshape :curve (fold) :drive 8)"]
              :see-also ["chebyshev" "fold" "bitcrush" "cab" "fx"]}

 :cab        {:type "keyword"
              :detail "effect — speaker cabinet simulation"
              :signature "(fx :cab [:ir kw] [:mix N])"
              :doc "Speaker cabinet impulse response convolution. :ir chooses :1x12, :2x12, :4x12, or :di (dry passthrough). :mix blends dry/wet from 0.0–1.0. Pairs well with (fx :amp-sim ...) or (fx :distort ...)."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(fx :cab :ir :2x12)"
                         "(->> (seq :e2 :_ :e2 :g2) (synth :saw) (fx :amp-sim :gain 30 :stages 3) (fx :cab :ir :4x12))"
                         "(->> (seq :c2 :e2) (synth :saw) (fx :distort :drive 8) (fx :cab :ir :di))"]
              :see-also ["amp-sim" "distort" "waveshape" "fx"]}

 ;; Phase FX1 — mixing, space & modulation effects
 :eq         {:type "keyword"
              :detail "effect — parametric EQ: low/high shelf, two peaking bands (fx :eq :low 3 :high 2)"
              :signature "(fx :eq [:low dB] [:low-freq Hz] [:mid dB] [:mid-freq Hz] [:mid-q Q] [:mid2 dB] [:mid2-freq Hz] [:mid2-q Q] [:high dB] [:high-freq Hz])"
              :doc "Parametric EQ: low shelf, two peaking bands, high shelf. Gains −24…24 dB (default 0, i.e. flat). :low-freq 20–1000 Hz (100), :mid-freq 100–8000 Hz (1000), :mid2-freq 200–16000 Hz (3000), :high-freq 1000–20000 Hz (8000), :mid-q / :mid2-q 0.1–10 (1). A shelf reaches half its gain at its corner frequency. No positional value."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(->> (seq :c2 :_ :eb2 :_) (synth :saw) (fx :eq :low 3 :low-freq 80 :mid -4 :mid-freq 400 :mid-q 1.5))"
                         "(master (fx :eq :high 2 :high-freq 8000))"]
              :see-also ["limiter" "gate" "fx" "master"]}

 :limiter    {:type "keyword"
              :detail "effect — look-ahead peak limiter (fx :limiter -1); ceiling dBFS, 5 ms latency"
              :signature "(fx :limiter ceiling [:release s])"
              :doc "Look-ahead peak limiter: no output sample exceeds :ceiling (−24…0 dBFS, default −1). :release 0.01–1 s (0.1) is the recovery time after a peak. Delays the signal by 5 ms. Inactive until named; put it last on the master."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(master (fx :limiter -1))"
                         "(master (fx :eq :high 2) (fx :limiter :ceiling -1 :release 0.1))"]
              :see-also ["eq" "gate" "fx" "master"]}

 :gate       {:type "keyword"
              :detail "effect — noise gate (fx :gate -40); threshold dBFS, hold, release, range"
              :signature "(fx :gate threshold [:attack s] [:hold s] [:release s] [:range dB])"
              :doc "Noise gate: opens above :threshold (−80…0 dBFS, default −40), stays open for :hold (0–2 s, 0.05) after the level drops, then closes over :release (0.005–2 s, 0.1). :attack 0.0001–0.1 s (0.001). :range −80…0 dB (−80 ≈ silent; −12 makes it an expander)."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(->> (seq :_ :sd :_ :sd) (fx :gate :threshold -35 :release 0.08))"
                         "(->> (seq :_ :sd :_ :sd) (fx :reverb 0.6) (fx :gate :threshold -30 :range -12))"]
              :see-also ["limiter" "eq" "fx"]}

 :flanger    {:type "keyword"
              :detail "effect — flanger with feedback (fx :flanger 0.6 :feedback 0.6)"
              :signature "(fx :flanger wet [:rate Hz] [:depth N] [:delay s] [:feedback N])"
              :doc "Flanger: a short modulated delay with feedback. wet 0–1 (default 0; the dry signal stays at 1). :rate 0.01–10 Hz (0.25), :depth 0–1 (0.7) sweeps the delay between delay·(1 − depth) and delay·(1 + depth), :delay 0.0005–0.01 s (0.002), :feedback −0.95…0.95 (0; negative inverts the comb)."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(->> (seq :c3 :g3) (synth :saw) (fx :flanger :rate 0.25 :depth 0.7 :feedback 0.6 :wet 0.8))"]
              :see-also ["vibrato" "auto-pan" "fx"]}

 :vibrato    {:type "keyword"
              :detail "effect — pitch vibrato (fx :vibrato 20); depth in cents, :rate Hz"
              :signature "(fx :vibrato depth [:rate Hz])"
              :doc "Pitch vibrato on the whole track: depth 0–100 cents up and down (default 20), :rate 0.5–20 Hz (5). Inactive until named."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(->> (seq :a4) (synth :saw) (fx :vibrato :rate 5 :depth 50))"]
              :see-also ["flanger" "vib" "fx"]}

 :auto-pan   {:type "keyword"
              :detail "effect — equal-power auto-pan (fx :auto-pan 1 :sync 1)"
              :signature "(fx :auto-pan depth [:rate Hz] [:sync cycles] [:shape kw])"
              :doc "Equal-power auto-pan: depth 0–1 (default 1 = fully left to fully right), :rate 0.01–20 Hz (1), :sync length of one sweep in cycles (wins over :rate, locked to the cycle grid), :shape :sine (default), :tri or :square. Total power stays constant. Inactive until named."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(->> (fast 8 (seq :hh)) (fx :auto-pan :sync 1))"
                         "(->> (fast 8 (seq :hh)) (fx :auto-pan :rate 0.5 :shape :tri))"]
              :see-also ["width" "pan" "fx"]}

 :ring-mod   {:type "keyword"
              :detail "effect — ring modulator (fx :ring-mod 0.5 :freq 220)"
              :signature "(fx :ring-mod mix [:freq Hz] [:shape kw])"
              :doc "Ring modulator: multiplies the signal by a carrier. mix 0–1 crossfades dry → modulated (default 0). :freq 0.1–5000 Hz (440), :shape :sine (default), :tri, :square or :saw."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(->> (seq :a4 :e4) (synth :saw) (fx :ring-mod :freq 220 :mix 1))"]
              :see-also ["flanger" "fx"]}

 :width      {:type "keyword"
              :detail "effect — stereo width 0–2 (fx :width 1.4); :haas ms"
              :signature "(fx :width width [:haas ms])"
              :doc "Stereo width: 0 = mono, 1 = unchanged (default), 2 = side level doubled. Above 1 raises out-of-phase content and reduces mono compatibility. :haas 0–30 ms delays the right channel and widens mono material. Per track it only widens what is already stereo (panned events) unless :haas is set."
              :category "effect"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(master (fx :width 1.4))"
                         "(->> (seq :hh :_ :hh :_) (fx :width :haas 12))"]
              :see-also ["auto-pan" "pan" "fx"]}

 :chebyshev  {:type "function"
              :detail "curve — Chebyshev polynomial (order 1–8)"
              :signature "(chebyshev N)"
              :doc "Generate a Chebyshev polynomial curve of order N (1–8) for use with (fx :waveshape). Order N adds primarily the Nth harmonic. Use as a :curve value."
              :category "effect"
              :returns "Float32Array"
              :side-effects []
              :examples ["(fx :waveshape :curve (chebyshev 2) :drive 4)"
                         "(fx :waveshape :curve (chebyshev 5))"]
              :see-also ["fold" "bitcrush" "waveshape"]}

 :fold       {:type "function"
              :detail "curve — wavefolder transfer function"
              :signature "(fold)"
              :doc "Generate a wavefolder transfer function for use with (fx :waveshape). Folds the waveform back on itself, producing rich harmonics."
              :category "effect"
              :returns "Float32Array"
              :side-effects []
              :examples ["(fx :waveshape :curve (fold) :drive 8)"]
              :see-also ["chebyshev" "bitcrush" "waveshape"]}

 :bitcrush   {:type "function"
              :detail "curve — bitcrusher staircase (bits 1–16)"
              :signature "(bitcrush N)"
              :doc "Generate a quantization staircase curve with 2^N steps for use with (fx :waveshape). N is bit depth (1–16). Low N = aggressive quantization = lo-fi grit."
              :category "effect"
              :returns "Float32Array"
              :side-effects []
              :examples ["(fx :waveshape :curve (bitcrush 4))"
                         "(fx :waveshape :curve (bitcrush 8) :drive 2)"]
              :see-also ["fold" "chebyshev" "waveshape"]}

 :load-plugin  {:type "function"
                :detail "(load-plugin url) — load a REPuLse plugin from URL"
                :signature "(load-plugin \"url\")"
                :doc "Load a REPuLse plugin from a URL (visual or effect)."
                :category "io"
                :returns "nil"
                :side-effects ["network" "dom"]
                :examples ["(load-plugin \"/plugins/reverb.js\")"
                           "(load-plugin \"https://example.com/repulse-chorus.js\")"]
                :see-also ["unload-plugin" "fx"]}

 :unload-plugin {:type "function"
                 :detail "(unload-plugin name) — unload and remove a plugin by name"
                 :signature "(unload-plugin name)"
                 :doc "Unloads and removes a plugin by name."
                 :category "io"
                 :returns "nil"
                 :side-effects ["dom"]
                 :examples ["(unload-plugin \"chorus\")" "(unload-plugin \"reverb\")"]
                 :see-also ["load-plugin"]}

 ;; ── Audio / playback ────────────────────────────────────────────────────────
 :sound      {:type "function"
              :detail "(sound bank n) — select sample n from bank"
              :signature "(sound bank n)"
              :doc "Select sample number n from the named bank."
              :category "sample"
              :returns "Pattern"
              :side-effects []
              :examples ["(sound :808 0)" "(sound :AkaiLinn 3)"]
              :see-also ["samples!" "sample-banks"]}

 :bpm        {:type "function"
              :detail "(bpm n) — set tempo in beats per minute"
              :signature "(bpm n)"
              :doc "Set the tempo in beats per minute."
              :category "audio"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(bpm 130)" "(bpm 174)"]
              :see-also ["tap!" "midi-sync!"]}

 :stop       {:type "function"
              :detail "(stop) — stop all playback"
              :signature "(stop)"
              :doc "Stop all playback immediately."
              :category "audio"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(stop)"]
              :see-also ["mute!" "clear!"]}

 :samples!   {:type "function"
              :detail "(samples! url) — load external sample bank"
              :signature "(samples! \"github:owner/repo\")"
              :doc "Load an external sample bank from a GitHub repository."
              :category "sample"
              :returns "nil"
              :side-effects ["network" "audio"]
              :examples ["(samples! \"github:tidalcycles/Dirt-Samples\")"
                         "(samples! \"github:owner/my-samples\")"]
              :see-also ["sample-banks" "sound"]}

 :sample-banks {:type "function"
                :detail "(sample-banks [filter]) — list registered bank names, optionally only those containing filter"
                :signature "(sample-banks [filter])"
                :doc "List all registered sample bank names. With a filter string or keyword, only banks whose name contains it (case-insensitive)."
                :category "sample"
                :returns "vector"
                :side-effects []
                :examples ["(sample-banks)" "(sample-banks \"tk\")"]
                :see-also ["samples!" "sound"]}

 :bank       {:type "function"
              :detail "(bank :prefix) — kit for bare drum names: default = synth kit; (bank :dirt) = Dirt-Samples drums; (bank :RolandTR808) = a drum machine; (bank nil) clears"
              :signature "(bank :prefix)"
              :doc "Choose the drum kit for bare drum names (:bd :sd :hh …). Default (no bank, (bank nil), (bank :synth)): REPuLse's synth kit. (bank :dirt): the Dirt-Samples drums. (bank :AkaiLinn) etc.: that drum machine's samples."
              :category "sample"
              :returns "string"
              :side-effects ["audio"]
              :examples ["(bank :dirt)"
                         "(bank :AkaiLinn)"
                         "(bank :RolandTR808)"
                         "(bank nil)"]
              :see-also ["sample-banks" "sound" "samples!"]}

 ;; ── Track management ────────────────────────────────────────────────────────
 :track      {:type "function"
              :detail "(track :name pattern & flags) — define or replace a named track; flags :mute / :solo"
              :signature "(track :name pattern & flags)"
              :doc "Define or replace a named track. Each track runs independently. Trailing flags :mute (silent, keeps its FX) and :solo (only soloed tracks sound; several may be soloed) live in the code. Alt+Enter plays exactly the tracks the code declares — deleted tracks stop."
              :category "audio"
              :returns "nil"
              :side-effects ["audio" "dom"]
              :examples ["(track :kick (seq :bd :_ :bd :_))"
                         "(track :bass (->> (scale :minor :c2 (seq 0 3 5)) (amp 0.9)))"
                         "(track :hats (seq :hh :hh :oh :hh) :mute)"
                         "(track :kick (seq :bd :_ :bd :_) :solo)"]
              :see-also ["mute!" "unmute!" "solo!" "clear!" "tracks"]}

 :mute!      {:type "function"
              :detail "(mute! :name) — command bar: writes :mute into the track's form and re-evaluates"
              :signature "(mute! :name)"
              :doc "Command bar: writes :mute into the (track :name …) form and re-evaluates. Inside the buffer it is an error — write (track :name … :mute) instead."
              :category "audio"
              :returns "nil"
              :side-effects ["audio" "dom"]
              :examples ["(mute! :kick)" "(mute! :bass)"]
              :see-also ["unmute!" "solo!" "track"]}

 :unmute!    {:type "function"
              :detail "(unmute! :name) — command bar: removes :mute from the track's form and re-evaluates"
              :signature "(unmute! :name)"
              :doc "Command bar: removes :mute from the (track :name …) form and re-evaluates."
              :category "audio"
              :returns "nil"
              :side-effects ["audio" "dom"]
              :examples ["(unmute! :kick)" "(unmute! :bass)"]
              :see-also ["mute!" "solo!" "track"]}

 :solo!      {:type "function"
              :detail "(solo! :name) — command bar: writes :solo into the track's form and re-evaluates"
              :signature "(solo! :name)"
              :doc "Command bar: writes :solo into the (track :name …) form and re-evaluates. Several tracks may be soloed; unsoloed tracks are silent."
              :category "audio"
              :returns "nil"
              :side-effects ["audio" "dom"]
              :examples ["(solo! :bass)" "(solo! :kick)"]
              :see-also ["mute!" "unmute!" "track"]}

 :clear!     {:type "function"
              :detail "(clear! :name) — remove a track; (clear!) removes all tracks (use in command bar)"
              :signature "(clear! :name) or (clear!)"
              :doc "Remove a track by name, or remove all tracks."
              :category "audio"
              :returns "nil"
              :side-effects ["audio" "dom"]
              :examples ["(clear! :kick)" "(clear!)"]
              :see-also ["track" "stop"]}

 :tracks     {:type "function"
              :detail "(tracks) — list active track names"
              :signature "(tracks)"
              :doc "List all currently active track names."
              :category "audio"
              :returns "vector"
              :side-effects []
              :examples ["(tracks)"]
              :see-also ["track" "mute!" "clear!"]}

 :upd        {:type "function"
              :detail "(upd) — hot-swap: re-evaluate editor buffer and update running tracks without stopping"
              :signature "(upd)"
              :doc "Hot-swap: re-evaluate the editor buffer and update running tracks without stopping playback."
              :category "audio"
              :returns "nil"
              :side-effects ["audio" "dom"]
              :examples ["(upd)"]
              :see-also ["track" "stop"]}

 :tap!       {:type "function"
              :detail "(tap!) — register a BPM tap; 4 taps sets tempo (or click tap button)"
              :signature "(tap!)"
              :doc "Register a BPM tap. Four consecutive taps set the tempo."
              :category "audio"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(tap!)"]
              :see-also ["bpm" "midi-sync!"]}

 :midi-sync! {:type "function"
              :detail "(midi-sync! true/false) — enable/disable MIDI clock sync"
              :signature "(midi-sync! true/false)"
              :doc "Enable or disable MIDI clock synchronisation."
              :category "midi"
              :returns "nil"
              :side-effects ["midi" "audio"]
              :examples ["(midi-sync! true)" "(midi-sync! false)"]
              :see-also ["midi-clock-out!" "bpm"]}

 ;; ── MIDI ─────────────────────────────────────────────────────────────────────
 :midi-map   {:type "function"
              :detail "(midi-map :cc N :target) — map MIDI CC number N to :filter, :amp, or :bpm"
              :signature "(midi-map :cc N :target)"
              :doc "Map MIDI CC number N from any connected controller to a named parameter. Supported targets: :filter (master lowpass cutoff), :amp (master gain), :bpm (tempo 60–240). Requires Chrome or Edge."
              :category "midi"
              :returns "nil"
              :side-effects ["midi" "dom"]
              :examples ["(midi-map :cc 1 :filter)"
                         "(midi-map :cc 7 :amp)" "(midi-map :cc 14 :bpm)"]
              :see-also ["midi-out" "midi-clock-out!"]}

 :midi-out   {:type "function"
              :detail "(midi-out ch pat) — route pattern events as MIDI notes on channel 1–16; (midi-out ch) returns transformer"
              :signature "(midi-out ch pat) or (midi-out ch)"
              :doc "Route pattern events as MIDI Note On/Off messages on the given channel (1–16). Notes are derived from note names or Hz values; amp maps to MIDI velocity. Combine with scale, chord, transpose. Requires Chrome or Edge."
              :category "midi"
              :returns "Pattern"
              :side-effects ["midi"]
              :examples ["(->> (scale :minor :c4 (seq 0 2 4 7)) (midi-out 1))"
                         "(midi-out 2 (chord :major :c3))"]
              :see-also ["midi-map" "midi-export" "midi-clock-out!"]}

 :midi-clock-out! {:type "function"
                   :detail "(midi-clock-out! true/false) — broadcast 24ppqn MIDI clock at current BPM"
                   :signature "(midi-clock-out! true/false)"
                   :doc "Start or stop broadcasting a 24ppqn MIDI clock at the current BPM. Sends MIDI Start (0xFA) when enabled, MIDI Stop (0xFC) when disabled. Locks external DAWs and hardware to REPuLse's tempo. Requires Chrome or Edge."
                   :category "midi"
                   :returns "nil"
                   :side-effects ["midi"]
                   :examples ["(midi-clock-out! true)" "(midi-clock-out! false)"]
                   :see-also ["midi-sync!" "midi-out"]}

 :midi-export {:type "function"
               :detail "(midi-export :track n) — n cycles of :track as a .mid file; (midi-export :song) — whole song, one MIDI track per track; :drum-map {:perc 60} — extra drum notes"
               :signature "(midi-export :track [n]) / (midi-export :song) — optionally followed by :drum-map {:name note}"
               :doc "Download a Standard MIDI File (format 1, 480 ppqn). (midi-export :track n) writes n cycles of one track; (midi-export :song) writes every track of the song as its own MIDI track with tempo and section markers. Velocity comes from amp, drum keywords map to General MIDI drum notes on channel 10 (:drum-map overrides or adds names). Works in all browsers — no MIDI hardware required."
               :category "midi"
               :returns "nil"
               :side-effects ["dom"]
               :examples ["(midi-export :bass 4)" "(midi-export :song)"
                          "(midi-export :drums 4 :drum-map {:perc 60})"]
               :see-also ["midi-out" "export"]}

 ;; ── Freesound ────────────────────────────────────────────────────────────────
 :freesound-key! {:type "function"
                  :detail "(freesound-key! \"key\") — set your Freesound API key (one-time setup)"
                  :signature "(freesound-key! \"api-key\")"
                  :doc "Set your Freesound API key. Required before using freesound!. Get a free key at freesound.org."
                  :category "io"
                  :returns "nil"
                  :side-effects ["storage"]
                  :examples ["(freesound-key! \"abc123xyz\")"]
                  :see-also ["freesound!"]}

 :freesound! {:type "function"
              :detail "(freesound! \"query\") — search Freesound and load up to 5 results as :freesound-N"
              :signature "(freesound! \"query\")"
              :doc "Search Freesound.org and load up to 5 results as sample banks named :freesound-ID. Use them in patterns like any other keyword."
              :category "io"
              :returns "nil"
              :side-effects ["network" "audio"]
              :examples ["(do (freesound! \"kick 808\") (seq :freesound-12345))"
                         "(freesound! \"snare trap\")"]
              :see-also ["freesound-key!" "samples!"]}

 ;; ── Sharing & IO ─────────────────────────────────────────────────────────────
 :share!     {:type "function"
              :detail "(share!) — copy shareable session URL to clipboard"
              :signature "(share!)"
              :doc "Copies a shareable session URL to the clipboard."
              :category "io"
              :returns "nil"
              :side-effects ["dom" "storage"]
              :examples ["(share!)"]
              :see-also ["load-gist" "export"]}

 :load-gist  {:type "function"
              :detail "(load-gist url) — fetch a Gist and load into editor"
              :signature "(load-gist url)"
              :doc "Fetches a GitHub Gist from the given URL and loads its content into the editor."
              :category "io"
              :returns "nil"
              :side-effects ["network" "dom"]
              :examples ["(load-gist \"https://gist.github.com/user/abc123\")"
                         "(load-gist \"https://gist.githubusercontent.com/user/abc/raw/file.rpl\")"]
              :see-also ["share!" "samples!"]}

 :export     {:type "function"
              :detail "(export) — render all tracks to WAV; (export n) — n cycles; (export :track n) — n cycles of one track; (export :stems) — one WAV per track in a zip; (export :song) — render the whole song offline; (export :song :realtime) — record it in real time"
              :signature "(export [n]) / (export :track [n]) / (export :stems [n | :tail secs]) / (export :song [:tail secs] [:realtime])"
              :doc "Download a WAV, rendered offline (faster than real time) with the same voices and FX as playback. (export n) renders n cycles of all tracks (default 4); (export :track n) renders n cycles of one track; (export :song) renders the whole song plus a release tail (default 2 s); add :realtime to record it live instead. (export :stems) renders every track of the song to its own WAV of identical length and downloads them as repulse-stems.zip (per-track FX included, master FX not; (export :stems n) = n cycles without a song)."
              :category "io"
              :returns "nil"
              :side-effects ["audio" "dom"]
              :examples ["(export)" "(export 4)" "(export :kick)" "(export :kick 8)"
                         "(export :stems)" "(export :song)"
                         "(export :song :tail 4)" "(export :song :realtime)"]
              :see-also ["midi-export" "share!" "song"]}

 ;; ── Content ──────────────────────────────────────────────────────────────────
 :snippet    {:type "function"
              :detail "(snippet :id) — insert a snippet from the library; (snippet) lists available IDs"
              :signature "(snippet :id)"
              :doc "Insert a snippet from the curated library by ID. The snippet code is appended to the editor and the session is hot-swapped with (upd). Call (snippet) with no args to list all available IDs."
              :category "content"
              :returns "nil"
              :side-effects ["dom"]
              :examples ["(snippet :four-on-the-floor)" "(snippet)"]
              :see-also ["demo" "tutorial"]}

 :demo       {:type "function"
              :detail "(demo :name) — load a starter template and play it; (demo) lists available demos"
              :signature "(demo :name) or (demo)"
              :doc "Load a starter template into the editor and play it. With no arguments, lists available demos."
              :category "content"
              :returns "nil"
              :side-effects ["dom"]
              :examples ["(demo :techno)" "(demo)"]
              :see-also ["tutorial" "snippet"]}

 :tutorial   {:type "function"
              :detail "(tutorial n) — load tutorial chapter n into the editor (1–8); (tutorial) loads chapter 1"
              :signature "(tutorial) or (tutorial n)"
              :doc "Load tutorial chapter n into the editor without auto-playing. Defaults to chapter 1. Press Alt+Enter to hear it."
              :category "content"
              :returns "nil"
              :side-effects ["dom"]
              :examples ["(tutorial)" "(tutorial 3)"]
              :see-also ["demo" "snippet"]}

 :reset!     {:type "function"
              :detail "(reset!) — stop playback, wipe all persisted state, and reload with a fresh demo"
              :signature "(reset!)"
              :doc "Stop playback, clear all persisted state (editor, BPM, effects, bank, sample sources, mute/solo, MIDI mappings), and reload the page with a fresh demo. Use when you want a clean slate."
              :category "audio"
              :returns "nil"
              :side-effects ["audio" "dom" "storage"]
              :examples ["(reset!)"]
              :see-also ["stop" "clear!"]}

 ;; ── Help / session ───────────────────────────────────────────────────────────
 :help-export {:type "function"
               :detail "(help-export) — return live session as a map; access with (:bpm (help-export)), (:tracks (help-export)), etc."
               :signature "(help-export)"
               :doc "Return the live session state as a map. Fields: :bpm (number), :tracks (keyword→{:fx [...]}), :muted (vector of strings), :fx (global FX chain, vector of {:name :params :bypassed}), :bank, :sources. Access per-track FX with (:fx (:kick (:tracks (help-export))))."
               :category "session"
               :returns "object"
               :side-effects []
               :examples ["(help-export)"
                          "(:bpm (help-export))"
                          "(:kick (:tracks (help-export)))"
                          "(:fx (:kick (:tracks (help-export))))"]
               :see-also ["tracks" "bpm" "fx"]}

 :snapshot!        {:type "function"
                    :detail "(snapshot! \"take A\") — save the whole project as a named snapshot (overwrites)"
                    :signature "(snapshot! name)"
                    :doc "Save the whole project (every buffer, BPM, bank, sample sources, mutes) as a named snapshot. An existing name is overwritten. Snapshots are stored locally and never evicted automatically."
                    :category "session"
                    :returns "String"
                    :side-effects ["storage"]
                    :examples ["(snapshot! \"take A\")"]
                    :see-also ["snapshots" "restore!" "history"]}
 :snapshots        {:type "function"
                    :detail "(snapshots) — names of saved snapshots, newest first"
                    :signature "(snapshots)"
                    :doc "Return the names of all saved snapshots, newest first."
                    :category "session"
                    :returns "Vector"
                    :side-effects []
                    :examples ["(snapshots)"]
                    :see-also ["snapshot!" "restore!"]}
 :restore!         {:type "function"
                    :detail "(restore! \"take A\") or (restore! 12) — restore a snapshot or history entry (current state kept in history)"
                    :signature "(restore! name) or (restore! id)"
                    :doc "Restore a snapshot by name or an eval-history entry by number. The current state is saved to the history first, so a restore can always be undone. Does not evaluate: press Alt+Enter to hear it."
                    :category "session"
                    :returns "String"
                    :side-effects ["storage" "dom" "audio"]
                    :examples ["(restore! \"take A\")" "(restore! 12)"]
                    :see-also ["snapshot!" "history" "snapshots"]}
 :rename-snapshot! {:type "function"
                    :detail "(rename-snapshot! \"take A\" \"verse\") — rename a snapshot"
                    :signature "(rename-snapshot! old new)"
                    :doc "Rename a saved snapshot. Fails when the new name is already taken."
                    :category "session"
                    :returns "String"
                    :side-effects ["storage"]
                    :examples ["(rename-snapshot! \"take A\" \"verse\")"]
                    :see-also ["snapshot!" "delete-snapshot!" "snapshots"]}
 :delete-snapshot! {:type "function"
                    :detail "(delete-snapshot! \"take A\") — delete a snapshot"
                    :signature "(delete-snapshot! name)"
                    :doc "Delete a saved snapshot permanently."
                    :category "session"
                    :returns "String"
                    :side-effects ["storage"]
                    :examples ["(delete-snapshot! \"take A\")"]
                    :see-also ["snapshot!" "rename-snapshot!" "snapshots"]}
 :history          {:type "function"
                    :detail "(history) — open the eval history & snapshots panel"
                    :signature "(history)"
                    :doc "Open the eval history and snapshots panel: scroll back through past evaluations, preview a line diff against the current code, and restore."
                    :category "session"
                    :returns "String"
                    :side-effects ["dom"]
                    :examples ["(history)"]
                    :see-also ["snapshot!" "restore!" "snapshots"]}

 ;; ── Special forms ────────────────────────────────────────────────────────────
 :def        {:type "keyword"
              :detail "(def name val) — bind a name in the global environment"
              :signature "(def name value)"
              :doc "Bind a name in the global environment. The name persists across evaluations."
              :category "special"
              :returns "nil"
              :side-effects []
              :examples ["(def kick (seq :bd :_ :bd :_))"
                         "(def tempo 130)"]
              :see-also ["defn" "let" "defmacro"]}

 :defn       {:type "keyword"
              :detail "(defn name [params] body) — define a named function"
              :signature "(defn name [params] body)"
              :doc "Defines a named function."
              :category "special"
              :returns "nil"
              :side-effects []
              :examples ["(defn double-fast [p] (fast 2 p))"
                         "(defn accent [v p] (amp v p))"]
              :see-also ["def" "fn" "defmacro"]}

 :let        {:type "keyword"
              :detail "(let [name val …] body) — local bindings"
              :signature "(let [name val ...] body)"
              :doc "Create local bindings. Names are only visible inside the let body."
              :category "special"
              :returns "any"
              :side-effects []
              :examples ["(let [x (seq :bd :sd)] (fast 2 x))"
                         "(let [n 4 pat (seq :bd :sd)] (every n rev pat))"]
              :see-also ["def" "fn"]}

 :fn         {:type "keyword"
              :detail "(fn [params] body) — anonymous function"
              :signature "(fn [params ...] body)"
              :doc "Create an anonymous function."
              :category "special"
              :returns "fn"
              :side-effects []
              :examples ["(fn [p] (fast 2 p))"
                         "(every 4 (fn [p] (slow 2 (rev p))) (seq :bd :sd))"]
              :see-also ["defn" "lambda" "comp"]}

 :lambda     {:type "keyword"
              :detail "(lambda [params] body) — anonymous function (alias for fn)"
              :signature "(lambda [params ...] body)"
              :doc "Create an anonymous function (alias for fn)."
              :category "special"
              :returns "fn"
              :side-effects []
              :examples ["(lambda [p] (fast 2 p))"]
              :see-also ["fn" "defn"]}

 :if         {:type "keyword"
              :detail "(if cond then else) — conditional"
              :signature "(if condition then else)"
              :doc "Conditional expression. Evaluates then if condition is truthy, else otherwise."
              :category "special"
              :returns "any"
              :side-effects []
              :examples ["(if (> x 0) :bd :sd)"
                         "(if (= (mod cycle 4) 0) (fast 2 pat) pat)"]
              :see-also ["let" "do"]}

 :do         {:type "keyword"
              :detail "(do expr …) — evaluate expressions, return last"
              :signature "(do expr ...)"
              :doc "Evaluate expressions in sequence, return the value of the last one."
              :category "special"
              :returns "any"
              :side-effects []
              :examples ["(do (def x 1) (+ x 2))"
                         "(do (bpm 130) (track :kick (seq :bd :bd :bd :bd)))"]
              :see-also ["let" "def"]}

 :defmacro   {:type "keyword"
              :detail "(defmacro name [params] body) — define a compile-time macro with quasiquote/unquote"
              :signature "(defmacro name [params] body)"
              :doc "Defines a compile-time macro; the body usually uses quasiquote with ~ unquote and ~@ splice."
              :category "special"
              :returns "nil"
              :side-effects []
              :examples ["(defmacro unless [cond body] `(if (not ~cond) ~body nil))"]
              :see-also ["defn" "fn"]}

 :defsynth   {:type "keyword"
              :detail "(defsynth name [params] body) — define a synth instrument from Web Audio UGens"
              :signature "(defsynth name [params] body)"
              :doc "Defines a synth instrument from Web Audio UGens such as sin, saw, lpf and env-perc."
              :category "special"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(defsynth bell [freq] (->> (sin freq) (env-perc 0.01 1.5)))"
                         "(defsynth bass [freq] (->> (saw freq) (lpf 800) (env-perc 0.01 0.3)))"
                         "(defsynth lfo-sine [] (out :lfo (sin 4))) ; trigger with (seq :lfo-sine)"]
              :see-also ["synth" "sin" "tri" "saw" "env-perc"]}

 :loop       {:type "keyword"
              :detail "(loop [i 0 sum 0] body) — iteration with recursion point; use recur to jump back"
              :signature "(loop [i 0 sum 0] body)"
              :doc "Iteration with a recursion point: recur jumps back to the loop with new binding values."
              :category "special"
              :returns "any"
              :side-effects []
              :examples ["(loop [i 0 acc 0] (if (= i 4) acc (recur (+ i 1) (+ acc i))))"
                         "(loop [xs (range 8) result []] (if (empty? xs) result (recur (rest xs) (conj result (* (first xs) 2)))))"]
              :see-also ["recur" "reduce" "map"]}

 :recur      {:type "keyword"
              :detail "(recur new-i new-sum) — jump to enclosing loop with new binding values"
              :signature "(recur new-i new-sum)"
              :doc "Jumps to the enclosing loop with new binding values."
              :category "special"
              :returns "any"
              :side-effects []
              :examples ["(loop [i 0] (if (= i 4) i (recur (+ i 1))))"]
              :see-also ["loop"]}

 :quasiquote {:type "keyword"
              :detail "(quasiquote form) or `form — template with ~unquote and ~@splice; used in defmacro"
              :signature "(quasiquote form) or `form"
              :doc "A template with ~ unquote and ~@ splice; used in defmacro."
              :category "special"
              :returns "any"
              :side-effects []
              :examples ["`(seq ~a ~b)" "`(stack ~@patterns)"]
              :see-also ["quote" "defmacro"]}

 :quote      {:type "keyword"
              :detail "(quote form) — prevent evaluation of form"
              :signature "(quote form)"
              :doc "Returns form without evaluating it."
              :category "special"
              :returns "any"
              :side-effects []
              :examples ["(quote (seq :bd :sd))" "(quote x)"]
              :see-also ["quasiquote"]}

 :symbol     {:type "function"
              :detail "(symbol str) — convert string to symbol"
              :signature "(symbol str)"
              :doc "Converts a string to a symbol."
              :category "util"
              :returns "symbol"
              :side-effects []
              :examples ["(symbol \"foo\")" "(symbol \"track-name\")"]
              :see-also ["keyword" "name"]}

 ;; ── Collection utilities ─────────────────────────────────────────────────────
 :conj       {:type "function"
              :detail "(conj coll val) — add value to collection"
              :signature "(conj coll val)"
              :doc "Adds a value to a collection."
              :category "util"
              :returns "vector"
              :side-effects []
              :examples ["(conj [1 2 3] 4)" "(conj patterns new-pat)"]
              :see-also ["cons" "concat" "vec"]}

 :count      {:type "function"
              :detail "(count coll) — number of items"
              :signature "(count coll)"
              :doc "The number of items in a collection."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(count [1 2 3])" "(count (range 8))"]
              :see-also ["nth" "first" "rest"]}

 :nth        {:type "function"
              :detail "(nth coll i) — item at index i"
              :signature "(nth coll i)"
              :doc "The item at index i."
              :category "util"
              :returns "any"
              :side-effects []
              :examples ["(nth [1 2 3] 0)" "(nth degrees 2)"]
              :see-also ["first" "rest" "count"]}

 :first      {:type "function"
              :detail "(first coll) — first item"
              :signature "(first coll)"
              :doc "The first item of a collection."
              :category "util"
              :returns "any"
              :side-effects []
              :examples ["(first [1 2 3])" "(first (range 8))"]
              :see-also ["rest" "nth" "count"]}

 :rest       {:type "function"
              :detail "(rest coll) — all items except first"
              :signature "(rest coll)"
              :doc "All items except the first."
              :category "util"
              :returns "vector"
              :side-effects []
              :examples ["(rest [1 2 3])" "(rest (range 4))"]
              :see-also ["first" "cons" "count"]}

 :empty?     {:type "function"
              :detail "(empty? coll) — true if collection has no items"
              :signature "(empty? coll)"
              :doc "True if the collection has no items."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(empty? [])" "(empty? (filter odd? (range 4)))"]
              :see-also ["count" "first"]}

 :cons       {:type "function"
              :detail "(cons x coll) — prepend item to collection"
              :signature "(cons x coll)"
              :doc "Prepends an item to a collection."
              :category "util"
              :returns "list"
              :side-effects []
              :examples ["(cons 0 [1 2 3])" "(cons :bd degrees)"]
              :see-also ["conj" "rest" "first"]}

 :concat     {:type "function"
              :detail "(concat coll …) — concatenate collections"
              :signature "(concat coll ...)"
              :doc "Concatenates collections."
              :category "util"
              :returns "vector"
              :side-effects []
              :examples ["(concat [1 2] [3 4])" "(concat (range 4) [10 11])"]
              :see-also ["conj" "vec"]}

 :vec        {:type "function"
              :detail "(vec coll) — convert to vector"
              :signature "(vec coll)"
              :doc "Converts a collection to a vector."
              :category "util"
              :returns "vector"
              :side-effects []
              :examples ["(vec (range 8))" "(vec (map * (range 4) (range 4)))"]
              :see-also ["concat" "conj"]}

 :map        {:type "function"
              :detail "(map f coll) — apply f to each item, return sequence"
              :signature "(map f coll)"
              :doc "Applies f to each item and returns the resulting sequence."
              :category "util"
              :returns "sequence"
              :side-effects []
              :examples ["(map (fn [x] (* x 2)) (range 4))"
                         "(map (fn [n] (+ n 100)) degrees)"]
              :see-also ["filter" "reduce" "fmap"]}

 :filter     {:type "function"
              :detail "(filter pred coll) — items where pred is truthy"
              :signature "(filter pred coll)"
              :doc "Returns the items for which pred is truthy."
              :category "util"
              :returns "sequence"
              :side-effects []
              :examples ["(filter even? (range 8))"
                         "(filter (fn [x] (> x 2)) [1 2 3 4])"]
              :see-also ["map" "reduce" "empty?"]}

 :reduce     {:type "function"
              :detail "(reduce f coll) or (reduce f init coll) — fold collection"
              :signature "(reduce f coll) or (reduce f init coll)"
              :doc "Folds a collection with f, starting from init when given."
              :category "util"
              :returns "any"
              :side-effects []
              :examples ["(reduce + (range 5))" "(reduce conj [] (range 4))"]
              :see-also ["map" "filter" "count"]}

 :range      {:type "function"
              :detail "(range n) / (range a b step) — numbers; (range lo hi pat) — scale a signal/pattern from 0..1 to lo..hi"
              :signature "(range n) / (range a b step) / (range lo hi pat)"
              :doc "With numbers, the Lisp number sequence (range 8), (range 0 8 2). With a pattern or signal as the last argument it is Tidal's range: scale values from 0..1 to lo..hi, e.g. (range 200 2000 saw). lo and hi may be patterns."
              :category "util"
              :returns "sequence"
              :side-effects []
              :examples ["(range 8)" "(range 2 8)" "(range 0 8 2)" "(segment 4 (range 200 2000 saw))"]
              :see-also ["count" "map" "filter" "segment" "rangex"]}

 :mod        {:type "function"
              :detail "(mod a b) — remainder"
              :signature "(mod a b)"
              :doc "The remainder of a divided by b."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(mod 7 4)" "(mod cycle 3)"]
              :see-also ["quot" "abs"]}

 :quot       {:type "function"
              :detail "(quot a b) — integer quotient"
              :signature "(quot a b)"
              :doc "The integer quotient of a divided by b."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(quot 7 2)" "(quot n 4)"]
              :see-also ["mod" "abs"]}

 :abs        {:type "function"
              :detail "(abs x) — absolute value"
              :signature "(abs x)"
              :doc "The absolute value of x."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(abs -5)" "(abs (- x y))"]
              :see-also ["mod" "max" "min"]}

 :max        {:type "function"
              :detail "(max a b …) — maximum"
              :signature "(max a b ...)"
              :doc "The largest of the given numbers."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(max 3 7)" "(max 0 (- x 1))"]
              :see-also ["min" "abs"]}

 :min        {:type "function"
              :detail "(min a b …) — minimum"
              :signature "(min a b ...)"
              :doc "The smallest of the given numbers."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(min 3 7)" "(min 1.0 (+ x 0.5))"]
              :see-also ["max" "abs"]}

 :identity   {:type "function"
