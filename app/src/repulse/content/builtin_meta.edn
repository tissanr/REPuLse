              :examples ["(keys {:a 1 :b 2})" "(keys m)"]
              :see-also ["vals" "get" "assoc"]}

 :vals       {:type "function"
              :detail "(vals m) — list of map values"
              :signature "(vals m)"
              :doc "The values of a map."
              :category "util"
              :returns "sequence"
              :side-effects []
              :examples ["(vals {:a 1 :b 2})" "(vals m)"]
              :see-also ["keys" "get"]}

 ;; ── AI assistant ─────────────────────────────────────────────────────────────
 :ai         {:type "function"
              :detail "(ai) — open AI assistant panel; (ai \"prompt\") — open and send prompt immediately"
              :signature "(ai) or (ai \"prompt\")"
              :doc "Open the AI assistant panel. With no args, just opens the panel. With a string argument, opens the panel and immediately sends the prompt.\n\nSupported providers (configured in ⚙ settings):\n  anthropic — claude-sonnet-4-6 (default)\n  openai    — gpt-4o (default)\n  google    — gemini-2.0-flash (default)\n  groq      — llama-3.3-70b-versatile (Groq cloud, fast Llama)\n  xai       — grok-3 (xAI / Grok; key from console.x.ai)\n\nAPI keys are stored in localStorage; requests are relayed through the /api/ai-stream proxy, which never logs or stores them. When AI is disabled, returns an informational string."
              :category "ai"
              :returns "nil or string"
              :side-effects ["opens AI assistant panel" "sends prompt to AI provider"]
              :examples ["(ai)"
                         "(ai \"Give me a euclidean kick pattern at 130 bpm\")"
                         "(ai \"How do I make a bass line with (scale :minor :c3 ...)?\")"
                         "(ai \"Add reverb and slow the melody down\")"]
              :providers ["anthropic (claude-sonnet-4-6)"
                          "openai (gpt-4o)"
                          "google (gemini-2.0-flash)"
                          "groq (llama-3.3-70b-versatile)"
                          "xai (grok-3)"]
              :see-also ["help-export"]}

 ;; --- Time & structure (TL3) ---
 :struct {:type "function"
          :detail "(struct bools pat) — Structure from a boolean pattern: every true step of bools plays the value(s) of pat over that step. false, 0, ~, f steps are silent. bools may be a mini-notation string."
          :signature "(struct bools pat)"
          :doc "Structure from a boolean pattern: every true step of bools plays the value(s) of pat over that step. false, 0, ~, f steps are silent. bools may be a mini-notation string."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(struct \"t ~ t t\" (pure :bd))" "(struct \"t*4\" (seq :c3 :e3))"]
  :see-also ["mask" "euclidean" "invert"]}

 :mask {:type "function"
        :detail "(mask bools pat) — Keep the structure of pat, but only the parts that overlap true steps of bools."
        :signature "(mask bools pat)"
        :doc "Keep the structure of pat, but only the parts that overlap true steps of bools."
        :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(mask \"1 0 1 1\" (fast 8 (pure :hh)))" "(mask \"t f\" (seq :a :b :c))"]
  :see-also ["struct" "invert"]}

 :invert {:type "function"
          :detail "(invert pat) — Boolean not on every value: true becomes false and the other way round. Rests stay rests."
          :signature "(invert pat)"
          :doc "Boolean not on every value: true becomes false and the other way round. Rests stay rests."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(struct (invert \"t f t f\") (pure :x))"]
  :see-also ["struct" "mask"]}

 :euclid-legato {:type "function"
                 :detail "(euclid-legato k n pat) — Euclidean rhythm where each hit lasts until the next hit (the last one to the end of the cycle). k and n may be patterns."
                 :signature "(euclid-legato k n pat)"
                 :doc "Euclidean rhythm where each hit lasts until the next hit (the last one to the end of the cycle). k and n may be patterns."
                 :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(euclid-legato 3 8 (pure :x))" "(euclid-legato \"<3 5>\" 8 (pure :x))"]
  :see-also ["euclidean" "euclid-legato-rot"]}

 :euclid-legato-rot {:type "function"
                     :detail "(euclid-legato-rot k n r pat) — euclid-legato with the rhythm rotated left by r steps; steps before the first hit rest. k, n and r may be patterns."
                     :signature "(euclid-legato-rot k n r pat)"
                     :doc "euclid-legato with the rhythm rotated left by r steps; steps before the first hit rest. k, n and r may be patterns."
                     :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(euclid-legato-rot 3 8 2 (pure :x))" "(euclid-legato-rot 3 8 \"<0 2>\" (pure :x))"]
  :see-also ["euclid-legato" "euclidean"]}

 :ply {:type "function"
       :detail "(ply n pat) — Repeat every event n times inside its own slot. n may be a pattern."
       :signature "(ply n pat)"
       :doc "Repeat every event n times inside its own slot. n may be a pattern."
       :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(ply 2 (seq :bd :sd))" "(ply \"<2 3>\" (seq :a :b))"]
  :see-also ["ply-with" "fast"]}

 :ply-with {:type "function"
            :detail "(ply-with n f pat) — Like ply, but repetition i has f applied i times: each event becomes ceil(n) sub-steps. n may be a pattern."
            :signature "(ply-with n f pat)"
            :doc "Like ply, but repetition i has f applied i times: each event becomes ceil(n) sub-steps. n may be a pattern."
            :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(ply-with 3 (add 12) (seq 0 7))" "(ply-with \"<1 2>\" (add 12) (seq 0 7))"]
  :see-also ["ply" "add"]}

 :inside {:type "function"
          :detail "(inside n f pat) — Apply f as if each 1/n of a cycle were a whole cycle: (fast n (f (slow n pat))). n may be a pattern."
          :signature "(inside n f pat)"
          :doc "Apply f as if each 1/n of a cycle were a whole cycle: (fast n (f (slow n pat))). n may be a pattern."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(inside 2 rev (seq 0 1 2 3 4 5 6 7))" "(inside \"<1 2>\" rev (seq 0 1 2 3))"]
  :see-also ["outside" "within"]}

 :outside {:type "function"
           :detail "(outside n f pat) — Apply f across n cycles at once: (inside 1/n f pat). n may be a pattern."
           :signature "(outside n f pat)"
           :doc "Apply f across n cycles at once: (inside 1/n f pat). n may be a pattern."
           :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(outside 2 rev (cat (seq :a :b) (seq :c :d)))" "(outside \"<1 2>\" rev (cat (seq :a :b) (seq :c :d)))"]
  :see-also ["inside" "rev"]}

 :within {:type "function"
          :detail "(within start end f pat) — Apply f only to the events whose start lies in the cycle window [start, end); the others play unchanged. start and end may be patterns."
          :signature "(within start end f pat)"
          :doc "Apply f only to the events whose start lies in the cycle window [start, end); the others play unchanged. start and end may be patterns."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(within 0 1/2 (fast 2) (seq :a :b :c :d))" "(within \"<0 1/2>\" 1 (add 10) (seq 0 1))"]
  :see-also ["inside" "chunk"]}

 :swing-by {:type "function"
            :detail "(swing-by x n pat) — Delay events in the second half of each 1/n slice by x of that slice. x and n may be patterns."
            :signature "(swing-by x n pat)"
            :doc "Delay events in the second half of each 1/n slice by x of that slice. x and n may be patterns."
            :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(swing-by 1/3 4 (fast 8 (pure :hh)))" "(swing-by \"<0 1/3>\" 4 (fast 8 (pure :hh)))"]
  :see-also ["swing" "late" "inside"]}

 :swing {:type "function"
         :detail "(swing n pat) — Shuffle feel: (swing-by 1/3 n pat). n may be a pattern."
         :signature "(swing n pat)"
         :doc "Shuffle feel: (swing-by 1/3 n pat). n may be a pattern."
         :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(swing 4 (fast 8 (pure :hh)))" "(swing \"<2 4>\" (fast 8 (pure :hh)))"]
  :see-also ["swing-by" "late"]}

 :brak {:type "function"
        :detail "(brak pat) — Breakbeat feel: on every odd cycle squeeze the cycle into its first half and shift it right by a quarter."
        :signature "(brak pat)"
        :doc "Breakbeat feel: on every odd cycle squeeze the cycle into its first half and shift it right by a quarter."
        :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(brak (seq :bd :sd))"]
  :see-also ["every" "fast"]}

 :iter {:type "function"
        :detail "(iter n pat) — Shift the start of the pattern earlier by 1/n each cycle, so it rotates through n positions. A cycle-varying pat is held for n cycles. n may be a pattern."
        :signature "(iter n pat)"
        :doc "Shift the start of the pattern earlier by 1/n each cycle, so it rotates through n positions. A cycle-varying pat is held for n cycles. n may be a pattern."
        :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(iter 4 (seq :a :b :c :d))" "(iter \"<4 2>\" (seq :a :b :c :d))"]
  :see-also ["iter-back" "rot" "palindrome"]}

 :iter-back {:type "function"
             :detail "(iter-back n pat) — Like iter, but rotating the other way (the start moves later each cycle). n may be a pattern."
             :signature "(iter-back n pat)"
             :doc "Like iter, but rotating the other way (the start moves later each cycle). n may be a pattern."
             :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(iter-back 4 (seq :a :b :c :d))" "(iter-back \"<4 2>\" (seq :a :b :c :d))"]
  :see-also ["iter" "late"]}

 :palindrome {:type "function"
              :detail "(palindrome pat) — Alternate pat and (rev pat) cycle by cycle. A cycle-varying pat is held for two cycles."
              :signature "(palindrome pat)"
              :doc "Alternate pat and (rev pat) cycle by cycle. A cycle-varying pat is held for two cycles."
              :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(palindrome (seq :a :b :c))"]
  :see-also ["rev" "iter"]}

 :rot {:type "function"
       :detail "(rot n pat) — Rotate the values of each cycle n places to the left while keeping the rhythm. Rests keep their place. n may be a pattern."
       :signature "(rot n pat)"
       :doc "Rotate the values of each cycle n places to the left while keeping the rhythm. Rests keep their place. n may be a pattern."
       :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(rot 1 (seq :a :b :c :d))" "(rot \"<0 1 2>\" (seq :a :b :c))"]
  :see-also ["iter" "rev"]}

 :chunk {:type "function"
         :detail "(chunk n f pat) — Apply f to one n-th of the cycle, moving to the next chunk every cycle (cycle c transforms chunk c mod n). n may be a pattern."
         :signature "(chunk n f pat)"
         :doc "Apply f to one n-th of the cycle, moving to the next chunk every cycle (cycle c transforms chunk c mod n). n may be a pattern."
         :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(chunk 4 (add 10) (seq 0 1 2 3))" "(chunk \"<2 4>\" (add 10) (seq 0 1 2 3))"]
  :see-also ["chunk-back" "fast-chunk" "within"]}

 :chunk-back {:type "function"
              :detail "(chunk-back n f pat) — Like chunk, but the transformed chunk moves backwards: 0, n-1, n-2 … n may be a pattern."
              :signature "(chunk-back n f pat)"
              :doc "Like chunk, but the transformed chunk moves backwards: 0, n-1, n-2 … n may be a pattern."
              :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(chunk-back 4 (add 10) (seq 0 1 2 3))" "(chunk-back \"<4 2>\" (add 10) (seq 0 1 2 3))"]
  :see-also ["chunk" "fast-chunk"]}

 :fast-chunk {:type "function"
              :detail "(fast-chunk n f pat) — Like chunk, but a cycle-varying pat is not held: it plays at the real cycle. n may be a pattern."
              :signature "(fast-chunk n f pat)"
              :doc "Like chunk, but a cycle-varying pat is not held: it plays at the real cycle. n may be a pattern."
              :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(fast-chunk 2 (add 10) (cat (seq 0 1) (seq 4 5)))" "(fast-chunk \"<4 2>\" (add 10) (seq 0 1 2 3))"]
  :see-also ["chunk" "chunk-back"]}

 :polymeter {:type "function"
             :detail "(polymeter [steps] layer ...) — Layer step vectors of different lengths against one steps-per-cycle grid. Each layer is a vector of values or patterns. An optional leading number, string or pattern gives the steps per cycle (default: the first layer's length)."
             :signature "(polymeter [steps] layer ...)"
             :doc "Layer step vectors of different lengths against one steps-per-cycle grid. Each layer is a vector of values or patterns. An optional leading number, string or pattern gives the steps per cycle (default: the first layer's length)."
             :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(polymeter [:bd :sd :hh] [:c3 :e3])" "(polymeter 4 [:a :b :c])" "(polymeter \"<2 4>\" [:a :b :c :d])"]
  :see-also ["timecat" "cat" "seq"]}

 :timecat {:type "function"
           :detail "(timecat [weight x] ...) — Concatenate within one cycle, each entry taking a share of the cycle proportional to its weight. x is a value or a pattern."
           :signature "(timecat [weight x] ...)"
           :doc "Concatenate within one cycle, each entry taking a share of the cycle proportional to its weight. x is a value or a pattern."
           :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(timecat [3 :e3] [1 :g3])" "(timecat [1 (seq :bd :sd)] [2 :hh])"]
  :see-also ["seq" "polymeter" "cat"]}

 :first-of {:type "function"
            :detail "(first-of n f pat) — Apply f on cycles 0, n, 2n … (a synonym of every). n may be a pattern."
            :signature "(first-of n f pat)"
            :doc "Apply f on cycles 0, n, 2n … (a synonym of every). n may be a pattern."
            :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(first-of 4 (add 10) (seq 0 1))" "(first-of \"<2 3>\" (add 10) (seq 0 1))"]
  :see-also ["every" "last-of"]}

 :last-of {:type "function"
           :detail "(last-of n f pat) — Apply f on the last cycle of every n (cycles n-1, 2n-1 …). n may be a pattern."
           :signature "(last-of n f pat)"
           :doc "Apply f on the last cycle of every n (cycles n-1, 2n-1 …). n may be a pattern."
           :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(last-of 4 (add 10) (seq 0 1))" "(last-of \"<4 2>\" (add 10) (seq 0 1))"]
  :see-also ["every" "first-of"]}

 :compress {:type "function"
            :detail "(compress s e pat) — Squeeze each cycle into the window [s, e) of the cycle (0 <= s < e <= 1); silence elsewhere. s and e may be patterns."
            :signature "(compress s e pat)"
            :doc "Squeeze each cycle into the window [s, e) of the cycle (0 <= s < e <= 1); silence elsewhere. s and e may be patterns."
            :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(compress 1/4 3/4 (seq :bd :sd))" "(compress \"<0 1/2>\" 1 (seq :a :b))"]
  :see-also ["zoom" "focus" "fast-gap"]}

 :zoom {:type "function"
        :detail "(zoom s e pat) — Play only the window [s, e) of each cycle, stretched to fill the whole cycle. s and e may be patterns."
        :signature "(zoom s e pat)"
        :doc "Play only the window [s, e) of each cycle, stretched to fill the whole cycle. s and e may be patterns."
        :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(zoom 1/4 3/4 (seq :a :b :c :d))" "(zoom 0 \"<1 1/2>\" (seq :a :b :c :d))"]
  :see-also ["focus" "compress" "linger"]}

 :focus {:type "function"
         :detail "(focus s e pat) — Squeeze the cycle into [s, e) and keep playing, so neighbouring cycles fill the rest (no gaps, unlike compress). s and e may be patterns."
         :signature "(focus s e pat)"
         :doc "Squeeze the cycle into [s, e) and keep playing, so neighbouring cycles fill the rest (no gaps, unlike compress). s and e may be patterns."
         :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(focus 1/4 3/4 (seq :a :b :c :d))" "(focus 0 \"<1 1/2>\" (seq :a :b))"]
  :see-also ["zoom" "compress"]}

 :fast-gap {:type "function"
            :detail "(fast-gap n pat) — Play n times faster, then stay silent until the next cycle. n may be a pattern."
            :signature "(fast-gap n pat)"
            :doc "Play n times faster, then stay silent until the next cycle. n may be a pattern."
            :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(fast-gap 2 (seq :bd :sd))" "(fast-gap \"<1 2>\" (seq :a :b))"]
  :see-also ["compress" "fast"]}

 :linger {:type "function"
          :detail "(linger n pat) — Repeat the first n of every cycle to fill it (the last |n| for negative n). Restarts every cycle. n may be a pattern."
          :signature "(linger n pat)"
          :doc "Repeat the first n of every cycle to fill it (the last |n| for negative n). Restarts every cycle. n may be a pattern."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(linger 1/4 (seq 0 1 2 3 4 5 6 7))" "(linger \"<1/4 1/2>\" (seq 0 1 2 3 4 5 6 7))"]
  :see-also ["zoom" "trunc" "ply"]}

 :bite {:type "function"
        :detail "(bite n ipat pat) — Cut each cycle of pat into n slices; each event of ipat (an index) plays that slice squeezed into its own length. n may be a pattern."
        :signature "(bite n ipat pat)"
        :doc "Cut each cycle of pat into n slices; each event of ipat (an index) plays that slice squeezed into its own length. n may be a pattern."
        :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(bite 4 (seq 0 2) (seq :a :b :c :d :e :f :g :h))" "(bite \"<4 2>\" (seq 0 1) (seq :a :b :c :d :e :f :g :h))"]
  :see-also ["zoom" "chunk-into"]}

 :ribbon {:type "function"
          :detail "(ribbon offset cycles pat) — Loop `cycles` cycles of pat starting at cycle `offset`. offset and cycles may be patterns."
          :signature "(ribbon offset cycles pat)"
          :doc "Loop `cycles` cycles of pat starting at cycle `offset`. offset and cycles may be patterns."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(ribbon 1 2 (cat (pure :a) (pure :b) (pure :c) (pure :d)))" "(ribbon \"<0 1>\" 1 (cat (pure :a) (pure :b) (pure :c)))"]
  :see-also ["repeat-cycles" "early"]}

 :hurry {:type "function"
         :detail "(hurry r pat) — Like fast, and also multiplies every event's :rate by r (a missing rate counts as 1), so samples speed up in pitch too. r may be a pattern."
         :signature "(hurry r pat)"
         :doc "Like fast, and also multiplies every event's :rate by r (a missing rate counts as 1), so samples speed up in pitch too. r may be a pattern."
         :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(hurry 2 (seq :bd :sd))" "(hurry \"<1 2>\" (seq :bd :sd))"]
  :see-also ["fast" "rate"]}

 :revv {:type "function"
        :detail "(revv pat) — Reverse time across cycles (t becomes -t): cycle c plays source cycle -c-1 reversed."
        :signature "(revv pat)"
        :doc "Reverse time across cycles (t becomes -t): cycle c plays source cycle -c-1 reversed."
        :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(revv (seq :a :b :c))"]
  :see-also ["rev"]}

 :repeat-cycles {:type "function"
                 :detail "(repeat-cycles n pat) — Play each source cycle n times before moving to the next. n may be a pattern."
                 :signature "(repeat-cycles n pat)"
                 :doc "Play each source cycle n times before moving to the next. n may be a pattern."
                 :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(repeat-cycles 2 (cat (seq :a) (seq :b)))" "(repeat-cycles \"<1 2>\" (cat (pure :a) (pure :b) (pure :c)))"]
  :see-also ["ribbon" "cat"]}

 :trunc {:type "function"
         :detail "(trunc t pat) — Play only the first t of every cycle; events crossing the cut keep their length but are cut short. t may be a pattern."
         :signature "(trunc t pat)"
         :doc "Play only the first t of every cycle; events crossing the cut keep their length but are cut short. t may be a pattern."
         :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(trunc 3/4 (seq :a :b :c :d))" "(trunc \"<1 1/2>\" (seq :a :b :c :d))"]
  :see-also ["linger" "zoom"]}

 :press {:type "function"
         :detail "(press pat) — Shift every event to start half way through its own length: (press-by 1/2 pat)."
         :signature "(press pat)"
         :doc "Shift every event to start half way through its own length: (press-by 1/2 pat)."
         :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(press (seq :a :b))"]
  :see-also ["press-by"]}

 :press-by {:type "function"
            :detail "(press-by r pat) — Shift every event to start r of the way through its own length and shorten it accordingly. r may be a pattern."
            :signature "(press-by r pat)"
            :doc "Shift every event to start r of the way through its own length and shorten it accordingly. r may be a pattern."
            :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(press-by 1/4 (seq :a :b))" "(press-by \"<0 1/2>\" (seq :a :b))"]
  :see-also ["press" "compress"]}

 :chunk-into {:type "function"
              :detail "(chunk-into n f pat) — Like chunk, but f is applied to the chunk as if it were a full looping cycle, then squeezed back. Chunk index is c mod n. n may be a pattern."
              :signature "(chunk-into n f pat)"
              :doc "Like chunk, but f is applied to the chunk as if it were a full looping cycle, then squeezed back. Chunk index is c mod n. n may be a pattern."
              :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(chunk-into 2 rev (seq 0 1 2 3))" "(chunk-into \"<4 2>\" rev (seq 0 1 2 3))"]
  :see-also ["chunk" "chunk-back-into" "zoom"]}

 :chunk-back-into {:type "function"
                   :detail "(chunk-back-into n f pat) — Like chunk-into, but the chunk moves backwards: n-1, n-2 … 0. n may be a pattern."
                   :signature "(chunk-back-into n f pat)"
                   :doc "Like chunk-into, but the chunk moves backwards: n-1, n-2 … 0. n may be a pattern."
                   :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(chunk-back-into 2 rev (seq 0 1 2 3))" "(chunk-back-into \"<4 2>\" rev (seq 0 1 2 3))"]
  :see-also ["chunk-into" "chunk-back"]}

 :euclidish {:type "function"
             :detail "(euclidish k n g pat) — A Euclidean rhythm whose hits are morphed towards perfectly even spacing by g (0 = euclidean, 1 = even). k, n and g may be patterns."
             :signature "(euclidish k n g pat)"
             :doc "A Euclidean rhythm whose hits are morphed towards perfectly even spacing by g (0 = euclidean, 1 = even). k, n and g may be patterns."
             :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(euclidish 3 8 1/2 (pure :x))" "(euclidish 3 8 \"<0 1>\" (pure :x))"]
  :see-also ["euclidean" "struct"]}

 :ply-for-each {:type "function"
                :detail "(ply-for-each n f pat) — Each event becomes ceil(n) sub-steps; sub-step i >= 1 is (f (pure v) i), where f takes the pattern and the integer index. n may be a pattern."
                :signature "(ply-for-each n f pat)"
                :doc "Each event becomes ceil(n) sub-steps; sub-step i >= 1 is (f (pure v) i), where f takes the pattern and the integer index. n may be a pattern."
                :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(ply-for-each 3 (fn [p i] (add (* i 12) p)) (seq 0 7))" "(ply-for-each \"<1 2>\" (fn [p i] (add i p)) (seq 0 7))"]
  :see-also ["ply" "ply-with"]}

 :filter-events {:type "function"
                 :detail "(filter-events pred pat) — Keep only the events whose value satisfies pred. (Named filter-events because filter works on sequences.)"
                 :signature "(filter-events pred pat)"
                 :doc "Keep only the events whose value satisfies pred. (Named filter-events because filter works on sequences.)"
                 :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(filter-events (fn [v] (> v 2)) (seq 1 2 3 4))"]
  :see-also ["filter-when" "mask"]}

 :filter-when {:type "function"
               :detail "(filter-when pred pat) — Keep only the events whose start time satisfies pred. The time is an integer when whole, otherwise an exact rational like 1/4."
               :signature "(filter-when pred pat)"
               :doc "Keep only the events whose start time satisfies pred. The time is an integer when whole, otherwise an exact rational like 1/4."
               :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(filter-when (fn [t] (< t 1/2)) (seq :a :b :c :d))"]
  :see-also ["filter-events" "within"]}

 :bypass {:type "function"
          :detail "(bypass on pat) — When on is true (1), silence pat; otherwise play it unchanged. on may be a pattern."
          :signature "(bypass on pat)"
          :doc "When on is true (1), silence pat; otherwise play it unchanged. on may be a pattern."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(bypass 0 (seq :a :b))" "(bypass \"<0 1>\" (seq :a :b))"]
  :see-also ["mask" "sew"]}

 :beat {:type "function"
        :detail "(beat t div pat) — Place every value of pat on step t (mod div) of div steps in the cycle. t may be stacked: \"0,7,10\". t and div may be patterns."
        :signature "(beat t div pat)"
        :doc "Place every value of pat on step t (mod div) of div steps in the cycle. t may be stacked: \"0,7,10\". t and div may be patterns."
        :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(beat \"0,7,10\" 16 (pure :bd))" "(beat \"<0 1>\" 4 (pure :bd))"]
  :see-also ["struct" "euclidean"]}

 :sew {:type "function"
       :detail "(sew bools a b) — Switch between patterns a and b: a plays where bools is true, b where it is false. Rests in bools select neither."
       :signature "(sew bools a b)"
       :doc "Switch between patterns a and b: a plays where bools is true, b where it is false. Rests in bools select neither."
       :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(sew \"t f\" (seq :a :a :a :a) (seq :b :b :b :b))" "(sew \"<t f>\" (pure :a) (pure :b))"]
  :see-also ["stitch" "mask"]}

 :stitch {:type "function"
          :detail "(stitch bools a b) — Structure from bools: true steps take a's value, false steps take b's. Rests select neither."
          :signature "(stitch bools a b)"
          :doc "Structure from bools: true steps take a's value, false steps take b's. Rests select neither."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(stitch \"t f t t\" (pure :bd) (pure :sn))"]
  :see-also ["sew" "struct"]}

 :binary {:type "function"
          :detail "(binary n) — The bits of n, most significant first, as a true/false step sequence: (binary 5) = true false true. n may be a pattern."
          :signature "(binary n)"
          :doc "The bits of n, most significant first, as a true/false step sequence: (binary 5) = true false true. n may be a pattern."
          :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(struct (binary 5) (pure :x))" "(struct (binary \"<5 3>\") (pure :x))"]
  :see-also ["binary-n" "struct"]}

 :binary-n {:type "function"
            :detail "(binary-n n [bits]) — The low `bits` bits of n (default 16), most significant first, as a true/false step sequence. n and bits may be patterns."
            :signature "(binary-n n [bits])"
            :doc "The low `bits` bits of n (default 16), most significant first, as a true/false step sequence. n and bits may be patterns."
            :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(struct (binary-n 5 4) (pure :x))" "(binary-n 1 \"<2 4>\")"]
  :see-also ["binary" "struct"]}

 ;; ── Phase SYN6: synth parameters ──────────────────────────────────────────
 :unison {:type "function"
          :detail "(unison n pat) — number of oscillators 1–7 of a synth voice (saw/square/pulse/tri/sine)"
          :signature "(unison n pat) or (unison n)"
          :doc "Number of oscillators of an oscillator voice (1–7), detuned by detune and spread in stereo by spread. Loudness stays about the same."
          :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :a1 :a1 :c2 :e1) (synth :saw) (unison 3) (detune 12) (sub-osc 0.5))"]
  :see-also ["detune" "spread" "supersaw"]}

 :detune {:type "function"
          :detail "(detune cents pat) — total width of the unison stack in cents (0–200; 20 when unison > 1)"
          :signature "(detune cents pat) or (detune cents)"
          :doc "Total detune width of the unison stack in cents (0–200). Default 20 when unison > 1, else 0."
          :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (chord :minor :a3) (synth :supersaw) (detune 18) (spread 0.8))"]
  :see-also ["unison" "spread"]}

 :spread {:type "function"
          :detail "(spread w pat) — stereo width 0–1 of the unison stack (supersaw 0.7)"
          :signature "(spread w pat) or (spread w)"
          :doc "Stereo width of the unison stack, 0 (mono) to 1 (oscillators panned fully left and right). Supersaw default 0.7."
          :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (chord :minor :a3) (synth :supersaw) (spread 0))"]
  :see-also ["unison" "detune"]}

 :sub-osc {:type "function"
           :detail "(sub-osc level pat) — sine one octave below the note, 0–1 (0.5 = 6 dB below the fundamental)"
           :signature "(sub-osc level pat) or (sub-osc level)"
           :doc "Adds a sine one octave below the note. 0.5 puts it 6 dB below the note's fundamental, whatever the waveform. Not the arithmetic sub."
           :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :a1 :c2) (synth :saw) (sub-osc 0.5))"]
  :see-also ["unison" "sub"]}

 :pw {:type "function"
      :detail "(pw width pat) — pulse width 0.01–0.99 of :square / :pulse (default 0.5)"
      :signature "(pw width pat) or (pw width)"
      :doc "Pulse width of the :square / :pulse voice (0.01–0.99, default 0.5). The same key as (synth :square :pw 0.25)."
      :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :c3 :e3) (synth :pulse) (pw 0.25))"]
  :see-also ["pw-rate" "pw-depth"]}

 :pw-rate {:type "function"
           :detail "(pw-rate hz pat) — pulse-width LFO rate 0–20 Hz (WASM voices only)"
           :signature "(pw-rate hz pat) or (pw-rate hz)"
           :doc "Rate of the pulse-width LFO in Hz (0–20). Needs pw-depth. WASM synth voices only (static pw on tracks with an fx chain)."
           :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :c3) (synth :pulse) (pw 0.5) (pw-rate 1) (pw-depth 0.4) (decay 4))"]
  :see-also ["pw" "pw-depth"]}

 :pw-depth {:type "function"
            :detail "(pw-depth d pat) — pulse-width LFO depth 0–0.49 (WASM voices only)"
            :signature "(pw-depth d pat) or (pw-depth d)"
            :doc "Depth of the pulse-width LFO (0–0.49). WASM synth voices only."
            :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :c3) (synth :pulse) (pw-rate 1) (pw-depth 0.4) (decay 4))"]
  :see-also ["pw" "pw-rate"]}

 :sync {:type "function"
        :detail "(sync ratio pat) — hard-sync ratio 1–16 of :saw / :pulse (WASM voices only)"
        :signature "(sync ratio pat) or (sync ratio)"
        :doc "Hard sync: the audible oscillator runs at ratio × the note and restarts with it. The pitch stays the note; higher ratios move a bright formant up. :saw and :pulse, WASM only."
        :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :c3 :c3 :c3 :c3) (synth :saw) (sync (seq 2 3 4.5 6)))"]
  :see-also ["synth" "sync-lead"]}

 :tune {:type "function"
        :detail "(tune st pat) — pitch of a synthesized drum in semitones (−48…48)"
        :signature "(tune st pat) or (tune st)"
        :doc "Pitch of a synthesized kit drum in semitones (−48…48). Samples and the legacy drums ignore it."
        :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :bd :bd :bd :bd) (tune (seq 0 0 -5 0)) (decay 0.8))"]
  :see-also ["tone" "decay" "bank"]}

 :tone {:type "function"
        :detail "(tone t pat) — brightness / body–noise balance 0–1 of a synthesized drum"
        :signature "(tone t pat) or (tone t)"
        :doc "Brightness of a synthesized kit drum (0–1): kick sweep and click, snare body vs noise, hat high-pass, clap band. Absent = the voice's default."
        :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (fast 4 (seq :hh :hh :oh :hh)) (tone (range 0.2 0.9 sine)))"]
  :see-also ["tune" "decay" "bank"]}

 :glide {:type "function"
         :detail "(glide secs pat) — portamento from the previous note of the track, 0–5 s"
         :signature "(glide secs pat) or (glide secs)"
         :doc "Portamento: the note slides from the previous note of the same track (the nearest note of the previous chord) in secs. Oscillator voices and the presets built on them."
         :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :c2 :c2 :eb2 :g1) (synth :acid) (glide (seq 0 0 0.06 0)))"]
  :see-also ["acid" "theremin"]}

 :accent {:type "function"
          :detail "(accent a pat) — accent 0–1: louder; with a filter envelope opens further, closes faster"
          :signature "(accent a pat) or (accent a)"
          :doc "Accent (0–1): amp × (1 + 0.5a); with a filter envelope also lp-env + 1.5a and a shorter lp-decay."
          :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :c2 :c2 :c2 :c2) (synth :acid) (accent (seq 0 1 0 0)))"]
  :see-also ["acid" "lp-env"]}

 :lp-rate {:type "function"
           :detail "(lp-rate n pat) — cutoff LFO rate of the low-pass, periods per cycle (0–64)"
           :signature "(lp-rate n pat) or (lp-rate n)"
           :doc "Cutoff LFO of the low-pass in periods per cycle, phase-locked to the cycle. Needs lpf and lp-depth."
           :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :a1) (synth :saw) (lpf 400) (lp-rate 4) (lp-depth 2) (decay 2))"]
  :see-also ["lp-depth" "lpf" "wobble"]}

 :lp-depth {:type "function"
            :detail "(lp-depth oct pat) — cutoff LFO depth of the low-pass in octaves (0–4)"
            :signature "(lp-depth oct pat) or (lp-depth oct)"
            :doc "Depth of the cutoff LFO in octaves (0–4). Needs lpf."
            :category "param"
  :returns "Pattern"
  :side-effects []
  :examples ["(->> (seq :a1) (synth :saw) (lpf 400) (lp-rate 2) (lp-depth 2) (decay 2))"]
  :see-also ["lp-rate" "lpf"]}

 ;; ── Phase SYN6: voices ──────────────────────────────────────────────────────
 :pulse {:type "keyword"
         :detail "(synth :pulse) — band-limited pulse wave (alias of :square); (pw 0.25), (pw-rate 1) (pw-depth 0.4)"
         :signature "(synth :pulse)"
         :doc "Band-limited pulse wave, an alias of :square. Shape it with (pw 0.25), (pw-rate 1) and (pw-depth 0.4)."
         :category "synth"
  :description "Band-limited pulse wave (alias of :square); (pw 0.25), (pw-rate 1) (pw-depth 0.4)."
  :returns "event-param-map"
  :side-effects []
  :examples ["(->> (seq :c3 :e3 :g3) (synth :pulse) (pw 0.3))"]
  :see-also ["square" "pw" "supersaw" "synth"]}

 :supersaw {:type "keyword"
            :detail "(synth :supersaw) — seven detuned saws spread in stereo (unison 7, detune 20, spread 0.7)"
            :signature "(synth :supersaw)"
            :doc "Seven detuned saws spread in stereo; defaults are unison 7, detune 20, spread 0.7."
            :category "synth"
  :description "Seven detuned saws spread in stereo (unison 7, detune 20, spread 0.7)."
  :returns "event-param-map"
  :side-effects []
  :examples ["(->> (chord :minor :a3) (synth :supersaw) (detune 18) (spread 0.8))"]
  :see-also ["unison" "detune" "spread" "synth"]}

 :acid {:type "keyword"
        :detail "(synth :acid) — squelchy resonant saw bass, fast filter envelope; reacts to accent and glide"
        :signature "(synth :acid)"
        :doc "Squelchy resonant saw bass with a fast filter envelope; reacts to accent and glide."
        :category "synth"
  :description "Squelchy resonant saw bass, fast filter envelope; reacts to accent and glide."
  :returns "event-param-map"
  :side-effects []
  :examples ["(->> (seq :c2 :c2 :eb2 :g1) (synth :acid) (glide (seq 0 0 0.06 0)))"]
  :see-also ["accent" "glide" "fm-bass" "synth"]}

 :reese {:type "keyword"
         :detail "(synth :reese) — two detuned saws, a dark beating bass"
         :signature "(synth :reese)"
         :doc "Two detuned saws, a dark beating bass."
         :category "synth"
  :description "Two detuned saws, a dark beating bass."
  :returns "event-param-map"
  :side-effects []
  :examples ["(->> (seq :c2 :eb2 :g1 :bb1) (synth :reese))"]
  :see-also ["sub-bass" "wobble" "synth"]}

 :sub-bass {:type "keyword"
            :detail "(synth :sub-bass) — sine bass with gentle saturation"
            :signature "(synth :sub-bass)"
            :doc "Sine bass with gentle saturation."
            :category "synth"
  :description "Sine bass with gentle saturation."
  :returns "event-param-map"
  :side-effects []
  :examples ["(->> (seq :c1 :_ :g1 :_) (synth :sub-bass))"]
  :see-also ["reese" "sub-osc" "synth"]}

 :fm-bass {:type "keyword"
           :detail "(synth :fm-bass) — FM bass with a plucky filter envelope"
