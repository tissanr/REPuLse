              :side-effects []
              :examples ["(nil? nil)" "(nil? :bd)"]
              :see-also ["empty?" "number?" "string?"]}

 :map?       {:type "function"
              :detail "(map? x) — true if x is a map"
              :signature "(map? x)"
              :doc "True if x is a map."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(map? {:a 1})" "(map? [1 2])"]
              :see-also ["vector?" "seq?" "nil?"]}

 :seq?       {:type "function"
              :detail "(seq? x) — true if x is a sequence"
              :signature "(seq? x)"
              :doc "True if x is a sequence."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(seq? (list 1 2 3))" "(seq? [1 2 3])"]
              :see-also ["vector?" "map?" "list"]}

 :vector?    {:type "function"
              :detail "(vector? x) — true if x is a vector"
              :signature "(vector? x)"
              :doc "True if x is a vector."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(vector? [1 2 3])" "(vector? (list 1 2))"]
              :see-also ["seq?" "map?" "vec"]}

 :not        {:type "function"
              :detail "(not x) — logical negation"
              :signature "(not x)"
              :doc "Logical negation."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(not true)" "(not (empty? xs))"]
              :see-also ["and" "or" "if"]}

 :and        {:type "keyword"
              :detail "(and a b …) — logical conjunction; short-circuits on false"
              :signature "(and a b ...)"
              :doc "Logical conjunction; short-circuits on the first false value."
              :category "special"
              :returns "any"
              :side-effects []
              :examples ["(and (> x 0) (< x 10))" "(and pat1 pat2)"]
              :see-also ["or" "not" "if"]}

 :or         {:type "keyword"
              :detail "(or a b …) — logical disjunction; short-circuits on true"
              :signature "(or a b ...)"
              :doc "Logical disjunction; short-circuits on the first true value."
              :category "special"
              :returns "any"
              :side-effects []
              :examples ["(or x default)" "(or (get m :k) 0)"]
              :see-also ["and" "not" "if"]}

 ;; ── Arithmetic ───────────────────────────────────────────────────────────────
 :+          {:type "function"
              :detail "(+ a b …) — addition"
              :signature "(+ a b ...)"
              :doc "Adds numbers."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(+ 1 2)" "(+ 100 (* 12 n))"]
              :see-also ["-" "*" "/"]}

 :-          {:type "function"
              :detail "(- a b …) — subtraction"
              :signature "(- a b ...)"
              :doc "Subtracts numbers."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(- 10 3)" "(- x 1)"]
              :see-also ["+" "*" "/"]}

 :*          {:type "function"
              :detail "(* a b …) — multiplication"
              :signature "(* a b ...)"
              :doc "Multiplies numbers."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(* 2 3)" "(* factor n)"]
