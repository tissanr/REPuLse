{;; ── Pattern constructors ────────────────────────────────────────────────────
 :seq        {:type "function"
              :detail "(seq val …) — sequence of values, one per cycle step"
              :signature "(seq val ...)"
              :doc "Create a sequence of values, each occupying one equal step per cycle."
              :category "source"
              :returns "Pattern"
              :side-effects []
              :examples ["(seq :bd :sd :bd :sd)" "(seq 220 330 440)" "(seq :c4 :e4 :g4)"]
              :see-also ["stack" "pure" "cat" "alt"]}

 :stack      {:type "function"
              :detail "(stack pat …) — play patterns in parallel"
              :signature "(stack pat ...)"
              :doc "Play multiple patterns simultaneously in parallel."
              :category "source"
              :returns "Pattern"
              :side-effects []
              :examples ["(stack (seq :bd :_ :bd :_) (seq :_ :sd :_ :sd))"
                         "(stack (seq :bd :bd :bd :bd) (fast 2 (seq :hh :oh)))"]
              :see-also ["seq" "track"]}

 :pure       {:type "function"
              :detail "(pure val) — a single constant value"
              :signature "(pure val)"
              :doc "A constant pattern that plays a single value for the entire cycle."
              :category "source"
              :returns "Pattern"
              :side-effects []
              :examples ["(pure :bd)" "(pure 440)"]
              :see-also ["seq" "stack"]}

 :euclidean  {:type "function"
              :detail "(euclidean k n val) — Björklund (Tidal) rhythm: k onsets in n steps; a pattern as val gets the rhythm as structure, e.g. (euclidean 3 8 (seq :bd :sd)); optional left rotation (euclidean k n val rot); k/n/rot may be patterns"
              :signature "(euclidean k n val) or (euclidean k n val rot)"
              :doc "Distribute k onsets evenly across n steps (Tidal's Björklund). Optional rot rotates left. val a pattern gives the rhythm to that pattern: (euclidean 3 8 (seq :bd :sd)). k, n and rot may be patterns: (euclidean \"<3 5>\" 8 :bd)."
              :category "source"
              :returns "Pattern"
              :side-effects []
              :examples ["(euclidean 5 8 :bd)" "(euclidean 3 8 :sd 2)"
                         "(euclidean \"<3 5>\" 8 :bd)"
                         "(euclidean 3 8 (seq :bd :sd))"]
              :see-also ["seq" "degrade" "struct" "euclid-legato"]}

 :cat        {:type "function"
              :detail "(cat pat …) — play patterns one per cycle, then loop the sequence"
              :signature "(cat pat ...)"
              :doc "Concatenate patterns: each plays for one full cycle in sequence, then loops."
              :category "source"
              :returns "Pattern"
              :side-effects []
              :examples ["(cat (seq :bd :sd) (seq :hh :oh))"
                         "(cat (scale :minor :c4 (seq 0 2 4)) (scale :major :c4 (seq 0 2 4)))"]
              :see-also ["seq" "alt" "arrange"]}

 :alt        {:type "function"
              :detail "(alt pat-a pat-b …) — cycle-based alternation: play pat-a on cycle 0, pat-b on cycle 1, …"
              :signature "(alt pat-a pat-b ...)"
              :doc "Cycle-based alternation: plays the first pattern on cycle 0, the second on cycle 1, and so on, wrapping around after the last."
              :category "source"
              :returns "Pattern"
              :side-effects []
              :examples ["(alt (seq :bd :sd) (seq :sd :bd))"
                         "(alt (seq :hh :hh :hh) (seq :oh :_ :hh))"]
              :see-also ["cat" "seq"]}



 "~"         {:type "function"
              :detail "(~ \"bd sd [hh hh] bd\") — parse mini-notation string into pattern; also bd!3, a . b, a, b, {a b c}%4, bd(3,8,2)"
              :signature "(~ \"mini-notation\")"
              :doc "Parse a mini-notation string into a pattern: [ ] groups, < > alternation, * ? : @, bd!3 repeats, a . b groups, a, b layers, {a b c}%4 polymeter, bd(3,8,2) euclid. _ and ~ are rests; use @ to elongate."
              :category "source"
              :returns "Pattern"
              :side-effects []
              :examples ["(~ \"bd sd [hh hh] bd\")"
                         "(~ \"bd*4 sd <oh hh>\")"
                         "(~ \"bd!3 sd . hh hh hh, cp(3,8)\")"
                         "(~ \"{a b c}%4\")"]
              :see-also ["seq" "stack"]}

 :arrange    {:type "function"
              :detail "(arrange [[pat cycles] …]) — sequence patterns by duration"
              :signature "(arrange [[pat cycles] ...])"
              :doc "Sequence patterns by duration. Each [pattern cycles] pair plays for the given number of cycles."
              :category "source"
              :returns "nil"
              :side-effects ["audio" "dom"]
              :examples ["(arrange [[(seq :bd :sd) 4] [(seq :hh :oh) 2]])"
                         "(arrange [[(fast 2 (seq :bd :sd)) 8] [(slow 2 (seq :bd :hh)) 4]])"]
              :see-also ["play-scenes" "track"]}

 :play-scenes {:type "function"
               :detail "(play-scenes [pat …]) — play patterns as 1-cycle scenes"
               :signature "(play-scenes [pat ...])"
               :doc "Play patterns as sequential 1-cycle scenes."
               :category "source"
               :returns "nil"
               :side-effects ["audio" "dom"]
               :examples ["(play-scenes [(seq :bd :sd) (seq :hh :oh)])"
                          "(play-scenes [(fast 2 (seq :bd)) (slow 2 (seq :sd))])"]
               :see-also ["arrange" "cat"]}

 :song       {:type "function"
              :detail "(song (section …) … [:end :stop|:loop]) — play tracks as a song with sections; stops (or loops) after the last bar"
              :signature "(song (section …) … [:end :stop|:loop])"
              :doc "Play the tracks defined above as a song: sections play in order, each for its number of bars, with only the tracks it lists. Stops after the last bar (:end :stop, default) or loops (:end :loop). One song per buffer, at the bottom."
              :category "source"
              :returns "Song"
              :side-effects ["audio"]
              :examples ["(song (section :intro 4 [:kick :hats]) (section :verse 8 [:kick :snare :bass]) (section :chorus 8 :all))"
                         "(song (section :a 4 [:kick]) (section :b 4 :all) :end :loop)"]
              :see-also ["section" "track" "play-from" "export" "arrange"]}

 :section    {:type "function"
              :detail "(section :name bars [:track …]) — a song section: name, length in bars, tracks that play (or :all)"
              :signature "(section :name bars [:track ...])"
              :doc "A song section: a unique name, a length in bars (1 bar = 1 cycle) and the tracks that play in it — a vector of track names or :all. Used inside (song …)."
              :category "source"
              :returns "Section"
              :side-effects []
              :examples ["(section :verse 8 [:kick :snare :bass])" "(section :chorus 8 :all)"]
              :see-also ["song" "track" "play-from"]}

 :automate   {:type "function"
              :detail "(automate :track|:all :param curve [:bars [a b]] [:op :set|:mul|:add]) — inside a section: set a parameter from a number, (ramp …) or pattern, in section-local time"
              :signature "(automate :track|:all :param curve [:bars [a b]] [:op :set|:mul|:add])"
              :doc "Used inside a section: sets a parameter from a number, a (ramp ...) or a pattern, in section-local time. :bars limits it to a bar range and :op chooses how the value combines with the existing one."
              :category "source"
              :returns "Automation"
              :side-effects []
              :examples ["(section :build 4 [:kick :hats] (automate :hats :amp (ramp :linear 0 1)))" "(section :build 4 [:hats] (automate :hats :amp (ramp :linear 0 1) :op :mul :bars [2 4]))"]
              :see-also ["section" "song" "ramp" "tween"]}

 :ramp       {:type "function"
              :detail "(ramp :linear|:exp|:sine from to) — a curve over a section (or :bars range) for (automate …); never reaches `to` inside the lane"
              :signature "(ramp :linear|:exp|:sine from to)"
              :doc "A curve over a section, or over a :bars range, for use with (automate ...). It never reaches `to` inside the lane."
              :category "source"
              :returns "Ramp"
              :side-effects []
              :examples ["(ramp :linear 0 1)" "(ramp :exp 300 4000)"]
              :see-also ["automate" "section" "tween"]}

 :fill       {:type "function"
              :detail "(fill :track bars pattern|:_) — inside a section: replace a track's events in the last N bars (:_ = drop out)"
              :signature "(fill :track bars pattern|:_)"
              :doc "Used inside a section: replaces a track's events in the last N bars with the given pattern. :_ drops the track out for those bars."
              :category "source"
              :returns "Fill"
              :side-effects []
              :examples ["(section :build 4 [:kick :snare] (fill :snare 1 (fast 4 (seq :sd :sd))))" "(section :build 4 [:kick] (fill :kick 1 :_))"]
              :see-also ["section" "song" "automate"]}

 :play-from  {:type "function"
              :detail "(play-from :section) / (play-from bar) — start or jump the song to a section or 0-based bar"
              :signature "(play-from :section) / (play-from bar)"
              :doc "Start (or jump) the song at the first bar of a section, or at a 0-based bar number. Works while playing and after (stop)."
              :category "audio"
              :returns "nil"
              :side-effects ["audio"]
              :examples ["(play-from :chorus)" "(play-from 12)"]
              :see-also ["song" "section" "export"]}

 :use        {:type "function"
              :detail "(use :drums :bass) — evaluate other project buffers first (once per evaluation, shared definitions)"
              :signature "(use :buffer …)"
              :doc "Evaluate the named project buffers, in order, before continuing. All buffers share one environment, so their defs and tracks are visible unqualified. Each buffer runs at most once per evaluation; circular use is an error. Only works when Alt+Enter evaluates the project (not in the command bar)."
              :category "special"
              :returns "String"
              :side-effects []
              :examples ["(use :drums)" "(use :drums :bass)"]
              :see-also ["def" "track" "song"]}

 ;; ── Pattern transformers ─────────────────────────────────────────────────────
 :fast       {:type "function"
              :detail "(fast factor pat) — speed up a pattern; factor may be a pattern or mini-notation, e.g. (fast \"<1 2>\" pat)"
              :signature "(fast factor pat)"
              :doc "Speed up a pattern by the given factor. 2 = twice as fast. The factor may be a pattern or a mini-notation string: (fast \"<1 2>\" pat)."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(fast 2 (seq :bd :sd))" "(fast 3 (seq :hh :oh :hh))"
                         "(fast \"<1 2 4>\" (seq :bd :sd))"]
              :see-also ["slow" "every" "rev"]}

 :slow       {:type "function"
              :detail "(slow factor pat) — slow down a pattern; factor may be a pattern or mini-notation"
              :signature "(slow factor pat)"
              :doc "Slow down a pattern by the given factor. 2 = half speed. The factor may be a pattern or a mini-notation string."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(slow 2 (seq :bd :sd :hh :oh))" "(slow 4 (seq :c4 :e4 :g4))"
                         "(slow (seq 1 2) (seq :bd :sd :hh :oh))"]
              :see-also ["fast" "every"]}

 :rev        {:type "function"
              :detail "(rev pat) — reverse a pattern"
              :signature "(rev pat)"
              :doc "Reverse the order of events within each cycle."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(rev (seq :bd :sd :hh :oh))" "(every 4 rev (seq :bd :sd))"]
              :see-also ["every" "jux"]}

 :every      {:type "function"
              :detail "(every n f pat) — apply f every n cycles; n may be a pattern, e.g. (every \"<2 4>\" rev pat)"
              :signature "(every n transform pat)"
              :doc "Apply a transformation every nth cycle. Other cycles play unmodified. n may be a pattern."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(every 4 (fast 2) (seq :bd :sd))"
                         "(every 3 rev (seq :bd :sd :hh :oh))"
                         "(every \"<2 4>\" rev (seq :bd :sd :hh :oh))"]
              :see-also ["sometimes" "fast" "slow"]}

 :fmap       {:type "function"
              :detail "(fmap f pat) — map a function over pattern values"
              :signature "(fmap f pat)"
              :doc "Map a function over every value in the pattern."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(fmap (fn [x] (* x 2)) (seq 1 2 3))"
                         "(fmap (fn [x] (+ x 100)) (seq 220 330))"]
              :see-also ["map" "scale"]}

 :late       {:type "function"
              :detail "(late amount pat) — shift events forward by fraction of a cycle; amount may be a pattern, e.g. (late \"<0 1/8>\" pat)"
              :signature "(late amount pat)"
              :doc "Shift events forward in time by a fraction of a cycle. The amount may be a pattern: (late \"<0 1/8>\" pat)."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(late 0.25 (seq :hh :hh :hh :hh))"
                         "(late 0.5 (euclidean 3 8 :sd))"
                         "(late \"<0 1/8>\" (seq :hh :hh :hh :hh))"]
              :see-also ["early" "off"]}

 :early      {:type "function"
              :detail "(early amount pat) — shift events backward by fraction of a cycle; amount may be a pattern"
              :signature "(early amount pat)"
              :doc "Shift events backward in time by a fraction of a cycle. The amount may be a pattern."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(early 0.125 (seq :sd :_ :sd :_))"
                         "(early 0.25 (seq :hh :oh))"
                         "(early (seq 0 1/8) (seq :hh :oh :hh :oh))"]
              :see-also ["late" "off"]}







;; ── Phase TL4: Randomness & conditionals ──────────────────────────────────
 :sometimes {:type "function"
             :detail "(sometimes f pat) — apply f to ~50% of events (per event)"
             :signature "(sometimes f pat)"
             :doc "Apply transform f to each event with probability 0.5 (per event, deterministic). For whole cycles use some-cycles."
             :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(sometimes (fast 2) (seq :bd :sd :hh :cp))" "(sometimes rev (seq :bd :sd :hh :oh))"]
  :see-also ["often" "rarely" "sometimes-by" "some-cycles" "every"]}

 :often {:type "function"
         :detail "(often f pat) — apply f to ~75% of events (per event)"
         :signature "(often f pat)"
         :doc "Apply transform f to each event with probability 0.75."
         :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(often rev (seq :bd :sd :hh :oh))" "(often (fast 2) (seq :hh))"]
  :see-also ["sometimes" "rarely" "every"]}

 :rarely {:type "function"
          :detail "(rarely f pat) — apply f to ~25% of events (per event)"
          :signature "(rarely f pat)"
          :doc "Apply transform f to each event with probability 0.25."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(rarely (fast 2) (seq :bd :sd))" "(rarely rev (seq :bd :sd :hh :oh))"]
  :see-also ["sometimes" "often" "sometimes-by"]}

 :sometimes-by {:type "function"
                :detail "(sometimes-by prob f pat) — per event, apply f with probability prob; prob may be a pattern"
                :signature "(sometimes-by prob f pat)"
                :doc "Each event goes through f with probability prob (0.0–1.0), independently and deterministically. prob may be a pattern."
                :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(sometimes-by 0.3 rev (seq :bd :sd :hh :oh))" "(sometimes-by 0.8 (fast 2) (seq :hh))" "(sometimes-by \"<0.2 0.8>\" rev (seq :bd :sd :hh :oh))"]
  :see-also ["sometimes" "often" "rarely" "some-cycles-by"]}

 :degrade {:type "function"
           :detail "(degrade pat) — randomly drop ~50% of events"
           :signature "(degrade pat)"
           :doc "Randomly drop about half of the events (deterministic; keeps an event when rand at its start is >= 0.5)."
           :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(degrade (seq :hh :hh :hh :hh))" "(degrade (euclidean 5 8 :bd))"]
  :see-also ["degrade-by" "undegrade" "sometimes"]}

 :degrade-by {:type "function"
              :detail "(degrade-by prob pat) — drop events with probability prob; prob may be a pattern"
              :signature "(degrade-by prob pat)"
              :doc "Drop events with the given probability (0.0 = keep all, 1.0 = drop all). An event is kept when rand at its start is >= prob. prob may be a pattern."
              :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(degrade-by 0.3 (seq :hh :hh :hh :hh))" "(degrade-by 0.7 (fast 2 (seq :bd :sd)))" "(degrade-by \"<0 0.5>\" (fast 8 (pure :hh)))"]
  :see-also ["degrade" "undegrade-by" "sometimes-by"]}

 :choose {:type "function"
          :detail "(choose [vals]) — random signal; sample it: (segment 4 (choose [:bd :sd]))"
          :signature "(choose [val ...])"
          :doc "A random signal picking from the vector. It has no onsets of its own, so it is silent unless sampled: (segment 4 (choose [:bd :sd])) or (struct \"t ~ t t\" (choose ...)). For one pick per cycle use choose-cycles."
          :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 (choose [:bd :sd :hh :oh]))" "(struct \"t ~ t t\" (choose [:bd :sd :hh]))"]
  :see-also ["choose-cycles" "wchoose" "randcat" "segment"]}

 :wchoose {:type "function"
           :detail "(wchoose [[weight val] …]) — weighted random signal; sample it with segment"
           :signature "(wchoose [[weight val] ...])"
           :doc "Weighted random signal, weight first: (wchoose [[3 :bd] [1 :sd]]). Silent unless sampled: (segment 4 (wchoose ...)). For one pick per cycle use wchoose-cycles."
           :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 (wchoose [[3 :bd] [1 :sd] [2 :hh]]))" "(segment 8 (wchoose [[4 :c4] [2 :e4] [1 :g4]]))"]
  :see-also ["wchoose-cycles" "choose" "wrandcat"]}

 :undegrade-by {:type "function"
                :detail "(undegrade-by prob pat) — keep events with probability prob (complement of degrade-by); prob may be a pattern"
                :signature "(undegrade-by prob pat)"
                :doc "Keep only the events degrade-by would drop: an event survives when rand at its start is < prob. (stack (degrade-by x p) (undegrade-by x p)) equals p. prob may be a pattern."
                :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(undegrade-by 0.3 (seq :a :b :c :d))" "(undegrade-by \"<0.2 0.6>\" (seq :a :b :c :d))"]
  :see-also ["undegrade" "degrade-by" "sometimes-by"]}

 :undegrade {:type "function"
             :detail "(undegrade pat) — keep the ~50% of events degrade would drop"
             :signature "(undegrade pat)"
             :doc "(undegrade-by 0.5 pat): the complement of degrade."
             :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(undegrade (seq :a :b :c :d))"]
  :see-also ["degrade" "undegrade-by"]}

 :degrade-by-with {:type "function"
                   :detail "(degrade-by-with rpat prob pat) — keep events where rpat (sampled at the event start) >= prob"
                   :signature "(degrade-by-with rpat prob pat)"
                   :doc "Like degrade-by with your own random source: keep an event when the value of rpat at its start is >= prob. Non-numeric values drop the event. rpat and prob may be patterns."
                   :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(degrade-by-with saw 0.5 (fast 8 (pure :hh)))" "(degrade-by-with (segment 1 rand) \"<0.2 0.6>\" (fast 8 (pure :hh)))"]
  :see-also ["degrade-by" "rand" "sometimes-by"]}

 :almost-never {:type "function"
                :detail "(almost-never f pat) — apply f to ~10% of events"
                :signature "(almost-never f pat)"
                :doc "Apply transform f to each event with probability 0.1."
                :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(almost-never rev (seq :a :b :c :d))"]
  :see-also ["sometimes-by" "rarely" "almost-always"]}

 :almost-always {:type "function"
                 :detail "(almost-always f pat) — apply f to ~90% of events"
                 :signature "(almost-always f pat)"
                 :doc "Apply transform f to each event with probability 0.9."
                 :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(almost-always rev (seq :a :b :c :d))"]
  :see-also ["sometimes-by" "often" "almost-never"]}

 :always {:type "function"
          :detail "(always f pat) — apply f (same as (f pat))"
          :signature "(always f pat)"
          :doc "Always apply f; useful as a switch-able end of the sometimes family."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(always rev (seq :a :b))"]
  :see-also ["never" "sometimes"]}

 :never {:type "function"
         :detail "(never f pat) — leave pat unchanged"
         :signature "(never f pat)"
         :doc "Never apply f; returns pat unchanged."
         :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(never rev (seq :a :b))"]
  :see-also ["always" "sometimes"]}

 :some-cycles-by {:type "function"
                  :detail "(some-cycles-by prob f pat) — per cycle, apply f with probability prob; prob may be a pattern"
                  :signature "(some-cycles-by prob f pat)"
                  :doc "Whole-cycle randomness: cycle c is answered by (f pat) when rand at c is < prob, otherwise by pat. This is the pre-TL4 behaviour of sometimes-by. prob may be a pattern."
                  :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(some-cycles-by 0.3 (fast 2) (seq :bd :sd))" "(some-cycles-by \"<0 1>\" rev (seq :bd :sd))"]
  :see-also ["some-cycles" "sometimes-by" "every"]}

 :some-cycles {:type "function"
               :detail "(some-cycles f pat) — apply f to ~50% of whole cycles"
               :signature "(some-cycles f pat)"
               :doc "(some-cycles-by 0.5 f pat): the whole cycle is either transformed or not."
               :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(some-cycles rev (seq :bd :sd))"]
  :see-also ["some-cycles-by" "sometimes"]}

 :choose-with {:type "function"
               :detail "(choose-with sig [vals]) — pick from vals using signal sig (0..1); structure from sig"
               :signature "(choose-with sig [val ...])"
               :doc "Pick from the vector using the value of the signal sig (in [0,1)); the result takes its structure from sig. sig may be a pattern."
               :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 (choose-with sine [:a :b :c]))"]
  :see-also ["choose" "choose-in-with"]}

 :choose-in-with {:type "function"
                  :detail "(choose-in-with sig [pats]) — like choose-with, but the chosen pattern keeps its own structure"
                  :signature "(choose-in-with sig [pat ...])"
                  :doc "Pick a pattern with the signal sig and let it keep its own structure (inner join). sig may be a pattern."
                  :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(choose-in-with (segment 1 rand) [(seq :a :b) (pure :c)])"]
  :see-also ["choose-in" "randcat" "choose-with"]}

 :choose-in {:type "function"
             :detail "(choose-in [pats]) — random pattern signal; chosen pattern keeps its structure"
             :signature "(choose-in [pat ...])"
             :doc "(choose-in-with rand pats). The pick depends on the query start, so use randcat for a stable per-cycle choice."
             :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(choose-in [(seq :a :b) (seq :c :d)])"]
  :see-also ["randcat" "choose-in-with"]}

 :choose-cycles {:type "function"
                 :detail "(choose-cycles [vals]) — one random pick per cycle (the pre-TL4 choose)"
                 :signature "(choose-cycles [val ...])"
                 :doc "One random value (or pattern) per cycle, deterministic. Values may be patterns."
                 :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(choose-cycles [:bd :sd :hh])" "(track :perc (choose-cycles [:bd :sd :hh]))"]
  :see-also ["randcat" "choose" "wchoose-cycles"]}

 :wchoose-cycles {:type "function"
                  :detail "(wchoose-cycles [[weight val] …]) — weighted pick per cycle (the pre-TL4 wchoose)"
                  :signature "(wchoose-cycles [[weight val] ...])"
                  :doc "Weighted random pick, one per cycle; weight first."
                  :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(wchoose-cycles [[3 :bd] [1 :sd]])"]
  :see-also ["wrandcat" "choose-cycles" "wchoose"]}

 :randcat {:type "function"
           :detail "(randcat pat …) — play one randomly chosen pattern per cycle"
           :signature "(randcat pat ...)"
           :doc "Each cycle plays one of the given patterns, picked at random (deterministically)."
           :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(randcat (seq :bd :sd) (seq :hh :hh :oh) (seq :cp))"]
  :see-also ["wrandcat" "choose-cycles" "cat"]}

 :wrandcat {:type "function"
            :detail "(wrandcat [w pat] …) — weighted random pattern per cycle"
            :signature "(wrandcat [weight pat] ...)"
            :doc "Like randcat with weights: (wrandcat [3 (seq :bd :sd)] [1 (pure :cp)])."
            :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(wrandcat [3 (seq :bd :sd)] [1 (pure :cp)])"]
  :see-also ["randcat" "wchoose-cycles"]}

 :brand {:type "variable"
         :detail "brand — random boolean signal (true ~50%); (struct brand (pure :hh))"
         :signature "brand"
         :doc "Random boolean signal: true when rand < 0.5. Usable with struct, mask, sew and when-pat."
         :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 brand)" "(struct (segment 8 brand) (pure :hh))"]
  :see-also ["brand-by" "rand"]}

 :brand-by {:type "function"
            :detail "(brand-by p) — random boolean signal, true with probability p; p may be a pattern"
            :signature "(brand-by p)"
            :doc "Random boolean signal: true when rand < p. p may be a pattern."
            :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 (brand-by 0.25))" "(segment 1 (brand-by \"<0.2 0.6>\"))"]
  :see-also ["brand" "rand"]}

 :berlin {:type "variable"
          :detail "berlin — sawtooth-like random ridge signal 0..1; (segment 8 berlin)"
          :signature "berlin"
          :doc "Signal in [0,1): rand at the cycle start blended towards rand at the next cycle start, Strudel's berlin."
          :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 8 berlin)"]
  :see-also ["rand" "perlin"]}

 :rand-l {:type "function"
          :detail "(rand-l n) — signal of n random floats (vector); n may be a pattern"
          :signature "(rand-l n)"
          :doc "Signal whose value is a vector of n random floats; use fmap to pick from it."
          :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(fmap (fn [v] (first v)) (segment 4 (rand-l 3)))" "(segment 1 (rand-l \"<2 3>\"))"]
  :see-also ["rand" "randrun"]}

 :randrun {:type "function"
           :detail "(randrun n) — a random permutation of 0..n-1 each cycle; n may be a pattern"
           :signature "(randrun n)"
           :doc "n events per cycle: a random permutation of 0 to n-1 (each number once per cycle)."
           :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(randrun 4)" "(randrun \"<3 4>\")"]
  :see-also ["shuffle" "irand" "run"]}

 :with-seed {:type "function"
             :detail "(with-seed n pat) — shift every random read inside pat by n cycles; n may be a pattern"
             :signature "(with-seed n pat)"
             :doc "Every random function inside pat reads its random number at time t + n instead of t, giving a different but still deterministic variation. Innermost with-seed wins."
             :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(with-seed 7 (shuffle 4 (seq :a :b :c :d)))" "(with-seed \"<0 1>\" (segment 4 rand))"]
  :see-also ["rand" "shuffle" "degrade-by"]}

 :shuffle {:type "function"
           :detail "(shuffle n pat) — each cycle, the n slices of pat in random order; n may be a pattern"
           :signature "(shuffle n pat)"
           :doc "Cut each cycle into n slices and play every slice exactly once, in a random order."
           :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(shuffle 4 (seq :a :b :c :d))" "(shuffle \"<2 4>\" (seq :a :b :c :d))"]
  :see-also ["scramble" "randrun" "with-seed"]}

 :scramble {:type "function"
            :detail "(scramble n pat) — n slots each play a random slice of pat; n may be a pattern"
            :signature "(scramble n pat)"
            :doc "Like shuffle but with repetition: each of n slots plays a randomly chosen slice."
            :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(scramble 4 (seq :a :b :c :d))" "(scramble \"<2 4>\" (seq :a :b :c :d))"]
  :see-also ["shuffle" "irand"]}

 :when-pat {:type "function"
            :detail "(when-pat on f pat) — apply f where boolean pattern on is true; or on = fn of the cycle number"
            :signature "(when-pat on f pat)"
            :doc "Where the boolean pattern on is true the events come from (f pat), elsewhere from pat. on may also be a Lisp function called with the cycle number: (when-pat (fn [c] (> c 3)) rev pat)."
            :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(when-pat \"<0 1>\" rev (seq :a :b))" "(when-pat (fn [c] (> c 3)) rev (seq :a :b))"]
  :see-also ["whenmod" "sew" "every"]}

 :whenmod {:type "function"
           :detail "(whenmod a b f pat) — apply f in cycles where (cycle mod a) >= b; a, b may be patterns"
           :signature "(whenmod a b f pat)"
           :doc "In cycle c apply f when c mod a >= b: (whenmod 8 6 rev pat) reverses cycles 6 and 7 of every 8. a and b may be patterns."
           :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(whenmod 8 6 rev (seq 0 2 4 7))" "(whenmod \"<4 2>\" 1 rev (seq :a :b))"]
  :see-also ["every" "when-pat"]}

 :apply-n {:type "function"
           :detail "(apply-n n f pat) — apply f n times; n may be a pattern"
           :signature "(apply-n n f pat)"
           :doc "Apply the transform f n times in a row."
           :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(apply-n 2 (fast 2) (seq :a :b))" "(apply-n \"<1 2>\" (fast 2) (seq :a :b))"]
  :see-also ["every" "fast"]}

 :pick {:type "function"
        :detail "(pick lookup ipat) — choose a pattern from a vector (by index, clamped) or map (by name); inner join"
        :signature "(pick lookup ipat)"
        :doc "Choose a pattern out of a vector (indexed by number, clamped to its range) or a map (looked up by name) under the control of an index pattern. The chosen pattern keeps its own structure (inner join). Strings in the lookup are mini-notation; an unknown name is silent. Plain values give one onset per cycle (the index step only supplies a fragment) — use pick-out or inhabit for one value per step."
        :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(pick {:a (seq :bd :sd) :b (seq :hh :hh :hh)} \"<a b>\")" "(pick [\"bd sd\" \"hh*3\"] \"<0 1>\")"]
  :see-also ["pick-mod" "pick-out" "inhabit" "choose-in-with"]}

 :pick-mod {:type "function"
            :detail "(pick-mod lookup ipat) — like pick, but a vector index wraps around (floored mod)"
            :signature "(pick-mod lookup ipat)"
            :doc "Like pick, but a vector index wraps around instead of clamping (2 on a two-element vector selects element 0, -1 the last). Map lookups behave exactly like pick."
            :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(pick-mod [(seq :bd :sd) (seq :hh :hh)] \"0 1 2\")"]
  :see-also ["pick" "pick-mod-out" "inhabit-mod"]}

 :pick-f {:type "function"
          :detail "(pick-f ipat fs pat) — apply the function chosen by ipat (vector or map of functions) to pat"
          :signature "(pick-f ipat fs pat)"
          :doc "Choose a function from a vector or map under the control of an index pattern and apply it to pat. The vector index is clamped; use pick-mod-f to wrap. Every entry must be a function."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(pick-f \"<0 1>\" [(fast 2) rev] (seq :a :b))" "(pick-f \"<fast rev>\" {:fast (fast 2) :rev rev} (seq :a :b))"]
  :see-also ["pick-mod-f" "pick" "every"]}

 :pick-mod-f {:type "function"
              :detail "(pick-mod-f ipat fs pat) — like pick-f, but the vector index wraps around"
              :signature "(pick-mod-f ipat fs pat)"
              :doc "Like pick-f, but a vector index wraps around instead of clamping."
              :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(pick-mod-f \"<2 -1>\" [(fast 2) rev] (seq :a :b))"]
  :see-also ["pick-f" "pick-mod"]}

 :pick-out {:type "function"
            :detail "(pick-out lookup ipat) — like pick, but the structure comes from the index pattern (outer join)"
            :signature "(pick-out lookup ipat)"
            :doc "Like pick, but structure comes from the index pattern: each index step plays the chosen pattern's value at the step start (outer join). This is the one to use for one value per step."
            :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(pick-out [:bd :sd :hh] \"0 1 2 1\")"]
  :see-also ["pick" "pick-mod-out" "inhabit"]}

 :pick-mod-out {:type "function"
                :detail "(pick-mod-out lookup ipat) — like pick-out, but a vector index wraps around"
                :signature "(pick-mod-out lookup ipat)"
                :doc "Like pick-out, but a vector index wraps around instead of clamping."
                :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(pick-mod-out [:bd :sd] \"0 1 2 3\")"]
  :see-also ["pick-out" "pick-mod"]}

 :pick-restart {:type "function"
                :detail "(pick-restart lookup ipat) — the chosen pattern restarts from its cycle 0 at every index step"
                :signature "(pick-restart lookup ipat)"
                :doc "Like pick, but at every index step the chosen pattern starts again from its cycle 0 (restart join)."
                :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(pick-restart [(slow 2 (seq :a :b :c :d)) :x] \"1 0\")"]
  :see-also ["pick-reset" "pick-mod-restart" "pick"]}

 :pick-mod-restart {:type "function"
                    :detail "(pick-mod-restart lookup ipat) — like pick-restart, but a vector index wraps around"
                    :signature "(pick-mod-restart lookup ipat)"
                    :doc "Like pick-restart, but a vector index wraps around instead of clamping."
                    :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(pick-mod-restart [(slow 2 (seq :a :b :c :d)) :x] \"3 2\")"]
  :see-also ["pick-restart" "pick-mod"]}

 :pick-reset {:type "function"
              :detail "(pick-reset lookup ipat) — the chosen pattern's current cycle restarts at every index step"
              :signature "(pick-reset lookup ipat)"
              :doc "Like pick, but at every index step the current cycle of the chosen pattern starts again (reset join)."
              :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(pick-reset [(slow 2 (seq :a :b :c :d)) :x] \"1 0\")"]
  :see-also ["pick-restart" "pick-mod-reset" "pick"]}

 :pick-mod-reset {:type "function"
                  :detail "(pick-mod-reset lookup ipat) — like pick-reset, but a vector index wraps around"
                  :signature "(pick-mod-reset lookup ipat)"
                  :doc "Like pick-reset, but a vector index wraps around instead of clamping."
                  :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(pick-mod-reset [(slow 2 (seq :a :b :c :d)) :x] \"3 2\")"]
  :see-also ["pick-reset" "pick-mod"]}

 :inhabit {:type "function"
           :detail "(inhabit lookup ipat) — squeeze one cycle of the chosen pattern into each index step"
           :signature "(inhabit lookup ipat)"
           :doc "Squeeze one cycle of the chosen pattern into each step of the index pattern (squeeze join). Vector index clamped; map by name."
           :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(inhabit {:a (seq :bd :sd) :b :hh} \"a b\")"]
  :see-also ["inhabit-mod" "pick-out" "choose-in-with"]}

 :inhabit-mod {:type "function"
               :detail "(inhabit-mod lookup ipat) — like inhabit, but a vector index wraps around"
               :signature "(inhabit-mod lookup ipat)"
               :doc "Like inhabit, but a vector index wraps around instead of clamping."
               :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(inhabit-mod [(seq :bd :sd) :hh] \"0 1 2\")"]
  :see-also ["inhabit" "pick-mod"]}

 :fix {:type "function"
       :detail "(fix f cond pat) — apply f only to events whose controls match the condition map"
       :signature "(fix f cond pat)"
       :doc "Tidal fix: apply f only to the events matching the condition map; the rest are kept. All keys must match (AND); a vector value means any-of; numbers compare numerically, keywords and strings exactly; a missing key is no match. :s is derived from :bank or a non-note :note, so {:s :bd} matches :bd and (sound :bd 2)."
       :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(fix (fast 2) {:s :bd} (seq :hh :bd))" "(fix (amp 0.3) {:s [:sd :hh]} (seq :bd :hh :sd :hh))"]
  :see-also ["when-pat" "sometimes-by" "amp"]}

 :jux        {:type "function"
              :detail "(jux f pat) — original panned left + (f pat) panned right"
              :signature "(jux f pat)"
              :doc "Juxtapose: play pat panned left, and (f pat) panned right, simultaneously."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(jux (fast 2) (seq :bd :sd :hh :oh))"
                         "(jux rev (scale :minor :c4 (seq 0 2 4 7)))"]
              :see-also ["jux-by" "pan" "off"]}

 :jux-by     {:type "function"
              :detail "(jux-by width f pat) — like jux with adjustable stereo width 0.0–1.0; width may be a pattern"
              :signature "(jux-by width f pat)"
              :doc "Like jux with adjustable stereo width (0.0 = mono, 1.0 = hard pan). width may be a pattern."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(jux-by 0.5 rev (seq :bd :sd))"
                         "(jux-by 0.8 (fast 2) (seq :hh :oh))"
                         "(jux-by \"<0.3 1>\" rev (seq :bd :sd))"]
              :see-also ["jux" "pan"]}

 :off        {:type "function"
              :detail "(off amount f pat) — layer original with time-shifted transformed copy; amount may be a pattern"
              :signature "(off amount f pat)"
              :doc "Layer the original with a time-shifted transformed copy: (stack pat (late amount (f pat)))."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(off 0.25 (fast 2) (seq :bd :sd))"
                         "(off 0.125 rev (seq :hh :oh))"
                         "(off \"<1/8 1/4>\" (fast 2) (seq :bd :sd))"]
              :see-also ["late" "jux"]}

 ;; ── Pattern arithmetic (TL1) ─────────────────────────────────────────────
 :add        {:type "function"
              :detail "(add [mode] amt pat) — add amt (number, pattern or mini-notation) to values; mode :in (default) :out :mix :squeeze"
              :signature "(add [mode] amt pat)"
              :doc "Add amt to every value. amt may be a number, a pattern or a mini-notation string. Note keywords move by semitones; maps change :note; rests pass through. mode picks where the rhythm comes from: :in (default, from pat), :out (from amt), :mix (both), :squeeze."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(add 12 (seq :c3 :e3 :g3))"
                         "(->> (seq 1 3 5 8) (add \"<0 2 4>\") (scale :minor :c3))"
                         "(add :out (seq 10 20) (seq 1 2 3))"]
              :see-also ["sub" "mul" "div" "set" "transpose"]}

 :sub        {:type "function"
              :detail "(sub [mode] amt pat) — subtract amt from values; mode :in :out :mix :squeeze (sub-oscillator: sub-osc)"
              :signature "(sub [mode] amt pat)"
              :doc "Subtract amt from every value. Same modes and argument types as add."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(sub 12 (seq :c4 :e4 :g4))"
                         "(->> (seq 8 7 5) (sub \"<0 1>\") (scale :major :c4))"]
              :see-also ["add" "mul" "div" "sub-osc"]}

 :mul        {:type "function"
              :detail "(mul [mode] amt pat) — multiply values by amt; mode :in :out :mix :squeeze"
              :signature "(mul [mode] amt pat)"
              :doc "Multiply every value by amt. Same modes and argument types as add."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(mul 2 (seq 220 330))"
                         "(mul :mix (seq 1 2) (seq 110 220 330))"]
              :see-also ["add" "div"]}

 :div        {:type "function"
              :detail "(div [mode] amt pat) — divide values by amt; mode :in :out :mix :squeeze"
              :signature "(div [mode] amt pat)"
              :doc "Divide every value by amt (division by zero leaves the value unchanged). Same modes as add."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(div 2 (seq 440 660))"
                         "(div \"<1 2>\" (seq 440 880))"]
              :see-also ["mul" "sub"]}

 :set        {:type "function"
              :detail "(set [mode] ctrl pat) — merge control maps into events, ctrl wins (Tidal #)"
              :signature "(set [mode] ctrl pat)"
              :doc "Merge control maps into every event; ctrl values win (Tidal #). ctrl may be a map or a pattern of maps."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(set {:amp 0.5 :pan -0.5} (seq :c4 :e4))"
                         "(set (seq {:amp 1.0} {:amp 0.4}) (seq :bd :hh :sd :hh))"]
              :see-also ["amp" "pan" "add"]}

 :comp       {:type "function"
              :detail "(comp f g …) — compose transformers right-to-left, e.g. (def pluck (comp (amp 0.8) (decay 0.15)))"
              :signature "(comp f g ...)"
              :doc "Compose transformers right-to-left. Useful for building named presets."
              :category "transform"
              :returns "fn"
              :side-effects []
              :examples ["(def pluck (comp (amp 0.8) (attack 0.003) (decay 0.15)))"
                         "(def bright (comp (amp 1.0) (release 0.05)))"]
              :see-also ["->>" "amp" "decay"]}

 :slider     {:type "function"
              :detail "(slider value min max [:log|:lin]) — a number drawn as a draggable slider in the editor; ⌘K S wraps/unwraps"
              :signature "(slider value min max) or (slider value min max :log)"
              :doc "Evaluates to value, clamped to [min, max] (a warning names the clamp). In the editor the form is drawn as a draggable bar: drag to change the number in the code (⇧ = 10× finer), move the cursor onto it to edit the text, ⌘K S / Ctrl-K S to unwrap. Log scale when min > 0 and max/min ≥ 100, or with :log; :lin forces linear."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(->> (seq :e1 :g1) (synth :saw) (amp (slider 0.7 0 1)))"
                         "(fx :filter :freq (slider 800 20 20000))"]
              :see-also ["amp" "tween" "range"]}

 :tween      {:type "function"
              :detail "(tween curve start end bars) — smooth parameter transition over bars; curve: :linear :exp :sine"
              :signature "(tween curve start end bars)"
              :doc "Interpolate a parameter from start to end over the given duration in bars. The audio engine handles per-sample interpolation — a single message is sent; no polling occurs. After the transition completes, the end value is held. Re-evaluating code restarts the transition.\n\ncurve: :linear — constant rate of change\n       :exp    — slow start, fast end (good for volume fades)\n       :sine   — S-curve: slow at both ends, fast in the middle"
              :category "transform"
              :returns "number"
              :side-effects ["audio"]
              :examples ["(->> (seq :c4 :e4 :g4) (synth :saw) (amp (tween :linear 0.0 1.0 2)))"
                         "(->> (seq :bd) (amp (tween :exp 1.0 0.0 4)))"]
              :see-also ["amp" "->>"]}

 ;; ── Per-event parameters ────────────────────────────────────────────────────
 :->>        {:type "keyword"
              :detail "(->> pat (amp 0.8) (attack 0.02)) — thread pattern through transformers (last arg)"
              :signature "(->> pat (f args) ...)"
              :doc "Thread-last: pass the pattern as the last argument of each successive form. The natural way to chain parameter transforms."
              :category "special"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :c4 :e4) (amp 0.7) (decay 0.5))"
                         "(->> (seq :bd :sd) (fx :reverb 0.4))"]
              :see-also ["->" "amp" "fx" "comp"]}

 :->         {:type "keyword"
              :detail "(-> val (f a) (g b)) — thread-first: val as first arg to each step"
              :signature "(-> val (f a) (g b))"
              :doc "Thread-first: passes val as the first argument to each step in turn."
              :category "special"
              :returns "any"
              :side-effects []
              :examples ["(-> x (f a) (g b))"
                         "(-> (seq :c4 :e4) (fast 2))"]
              :see-also ["->>"]}

 :amp        {:type "function"
              :detail "(amp val pat) — amplitude 0.0–1.0; (amp val) returns transformer"
              :signature "(amp val pat) or (amp val)"
              :doc "Set event amplitude (0.0 = silent, 1.0 = full). One-arg form returns a transformer for use with ->> or comp."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(amp 0.8 (seq :c4 :e4 :g4))"
                         "(->> (seq :bd) (amp 0.6))"]
              :see-also ["attack" "decay" "release" "pan" "->>"]}

 :attack     {:type "function"
              :detail "(attack secs pat) — envelope attack time in seconds; (attack secs) returns transformer"
              :signature "(attack secs pat) or (attack secs)"
              :doc "Set envelope attack time in seconds. 0.001 = percussive, 0.3 = slow swell."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(attack 0.1 (pure :c4))"
                         "(->> (seq :c4 :e4) (attack 0.02))"]
              :see-also ["decay" "release" "amp"]}

 :decay      {:type "function"
              :detail "(decay secs pat) — envelope decay time in seconds; (decay secs) returns transformer"
              :signature "(decay secs pat) or (decay secs)"
              :doc "Set envelope decay time in seconds. 0.08 = short stab, 2.0 = long tone."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(decay 0.5 (seq :c4 :e4))"
                         "(->> (seq :bd) (decay 0.08))"
                         "(->> (seq :bd :bd) (tune -5) (decay 0.8))"]
              :see-also ["attack" "release" "amp" "tune" "tone"]}

 :release    {:type "function"
              :detail "(release secs pat) — envelope release time in seconds; (release secs) returns transformer"
              :signature "(release secs pat) or (release secs)"
              :doc "Set envelope release time in seconds. Defaults to decay value when omitted."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(release 0.3 (seq :c4 :e4))"
                         "(->> (seq :pad) (release 2.0))"]
              :see-also ["attack" "decay" "amp"]}

 :pan        {:type "function"
              :detail "(pan pos pat) — stereo pan -1.0 (left) to 1.0 (right); (pan pos) returns transformer"
              :signature "(pan pos pat) or (pan pos)"
              :doc "Set stereo panning. -1.0 = hard left, 0.0 = centre, 1.0 = hard right."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(pan -0.5 (seq :c4 :e4))"
                         "(->> (seq :hh) (pan 0.7))"]
              :see-also ["jux" "amp"]}

 ;; ── Music theory ────────────────────────────────────────────────────────────
 :scale      {:type "function"
              :detail "(scale name root pat) — map 0-based degrees (0 = root) to note names; name may be a keyword, semitone vector or pattern (e.g. (scale :minor :c4 (seq 0 2 4 7)))"
              :signature "(scale name root pat)"
              :doc "Map 0-based scale degrees (0 = root, negatives go below) to note names. name is a scale keyword (:minor, :dorian, :harmonic-minor, ...), a vector of semitone offsets, or a pattern of names; root is a note or pattern. Degrees beyond the scale wrap into octaves. Note names are MIDI-note values: (add 12 ...) is one octave."
              :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(scale :minor :c4 (seq 0 2 4 7))" "(scale :major :g3 (seq 0 2 4 7))" "(scale \"<major minor>\" :c4 (seq 0 2 4))" "(scale [0 2 4 5 7 9 11] :c4 (seq 0 1 2))" "(add 12 (scale :minor :c3 (seq 0)))"]
  :see-also ["chord" "transpose" "scale-transpose" "seq"]}

 :chord {:type "function"
         :detail "(chord kw root) or (chord \"Cm7\") — stack chord tones as note names; accepts chord-symbol strings (e.g. (chord :major7 :c4), (chord \"<C F>\"))"
         :signature "(chord chord-kw root) or (chord symbol)"
         :doc "Stack the tones of a chord as simultaneous note names. Takes a chord keyword and root, or chord-symbol strings/patterns like \"Cm7\", \"F#7b9\", \"C^7\", \"C/E\" (root in octave 4)."
         :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(chord :minor7 :a3)" "(chord :major :c4)" "(chord \"Cm7\")" "(chord \"<C F>\")"]
  :see-also ["scale" "transpose" "voicing" "stack"]}

 :transpose {:type "function"
             :detail "(transpose n pat) — shift notes by n semitones or an interval string (\"3M\" \"-2M\" \"5P\"); note names stay note names; n may be a pattern"
             :signature "(transpose n pat)"
             :doc "Shift values by n semitones (n may be a pattern or an interval string like \"3M\", \"-2M\", \"5P\"). Note names stay note names; plain numbers (Hz) scale by 2^(n/12); maps shift :note. Drums and rests are unchanged."
             :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(transpose 7 (scale :major :c4 (seq 0 1 2 3)))" "(transpose -12 (chord :minor :e4))" "(transpose \"3M\" (seq :c4))" "(transpose \"<0 7>\" (seq :c4 :e4))"]
  :see-also ["scale" "chord" "scale-transpose"]}

 :scale-transpose {:type "function"
                   :detail "(scale-transpose n scale pat) — move degrees or notes n steps inside a scale"
                   :signature "(scale-transpose n scale pat)"
                   :doc "Move degrees (numbers) or notes n steps inside a scale. scale is a keyword, [scale root] or a semitone vector. n may be a pattern."
                   :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(scale-transpose 2 :minor (seq 0 2 4))" "(scale-transpose \"<0 2>\" :minor (seq 0 2 4))" "(scale-transpose 1 [:dorian :d] (seq :d4 :e4))"]
  :see-also ["scale" "transpose"]}

 :voicing {:type "function"
           :detail "(voicing [opts] pat) — voice chord symbols with smooth voice leading; opts {:anchor :c5 :mode :below :offset 0}"
           :signature "(voicing [opts] pat)"
           :doc "Voice chord symbols as 3-4 note chords with smooth voice leading. opts: {:anchor :c5 :mode :below :offset 0}; modes :below :above :duck :root."
           :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(voicing (seq \"C^7\" \"A7b13\" \"Dm7\" \"G7\"))" "(voicing \"<C^7 A7b13 Dm7 G7>\")" "(voicing {:mode :above :anchor :c4} \"C\")"]
  :see-also ["chord" "arp" "root-notes"]}

 :root-notes {:type "function"
              :detail "(root-notes [octave] pat) — chord symbol to its root note (default octave 2)"
              :signature "(root-notes [octave] pat)"
              :doc "Chord symbol to its root note in the given octave (default 2)."
              :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(root-notes \"<Cm7 F7>\")" "(root-notes 3 (seq \"Bb7\" \"Eb^7\"))"]
  :see-also ["chord" "voicing"]}

 :arp {:type "function"
       :detail "(arp mode pat) — arpeggiate simultaneous notes; mode :up :down :up-down … or an index list \"0 2 1 3\""
       :signature "(arp mode pat)"
       :doc "Arpeggiate each group of simultaneous notes. mode is a Tidal mode (:up :down :up-down :down-up :up-and-down :down-and-up :converge :diverge :disconverge :pinky-up :thumb-up ...) or a pattern of modes; a number list like \"0 2 1 3\" picks the i-th note of the chord (Strudel style)."
       :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(arp :up (chord \"Cm7\"))" "(arp :up-down (chord \"Cm7\"))" "(arp \"0 2 1 3\" (chord \"Cm7\"))" "(arp \"<up down>\" (chord \"C\"))"]
  :see-also ["arp-with" "chord" "voicing" "rolled"]}

 :arp-with {:type "function"
            :detail "(arp-with f pat) — f gets the vector of simultaneous values and returns a pattern"
            :signature "(arp-with f pat)"
            :doc "f receives the vector of simultaneous values and returns a pattern, which is played in the chord's time slot."
            :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(arp-with (fn [ns] (seq (first ns) (nth ns 1))) (chord \"Cm7\"))"]
  :see-also ["arp" "chord"]}

 :rolled {:type "function"
          :detail "(rolled pat) — strum simultaneous notes over 1/4 of their length"
          :signature "(rolled pat)"
          :doc "Strum simultaneous notes: staggers their starts over a quarter of the event length; the notes keep their ends."
          :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(rolled (chord \"C\"))"]
  :see-also ["rolled-by" "arp" "chord"]}

 :rolled-by {:type "function"
             :detail "(rolled-by t pat) — strum simultaneous notes over t of their length; negative t rolls downwards"
             :signature "(rolled-by t pat)"
             :doc "Strum simultaneous notes over t of the event length. Negative t strums from the top down; 0 leaves them unchanged."
             :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(rolled-by 1/2 (chord \"Cm7\"))" "(rolled-by -1/4 (chord \"C\"))"]
  :see-also ["rolled" "arp"]}

;; ── Layering (TL5) ─────────────────────────────────────────────────────────
 :superimpose {:type "function"
               :detail "(superimpose f ... pat) — stack pat with (f pat) for each f"
               :signature "(superimpose f ... pat)"
               :doc "Stack pat with (f pat) for every function f."
               :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(superimpose (fast 2) (seq :a :b))" "(superimpose (comp (fast 2) (add 12)) (seq :c3 :e3 :g3))"]
  :see-also ["layer" "off" "stack"]}

 :layer {:type "function"
         :detail "(layer f ... pat) — stack (f pat) for each f, without the original"
         :signature "(layer f ... pat)"
         :doc "Stack (f pat) for every function f, without the original pattern."
         :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(layer rev (fast 2) (seq :a :b))"]
  :see-also ["superimpose" "stack"]}

 :echo {:type "function"
        :detail "(echo times time feedback pat) — repeats, `time` apart, amp × feedback^i; args may be patterns"
        :signature "(echo times time feedback pat)"
        :doc "Layer `times` copies of pat, each `time` cycles later, each quieter by feedback (amp multiplied by feedback^i). All three numbers may be patterns."
        :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(echo 3 1/8 0.6 (seq :cp))" "(echo \"<1 2>\" 1/4 0.5 (seq :cp))"]
  :see-also ["stut" "echo-with" "stutter" "off"]}

 :stut {:type "function"
        :detail "(stut times feedback time pat) — echo with Tidal argument order"
        :signature "(stut times feedback time pat)"
        :doc "Alias of echo with the Tidal argument order."
        :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(stut 3 0.5 1/8 (seq :cp))"]
  :see-also ["echo" "echo-with"]}

 :echo-with {:type "function"
             :detail "(echo-with n t f pat) — pat plus n-1 copies, each (f ∘ late t) deeper (Tidal stutWith)"
             :signature "(echo-with n t f pat)"
             :doc "Tidal stutWith: pat plus n-1 copies, copy i has (f . late t) applied i times."
             :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(echo-with 3 1/8 (add 12) (seq :c3))"]
  :see-also ["echo" "stutter" "superimpose"]}

 :stutter {:type "function"
           :detail "(stutter n t pat) — n copies of pat, t apart, unchanged"
           :signature "(stutter n t pat)"
           :doc "n copies of pat, t cycles apart, unchanged."
           :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(stutter 4 1/16 (seq :bd))"]
  :see-also ["echo-with" "echo"]}

 :jux-flip {:type "function"
            :detail "(jux-flip f pat) — jux whose original/transformed sides swap every cycle"
            :signature "(jux-flip f pat)"
            :doc "Like jux, but the original and transformed sides swap left/right every cycle."
            :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(jux-flip rev (seq :a :b))"]
  :see-also ["jux" "jux-flip-by"]}

 :jux-flip-by {:type "function"
               :detail "(jux-flip-by w f pat) — jux-by whose sides swap every cycle; w may be a pattern"
               :signature "(jux-flip-by width f pat)"
               :doc "Like jux-by, but the sides swap every cycle. width may be a pattern."
               :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(jux-flip-by 0.5 rev (seq :a :b))"]
  :see-also ["jux-by" "jux-flip"]}

 :xfade {:type "function"
         :detail "(xfade a pos b) — crossfade two patterns; pos 0 = a, 1 = b; pos may be a pattern"
         :signature "(xfade a pos b)"
         :doc "Crossfade two patterns by scaling their amp: pos 0 = only a, pos 1 = only b. pos may be a pattern."
         :category "transform"
  :returns "Pattern"
  :side-effects []
  :examples ["(xfade (seq :bd :bd) 0.25 (seq :hh))" "(xfade (seq :bd) \"<0 0.5 1>\" (seq :hh))"]
  :see-also ["amp" "stack"]}

 ;; ── Sample playback ─────────────────────────────────────────────────────────
 :rate       {:type "function"
              :detail "(rate n pat) — playback rate: 1.0 = normal, 2.0 = octave up; (rate n) returns transformer"
              :signature "(rate n pat)"
              :doc "Sets the sample playback rate: 1.0 is normal speed, 2.0 is an octave up. With one argument, (rate n) returns a transformer for use inside ->>."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :bd) (rate 2.0))"
                         "(->> (seq :hh) (rate 0.5))"]
              :see-also ["speed" "begin" "end" "loop-sample"]}

 :begin      {:type "function"
              :detail "(begin frac pat) — sample start offset 0.0–1.0; (begin frac) returns transformer"
              :signature "(begin frac pat)"
              :doc "Sets the sample start offset as a fraction of the sample, 0.0 to 1.0. With one argument, returns a transformer."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :bd) (begin 0.2))"
                         "(->> (seq :bd) (begin 0.5) (end 0.8))"]
              :see-also ["end" "rate"]}

 :end        {:type "function"
              :detail "(end frac pat) — sample end offset 0.0–1.0; (end frac) returns transformer"
              :signature "(end frac pat)"
              :doc "Sets the sample end offset as a fraction of the sample, 0.0 to 1.0. With one argument, returns a transformer."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :bd) (end 0.7))"
                         "(->> (seq :hh) (begin 0.1) (end 0.9))"]
              :see-also ["begin" "rate"]}

 :loop-sample {:type "function"
               :detail "(loop-sample true pat) — loop sample playback; (loop-sample bool) returns transformer"
               :signature "(loop-sample true pat)"
               :doc "Loops sample playback when true. With one argument, (loop-sample bool) returns a transformer."
               :category "transform"
               :returns "Pattern"
               :side-effects []
               :examples ["(->> (seq :bd) (loop-sample true))"
                          "(->> (pure :bd) (loop-sample true) (decay 2.0))"]
               :see-also ["rate" "begin" "end"]}

 ;; ── Sample slicing (TL6) ────────────────────────────────────────────────────
 :chop {:type "function"
        :detail "(chop n pat) — cut each event into n parts playing consecutive pieces of its sample"
        :signature "(chop n pat)"
        :doc "Cuts each event into n parts that play consecutive pieces of its sample. n may be a pattern or mini-notation."
        :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(chop 8 (sound :breaks152 0))"
                         "(->> (sound :breaks152 0) (chop \"<4 8>\"))"]
              :see-also ["striate" "slice" "loop-at"]}

 :striate {:type "function"
           :detail "(striate n pat) — play pat n times per cycle; repetition i plays piece i of each sample"
           :signature "(striate n pat)"
           :doc "Plays the pattern n times per cycle; repetition i plays piece i of each sample."
           :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(striate 4 (sound :breaks152 0))"]
              :see-also ["chop" "slice"]}

 :slice {:type "function"
         :detail "(slice n ipat pat) — cut the sample into n slices, play the slices chosen by ipat"
         :signature "(slice n ipat pat)"
         :doc "Cuts the sample into n slices and plays the slices chosen by the index pattern ipat. Also available as (slice n ipat) for use inside ->>."
         :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(slice 8 (seq 0 3 2 7) (sound :breaks152 0))"
                         "(->> (sound :breaks152 0) (slice 4 \"0 2\"))"]
              :see-also ["splice" "chop" "begin"]}

 :splice {:type "function"
          :detail "(splice n ipat pat) — slice, with speed fitted so each slice fills its slot"
          :signature "(splice n ipat pat)"
          :doc "Like slice, with the playback speed fitted so each slice fills its slot. Also available as (splice n ipat) for use inside ->>."
          :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(splice 8 (seq 0 1 6 7) (sound :breaks152 0))"]
              :see-also ["slice" "fit" "unit"]}

 :fit {:type "function"
       :detail "(fit pat) — set each event's speed so its sample (begin–end) fills the event"
       :signature "(fit pat)"
       :doc "Sets each event's speed so its sample, between begin and end, fills the event."
       :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(fit (seq (sound :breaks152 0) :_))"]
              :see-also ["loop-at" "splice" "unit"]}

 :loop-at {:type "function"
           :detail "(loop-at n pat) — slow pat by n and fit its samples to n cycles"
           :signature "(loop-at n pat)"
           :doc "Slows the pattern by n and fits its samples to n cycles."
           :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(loop-at 2 (chop 16 (sound :breaks152 0)))"]
              :see-also ["fit" "chop" "unit"]}

 :speed {:type "function"
         :detail "(speed n pat) — playback rate (alias of rate); negative plays backwards"
         :signature "(speed n pat)"
         :doc "Playback rate, an alias of rate. A negative value plays the sample backwards."
         :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (sound :breaks152 0) (speed -1))"
                         "(->> (seq :bd :sd) (speed \"1 2\"))"]
              :see-also ["rate" "unit" "accelerate"]}

 :unit {:type "function"
        :detail "(unit :c pat) — speed in cycles: speed 1 plays the whole sample in one cycle; :r = plain rate"
        :signature "(unit :c pat)"
        :doc "Sets the speed unit. :r (default) is a plain rate; :c measures speed in cycles, so speed 1 plays the whole sample in one cycle."
        :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (sound :breaks152 0) (speed 1) (unit :c))"]
              :see-also ["speed" "loop-at" "fit"]}

 :accelerate {:type "function"
              :detail "(accelerate n pat) — glide playback rate from rate to rate + n while the sample plays"
              :signature "(accelerate n pat)"
              :doc "Glides the playback rate from the rate to rate + n over the time the sample plays."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (sound :breaks152 0) (accelerate -0.5))"]
              :see-also ["speed" "rate"]}

 :legato {:type "function"
          :detail "(legato n pat) — sample length relative to the event: 1 = stop at event end"
          :signature "(legato n pat)"
          :doc "Sets the sample length relative to the event: 1 stops at the event end, 0.5 plays half of it."
          :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :bd :sd) (legato 0.5))"]
              :see-also ["sustain" "end"]}

 :sustain {:type "function"
           :detail "(sustain secs pat) — maximum sample length in seconds"
           :signature "(sustain secs pat)"
           :doc "Sets the maximum sample length in seconds."
           :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (sound :breaks152 0) (sustain 0.1))"]
              :see-also ["legato" "end"]}

 :cut {:type "function"
       :detail "(cut group pat) — choke group: a new sample stops the group's samples still playing"
       :signature "(cut group pat)"
       :doc "Sets a choke group: a new sample in the group stops the group's samples that are still playing."
       :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (fast 4 (seq :RolandTR909_oh :RolandTR909_hh)) (cut 1))"]
              :see-also ["legato" "sustain"]}

 :loop-begin {:type "function"
              :detail "(loop-begin frac pat) — loop region start 0.0–1.0 (with loop-sample)"
              :signature "(loop-begin frac pat)"
              :doc "Sets the start of the loop region, 0.0 to 1.0. Used together with loop-sample."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (sound :pad 0) (loop-sample true) (loop-begin 0.25) (loop-end 0.5))"]
              :see-also ["loop-end" "loop-sample"]}

 :loop-end {:type "function"
            :detail "(loop-end frac pat) — loop region end 0.0–1.0 (with loop-sample)"
            :signature "(loop-end frac pat)"
            :doc "Sets the end of the loop region, 0.0 to 1.0. Used together with loop-sample."
            :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (sound :pad 0) (loop-sample true) (loop-end 0.5))"]
              :see-also ["loop-begin" "loop-sample"]}

 ;; ── Synth voices ────────────────────────────────────────────────────────────
 :synth      {:type "function"
              :detail "(->> (seq :c4 :eb4) (synth :saw)) — apply voice to note pattern; opts: :pw :index :ratio"
              :signature "(synth voice pat)"
              :doc "Applies a voice to a pattern of notes, as in (->> (seq :c4 :eb4) (synth :saw)). Options after the voice, such as :pw, :index or :ratio, are merged into every event. Without a pattern it returns a transformer."
              :category "transform"
              :returns "Pattern"
              :side-effects []
              :examples ["(->> (seq :c4 :eb4) (synth :saw))"
                         "(->> (scale :minor :c3 (seq 0 2 4)) (synth :fm :index 3))"
                         "(->> (scale :minor :c3 (seq 0 3 5 7)) (synth :western))"
                         "(->> (seq :c4 :_ :c4 :_) (synth :noise :color :pink) (decay 0.3))"
                         "(->> (chord :minor :a3) (synth :supersaw))"]
              :see-also ["noise" "fm" "supersaw" "unison" "acid" "pad" "western" "nylon" "harp" "koto" "pizz" "lute" "mandolin" "defsynth"]}

;; ── Continuous signals (TL2) ────────────────────────────────────────────────
 :signal {:type "function"
          :detail "(signal f) — continuous pattern from f : cycle-time → value"
          :signature "(signal f)"
          :doc "Build a continuous pattern from a function of absolute cycle time (a number, e.g. 0.25 for a quarter into cycle 0). Sampled at the start of each structure event."
          :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 (signal (fn [t] (* t 2))))"]
  :see-also ["steady" "time" "segment"]}

 :steady {:type "function"
          :detail "(steady v) — constant continuous pattern"
          :signature "(steady v)"
          :doc "A continuous pattern that always has the value v."
          :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 (steady 3))"]
  :see-also ["signal" "segment"]}

 :time {:type "variable"
        :detail "time — signal: absolute cycle time; (segment 4 time)"
        :signature "time"
        :doc "Continuous signal whose value is the absolute cycle time: 0, 0.25, 0.5, 0.75 in cycle 0 and 1, 1.25, ... in cycle 1."
        :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 time)"]
  :see-also ["signal" "saw"]}

 :sine {:type "variable"
        :detail "sine — sine wave 0..1, 0.5 at t=0; (segment 4 sine). Voice: (synth :sine pat)"
        :signature "sine"
        :doc "Continuous signal: sine wave 0..1, 0.5 at t=0. Values at t = 0, 1/4, 1/2, 3/4: 0.5 1 0.5 0. Has no rhythm of its own: give it structure with (segment n sine) or use it as a parameter, e.g. (pan sine pat)."
        :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 8 (range 200 2000 sine))"]
  :see-also ["cosine" "sine2" "saw" "range"]}

 :cosine {:type "variable"
          :detail "cosine — cosine wave 0..1 (0 at t=0, Tidal phase); (segment 4 cosine)"
          :signature "cosine"
          :doc "Continuous signal: cosine wave 0..1 (0 at t=0, Tidal phase). Values at t = 0, 1/4, 1/2, 3/4: 0 0.5 1 0.5. Has no rhythm of its own: give it structure with (segment n cosine) or use it as a parameter, e.g. (pan cosine pat)."
          :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 8 cosine)"]
  :see-also ["sine" "cosine2"]}

 :isaw {:type "variable"
        :detail "isaw — inverted saw, 1→0 each cycle; (segment 4 isaw)"
        :signature "isaw"
        :doc "Continuous signal: inverted saw, 1→0 each cycle. Values at t = 0, 1/4, 1/2, 3/4: 1 0.75 0.5 0.25. Has no rhythm of its own: give it structure with (segment n isaw) or use it as a parameter, e.g. (pan isaw pat)."
        :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 isaw)"]
  :see-also ["saw" "isaw2"]}

 :itri {:type "variable"
        :detail "itri — inverted triangle wave; (segment 4 itri)"
        :signature "itri"
        :doc "Continuous signal: inverted triangle wave. Values at t = 0, 1/4, 1/2, 3/4: 1 0.5 0 0.5. Has no rhythm of its own: give it structure with (segment n itri) or use it as a parameter, e.g. (pan itri pat)."
        :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 itri)"]
  :see-also ["tri" "itri2"]}

 :isquare {:type "variable"
           :detail "isquare — inverted square wave, 1 then 0; (segment 4 isquare)"
           :signature "isquare"
           :doc "Continuous signal: inverted square wave, 1 then 0. Values at t = 0, 1/4, 1/2, 3/4: 1 1 0 0. Has no rhythm of its own: give it structure with (segment n isquare) or use it as a parameter, e.g. (pan isquare pat)."
           :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 isquare)"]
  :see-also ["square" "isquare2"]}

 :sine2 {:type "variable"
         :detail "sine2 — bipolar sine, -1..1; (pan sine2 pat)"
         :signature "sine2"
         :doc "Bipolar (-1..1) version of sine: (to-bipolar sine). Handy for pan and other signed parameters."
         :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(pan sine2 (fast 8 (seq :hh)))"]
  :see-also ["sine" "to-bipolar" "range2"]}

 :cosine2 {:type "variable"
           :detail "cosine2 — bipolar cosine, -1..1; (pan cosine2 pat)"
           :signature "cosine2"
           :doc "Bipolar (-1..1) version of cosine: (to-bipolar cosine). Handy for pan and other signed parameters."
           :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(pan cosine2 (fast 8 (seq :hh)))"]
  :see-also ["cosine" "to-bipolar" "range2"]}

 :saw2 {:type "variable"
        :detail "saw2 — bipolar saw, -1..1; (pan saw2 pat)"
        :signature "saw2"
        :doc "Bipolar (-1..1) version of saw: (to-bipolar saw). Handy for pan and other signed parameters."
        :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(pan saw2 (fast 8 (seq :hh)))"]
  :see-also ["saw" "to-bipolar" "range2"]}

 :isaw2 {:type "variable"
         :detail "isaw2 — bipolar isaw, -1..1; (pan isaw2 pat)"
         :signature "isaw2"
         :doc "Bipolar (-1..1) version of isaw: (to-bipolar isaw). Handy for pan and other signed parameters."
         :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(pan isaw2 (fast 8 (seq :hh)))"]
  :see-also ["isaw" "to-bipolar" "range2"]}

 :tri2 {:type "variable"
        :detail "tri2 — bipolar tri, -1..1; (pan tri2 pat)"
        :signature "tri2"
        :doc "Bipolar (-1..1) version of tri: (to-bipolar tri). Handy for pan and other signed parameters."
        :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(pan tri2 (fast 8 (seq :hh)))"]
  :see-also ["tri" "to-bipolar" "range2"]}

 :itri2 {:type "variable"
         :detail "itri2 — bipolar itri, -1..1; (pan itri2 pat)"
         :signature "itri2"
         :doc "Bipolar (-1..1) version of itri: (to-bipolar itri). Handy for pan and other signed parameters."
         :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(pan itri2 (fast 8 (seq :hh)))"]
  :see-also ["itri" "to-bipolar" "range2"]}

 :square2 {:type "variable"
           :detail "square2 — bipolar square, -1..1; (pan square2 pat)"
           :signature "square2"
           :doc "Bipolar (-1..1) version of square: (to-bipolar square). Handy for pan and other signed parameters."
           :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(pan square2 (fast 8 (seq :hh)))"]
  :see-also ["square" "to-bipolar" "range2"]}

 :isquare2 {:type "variable"
            :detail "isquare2 — bipolar isquare, -1..1; (pan isquare2 pat)"
            :signature "isquare2"
            :doc "Bipolar (-1..1) version of isquare: (to-bipolar isquare). Handy for pan and other signed parameters."
            :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(pan isquare2 (fast 8 (seq :hh)))"]
  :see-also ["isquare" "to-bipolar" "range2"]}

 :rand2 {:type "variable"
         :detail "rand2 — bipolar rand, -1..1; (pan rand2 pat)"
         :signature "rand2"
         :doc "Bipolar (-1..1) version of rand: (to-bipolar rand). Handy for pan and other signed parameters."
         :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(pan rand2 (fast 8 (seq :hh)))"]
  :see-also ["rand" "to-bipolar" "range2"]}

 :rand {:type "variable"
        :detail "rand — deterministic random signal 0..1 (Tidal timeToRand); (segment 4 rand)"
        :signature "rand"
        :doc "Deterministic random signal in [0,1): Tidal's timeToRand of the sampling time, so it is identical on every run. It is exactly 0 at t = 0. Vary it with (with-seed 7 …)."
        :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 8 (range 1 8 rand))" "(segment 4 (with-seed 7 rand))"]
  :see-also ["irand" "rand2" "perlin" "segment"]}

 :irand {:type "function"
         :detail "(irand n) — random integers 0..n-1 signal; (segment 8 (irand 8))"
         :signature "(irand n)"
         :doc "Random integers 0 to n-1 as a continuous signal (floor of rand times n). n may be a pattern."
         :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 8 (irand 8))"]
  :see-also ["rand" "segment"]}

 :perlin {:type "variable"
          :detail "perlin — smooth random signal 0..1; (range -0.5 0.5 perlin)"
          :signature "perlin"
          :doc "Smooth random signal in [0,1): Perlin-style noise that interpolates between one random value per cycle with a smootherstep curve."
          :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(pan (range -0.5 0.5 perlin) (fast 4 (seq :hh)))"]
  :see-also ["rand" "sine" "range"]}

 :segment {:type "function"
           :detail "(segment n sig) — sample a signal n times per cycle into discrete events"
           :signature "(segment n pat)"
           :doc "Discretise a pattern or signal: n events per cycle, each with the value of pat at its onset. n may be a pattern; one-arg form returns a transformer."
           :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 saw)" "(->> sine (rangex 100 1000) (segment 2))"]
  :see-also ["saw" "range" "rand"]}

 :rangex {:type "function"
          :detail "(rangex lo hi sig) — exponential range of a 0..1 signal; lo,hi > 0"
          :signature "(rangex lo hi pat)"
          :doc "Scale a 0..1 signal exponentially from lo to hi (good for frequencies). lo and hi must be positive. Two-argument form returns a transformer."
          :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 (rangex 20 2000 saw))"]
  :see-also ["range" "range2" "segment"]}

 :range2 {:type "function"
          :detail "(range2 lo hi sig) — range for a bipolar (-1..1) signal"
          :signature "(range2 lo hi pat)"
          :doc "Like range but for a bipolar -1..1 input such as sine2. Two-argument form returns a transformer."
          :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 (range2 200 2000 sine2))"]
  :see-also ["range" "rangex" "from-bipolar"]}

 :to-bipolar {:type "function"
              :detail "(to-bipolar sig) — map 0..1 to -1..1"
              :signature "(to-bipolar pat)"
              :doc "Convert numeric values from 0..1 to -1..1."
              :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 (to-bipolar saw))"]
  :see-also ["from-bipolar" "sine2"]}

 :from-bipolar {:type "function"
                :detail "(from-bipolar sig) — map -1..1 to 0..1"
                :signature "(from-bipolar pat)"
                :doc "Convert numeric values from -1..1 to 0..1."
                :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 (from-bipolar sine2))"]
  :see-also ["to-bipolar" "range2"]}

 :run {:type "function"
       :detail "(run n) — discrete pattern 0..n-1 in one cycle"
       :signature "(run n)"
       :doc "Plays the integers 0 to n-1, one per step, in one cycle. n may be a pattern."
       :category "source"
  :returns "Pattern"
  :side-effects []
  :examples ["(run 4)" "(->> (run 8) (scale :minor :c3))"]
  :see-also ["segment" "seq"]}

 :saw {:type "variable"
       :detail "saw — signal 0→1 each cycle; (segment 4 saw). Voice: (synth :saw pat). Inside defsynth: (saw freq) UGen"
       :signature "saw"
       :doc "Continuous signal: rising ramp 0→1 each cycle (values 0 0.25 0.5 0.75 at quarter points). Not a function: use it bare. The saw synth voice is (synth :saw pat); inside defsynth, (saw freq) is the sawtooth UGen."
       :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 saw)" "(->> (fast 8 (seq :hh)) (amp (range 0.3 1 saw)))"]
  :see-also ["isaw" "saw2" "segment" "synth"]}

 :square {:type "variable"
          :detail "square — signal 0 then 1 (half cycles); (segment 4 square). Voice: (synth :square :pw 0.25 pat)"
          :signature "square"
          :doc "Continuous signal: 0 for the first half of the cycle, 1 for the second. Not a function: use it bare. The square synth voice is (synth :square pat), with :pw for pulse width; inside defsynth, (square freq) is the UGen."
          :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 square)" "(synth :square :pw 0.25 (seq :c3 :e3))"]
  :see-also ["isquare" "square2" "segment" "synth"]}

 :tri {:type "variable"
       :detail "tri — signal triangle 0→1→0; (segment 4 tri). Voice: (synth :tri pat) — band-limited triangle. Inside defsynth: (tri freq) UGen"
       :signature "tri"
       :doc "Continuous signal: triangle wave rising 0→1 in the first half-cycle and falling back in the second. Top-level tri is the signal; inside defsynth bodies (tri freq) is the triangle-wave UGen."
       :category "signal"
  :returns "Pattern"
  :side-effects []
  :examples ["(segment 4 tri)"]
  :see-also ["itri" "tri2" "segment" "defsynth"]}

 :noise      {:type "function"
              :detail "(noise) or (noise :color :pink) — noise burst: :white :pink :brown :dust :lfsr; (synth :noise pat) plays noise per note"
              :signature "(noise) or (noise :color :pink)"
              :doc "A noise burst. The :color option picks :white, :pink, :brown, :dust or :lfsr. (synth :noise pat) plays noise per note."
              :category "source"
              :returns "Pattern"
              :side-effects []
              :examples ["(noise)" "(->> (noise) (amp 0.5) (decay 0.1))" "(noise :color :pink)"]
              :see-also ["synth" "fm"]}

 :fm         {:type "function"
              :detail "(fm :c4 :index 3 :ratio 2) — FM synthesis pair"
              :signature "(fm note :index n :ratio r)"
              :doc "An FM synthesis event for the given note. :index defaults to 1.0 and :ratio to 2.0."
              :category "source"
              :returns "Pattern"
              :side-effects []
              :examples ["(fm :c4 :index 3 :ratio 2)"
                         "(->> (scale :minor :c2 (seq 0 2 4)) (synth :fm :index 5))"]
              :see-also ["synth" "noise" "defsynth"]}

 ;; ── Karplus-Strong plucked strings ──────────────────────────────────────────
 :western    {:type "keyword"
              :detail "(synth :western) — steel-string acoustic guitar, pick attack"
              :signature "(synth :western)"
              :doc "Steel-string acoustic guitar with a pick attack."
              :category "synth"
              :returns "event-param-map"
              :side-effects []
              :description "Steel-string acoustic guitar (dreadnought). Hard pick attack, bright presence, body resonances at 90 Hz and 200 Hz."
              :examples ["(->> (scale :minor :c3 (seq 0 3 5 7)) (synth :western))"
                         "(->> (pure :e2) (synth :western) (decay 0.4))"]
              :see-also ["nylon" "harp" "pizz" "lute" "koto" "mandolin" "synth"]}

 :nylon      {:type "keyword"
              :detail "(synth :nylon) — classical nylon-string guitar, soft fingertip"
              :signature "(synth :nylon)"
              :doc "Classical nylon-string guitar with a soft fingertip attack."
              :category "synth"
              :returns "event-param-map"
              :side-effects []
              :description "Classical nylon-string guitar. Soft fingertip attack (excitation 0.60), darker timbre, treble rolloff above 3.5 kHz."
              :examples ["(->> (scale :major :c4 (seq 0 2 4 5)) (synth :nylon))"
                         "(->> (chord :minor :a3 (slow 2 (seq 0 2 4))) (synth :nylon) (amp 0.7))"]
              :see-also ["western" "lute" "harp" "synth"]}

 :guitar     {:type "keyword"
              :detail "(synth :guitar) — alias for :western"
              :signature "(synth :guitar)"
              :doc "Alias for :western."
              :category "synth"
              :returns "event-param-map"
              :side-effects []
              :description "Alias for :western (steel-string acoustic guitar)."
              :examples ["(->> (scale :minor :c3 (seq 0 3 5 7)) (synth :guitar))"]
              :see-also ["western" "nylon" "synth"]}

 :harp       {:type "keyword"
              :detail "(synth :harp) — bright plucked harp (long decay)"
