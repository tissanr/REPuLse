 :/          {:type "function"
              :detail "(/ a b …) — division"
              :signature "(/ a b ...)"
              :doc "Divides numbers."
              :category "util"
              :returns "number"
              :side-effects []
              :examples ["(/ 10 3)" "(/ n 4)"]
              :see-also ["+" "-" "*" "mod"]}

 ;; ── Comparison ───────────────────────────────────────────────────────────────
 :=          {:type "function"
              :detail "(= a b …) — equality"
              :signature "(= a b ...)"
              :doc "True if all arguments are equal."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(= x 4)" "(= :bd val)"]
              :see-also ["not=" "<" ">" "if"]}

 :not=       {:type "function"
              :detail "(not= a b …) — inequality"
              :signature "(not= a b ...)"
              :doc "True if the arguments are not all equal."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(not= x 0)" "(not= val :bd)"]
              :see-also ["=" "<" ">" "if"]}

 :<          {:type "function"
              :detail "(< a b …) — less than"
              :signature "(< a b ...)"
              :doc "True if the numbers are strictly increasing."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(< x 10)" "(< 0 n 8)"]
              :see-also [">" "<=" ">=" "if"]}

 :>          {:type "function"
              :detail "(> a b …) — greater than"
              :signature "(> a b ...)"
              :doc "True if the numbers are strictly decreasing."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(> x 0)" "(> bpm 120)"]
              :see-also ["<" "<=" ">=" "if"]}

 :<=         {:type "function"
              :detail "(<= a b …) — less than or equal"
              :signature "(<= a b ...)"
              :doc "True if the numbers are non-decreasing."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(<= x 8)" "(<= 0 n 7)"]
              :see-also ["<" ">" ">=" "if"]}

 :>=         {:type "function"
              :detail "(>= a b …) — greater than or equal"
              :signature "(>= a b ...)"
              :doc "True if the numbers are non-increasing."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(>= x 0)" "(>= bpm 60)"]
              :see-also ["<" ">" "<=" "if"]}

 ;; ── Map operations ───────────────────────────────────────────────────────────
 :get        {:type "function"
              :detail "(get m k default?) — look up key in map"
              :signature "(get m k default?)"
              :doc "Looks up a key in a map, with an optional default."
              :category "util"
              :returns "any"
              :side-effects []
              :examples ["(get m :key)" "(get m :k default)"]
              :see-also ["assoc" "merge" "keys"]}

 :assoc      {:type "function"
              :detail "(assoc m k v) — add or replace key in map"
              :signature "(assoc m k v)"
              :doc "Adds or replaces a key in a map."
              :category "util"
              :returns "map"
              :side-effects []
              :examples ["(assoc m :key val)" "(assoc {} :a 1 :b 2)"]
              :see-also ["merge" "get"]}

 :merge      {:type "function"
              :detail "(merge m …) — merge maps"
              :signature "(merge m ...)"
              :doc "Merges maps; later maps win."
              :category "util"
              :returns "map"
              :side-effects []
              :examples ["(merge {:a 1} {:b 2})" "(merge defaults overrides)"]
              :see-also ["assoc" "get"]}

 :keys       {:type "function"
              :detail "(keys m) — list of map keys"
              :signature "(keys m)"
              :doc "The keys of a map."
              :category "util"
              :returns "sequence"
