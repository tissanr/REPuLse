              :doc "Japanese koto with subtle vibrato."
              :category "synth"
              :returns "event-param-map"
              :side-effects []
              :examples ["(->> (scale :pentatonic :d4 (fast 4 (seq 0 2 4 7))) (synth :koto))"
                         "(->> (seq :d4 :f4 :a4) (synth :koto) (amp 0.8))"]
              :see-also ["western" "harp" "mandolin" "synth"]}

 :pizz       {:type "keyword"
              :detail "(synth :pizz) — pizzicato string (short decay)"
              :signature "(synth :pizz)"
              :doc "Pizzicato string with a short decay."
              :category "synth"
              :returns "event-param-map"
              :side-effects []
              :examples ["(->> (scale :minor :c2 (seq 0 :_ 5 :_)) (synth :pizz) (amp 0.6))"
                         "(->> (seq :c3 :g3 :c4) (synth :pizz) (decay 0.3))"]
              :see-also ["western" "harp" "lute" "synth"]}

 :lute       {:type "keyword"
              :detail "(synth :lute) — warm plucked lute"
              :signature "(synth :lute)"
              :doc "Warm plucked lute."
              :category "synth"
              :returns "event-param-map"
              :side-effects []
              :examples ["(->> (scale :major :c4 (seq 0 2 4 5)) (synth :lute))"
                         "(->> (seq :g3 :b3 :d4) (synth :lute) (amp 0.6))"]
              :see-also ["nylon" "pizz" "mandolin" "synth"]}

 :mandolin   {:type "keyword"
              :detail "(synth :mandolin) — bright mandolin with tremolo vibrato"
              :signature "(synth :mandolin)"
              :doc "Bright mandolin with tremolo vibrato."
              :category "synth"
              :returns "event-param-map"
              :side-effects []
