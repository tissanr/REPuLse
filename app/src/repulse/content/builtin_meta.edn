              :doc "True if x is a number."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(number? 440)" "(number? :bd)"]
              :see-also ["string?" "keyword?" "nil?"]}

 :string?    {:type "function"
              :detail "(string? x) — true if x is a string"
              :signature "(string? x)"
              :doc "True if x is a string."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(string? \"hello\")" "(string? :bd)"]
              :see-also ["number?" "keyword?" "nil?"]}

 :keyword?   {:type "function"
              :detail "(keyword? x) — true if x is a keyword"
              :signature "(keyword? x)"
              :doc "True if x is a keyword."
              :category "util"
              :returns "boolean"
              :side-effects []
              :examples ["(keyword? :bd)" "(keyword? 440)"]
              :see-also ["number?" "string?" "nil?"]}

 :nil?       {:type "function"
