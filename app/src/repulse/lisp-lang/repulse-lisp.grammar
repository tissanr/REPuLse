@top Program { expr* }

@detectDelim

expr {
  List | Vector | Map |
  LineComment | Number | String | Keyword | BuiltinName | Symbol
}

List   { OpenParen expr* CloseParen }
Vector { OpenBracket expr* CloseBracket }
Map    { OpenBrace expr* CloseBrace }

@tokens {
  OpenParen    { "(" }
  CloseParen   { ")" }
  OpenBracket  { "[" }
  CloseBracket { "]" }
  OpenBrace    { "{" }
  CloseBrace   { "}" }

  LineComment { ";" ![\n]* }

  // optional sign, decimals and rationals: 12, -12, 0.5, -0.5, 3/16, -1/4
  Number { "-"? @digit+ ("." @digit+)? ("/" @digit+)? }

  String { '"' (![\"\\] | "\\" _)* '"' }

  Keyword { ":" identChar+ }

  BuiltinName {
    // BEGIN GENERATED BuiltinName
    "seq" | "stack" | "pure" | "euclidean" | "cat" | "alt" | "~" | "arrange" |
    "play-scenes" | "song" | "section" | "automate" | "ramp" | "fill" | "play-from" |
    "use" | "fast" | "slow" | "rev" | "every" | "fmap" | "late" | "early" | "sometimes" |
    "often" | "rarely" | "sometimes-by" | "degrade" | "degrade-by" | "choose" |
    "wchoose" | "undegrade-by" | "undegrade" | "degrade-by-with" | "almost-never" |
    "almost-always" | "always" | "never" | "some-cycles-by" | "some-cycles" |
    "choose-with" | "choose-in-with" | "choose-in" | "choose-cycles" | "wchoose-cycles" |
    "randcat" | "wrandcat" | "brand" | "brand-by" | "berlin" | "rand-l" | "randrun" |
    "with-seed" | "shuffle" | "scramble" | "when-pat" | "whenmod" | "apply-n" | "pick" |
    "pick-mod" | "pick-f" | "pick-mod-f" | "pick-out" | "pick-mod-out" | "pick-restart" |
    "pick-mod-restart" | "pick-reset" | "pick-mod-reset" | "inhabit" | "inhabit-mod" |
    "fix" | "jux" | "jux-by" | "off" | "add" | "sub" | "mul" | "div" | "set" | "comp" |
    "slider" | "tween" | "->>" | "->" | "amp" | "attack" | "decay" | "release" | "pan" |
    "scale" | "chord" | "transpose" | "scale-transpose" | "voicing" | "root-notes" |
    "arp" | "arp-with" | "rolled" | "rolled-by" | "superimpose" | "layer" | "echo" |
    "stut" | "echo-with" | "stutter" | "jux-flip" | "jux-flip-by" | "xfade" | "rate" |
    "begin" | "end" | "loop-sample" | "chop" | "striate" | "slice" | "splice" | "fit" |
    "loop-at" | "speed" | "unit" | "accelerate" | "legato" | "sustain" | "cut" |
    "loop-begin" | "loop-end" | "synth" | "signal" | "steady" | "time" | "sine" |
    "cosine" | "isaw" | "itri" | "isquare" | "sine2" | "cosine2" | "saw2" | "isaw2" |
    "tri2" | "itri2" | "square2" | "isquare2" | "rand2" | "rand" | "irand" | "perlin" |
    "segment" | "rangex" | "range2" | "to-bipolar" | "from-bipolar" | "run" | "saw" |
    "square" | "tri" | "noise" | "fm" | "western" | "nylon" | "guitar" | "harp" | "koto" |
    "pizz" | "lute" | "mandolin" | "sax" | "trumpet" | "trumpet-muted" | "trombone" |
    "synth-brass" | "harmon-out" | "harmon-in" | "epiano" | "bell" | "marimba" | "flute" |
    "cutoff" | "resonance" | "hpq" | "bpq" | "shape" | "crush" | "velocity" | "room" |
    "size" | "delay" | "delay-time" | "delay-feedback" | "orbit" | "lp-env" |
    "lp-attack" | "lp-decay" | "lp-sustain" | "lp-release" | "hp-env" | "hp-attack" |
    "hp-decay" | "hp-sustain" | "hp-release" | "bp-env" | "bp-attack" | "bp-decay" |
    "bp-sustain" | "bp-release" | "penv" | "p-attack" | "p-decay" | "p-sustain" |
    "p-release" | "vib" | "vib-mod" | "vowel" | "coarse" | "djf" | "postgain" | "nudge" |
    "delay-sync" | "sin" | "lpf" | "hpf" | "bpf" | "mix" | "gain" | "delay-node" |
    "env-perc" | "env-asr" | "env" | "env-gen" | "bus" | "out" | "in" | "kr" | "fx" |
    "master" | "distort" | "amp-sim" | "waveshape" | "cab" | "eq" | "limiter" | "gate" |
    "flanger" | "vibrato" | "auto-pan" | "ring-mod" | "width" | "chebyshev" | "fold" |
    "bitcrush" | "load-plugin" | "unload-plugin" | "sound" | "bpm" | "stop" | "samples!" |
    "sample-banks" | "bank" | "track" | "mute!" | "unmute!" | "solo!" | "clear!" |
    "tracks" | "upd" | "tap!" | "midi-sync!" | "midi-map" | "midi-out" |
    "midi-clock-out!" | "midi-export" | "freesound-key!" | "freesound!" | "share!" |
    "load-gist" | "export" | "snippet" | "demo" | "tutorial" | "reset!" | "help-export" |
    "snapshot!" | "snapshots" | "restore!" | "rename-snapshot!" | "delete-snapshot!" |
    "history" | "def" | "defn" | "let" | "fn" | "lambda" | "if" | "do" | "defmacro" |
    "defsynth" | "loop" | "recur" | "quasiquote" | "quote" | "symbol" | "conj" | "count" |
    "nth" | "first" | "rest" | "empty?" | "cons" | "concat" | "vec" | "map" | "filter" |
    "reduce" | "range" | "mod" | "quot" | "abs" | "max" | "min" | "identity" | "apply" |
    "list" | "str" | "keyword" | "name" | "number?" | "string?" | "keyword?" | "nil?" |
    "map?" | "seq?" | "vector?" | "not" | "and" | "or" | "+" | "-" | "*" | "/" | "=" |
    "not=" | "<" | ">" | "<=" | ">=" | "get" | "assoc" | "merge" | "keys" | "vals" |
    "ai" | "struct" | "mask" | "invert" | "euclid-legato" | "euclid-legato-rot" | "ply" |
    "ply-with" | "inside" | "outside" | "within" | "swing-by" | "swing" | "brak" |
    "iter" | "iter-back" | "palindrome" | "rot" | "chunk" | "chunk-back" | "fast-chunk" |
    "polymeter" | "timecat" | "first-of" | "last-of" | "compress" | "zoom" | "focus" |
    "fast-gap" | "linger" | "bite" | "ribbon" | "hurry" | "revv" | "repeat-cycles" |
    "trunc" | "press" | "press-by" | "chunk-into" | "chunk-back-into" | "euclidish" |
    "ply-for-each" | "filter-events" | "filter-when" | "bypass" | "beat" | "sew" |
    "stitch" | "binary" | "binary-n" | "unison" | "detune" | "spread" | "sub-osc" | "pw" |
    "pw-rate" | "pw-depth" | "sync" | "tune" | "tone" | "glide" | "accent" | "lp-rate" |
    "lp-depth" | "pulse" | "supersaw" | "acid" | "reese" | "sub-bass" | "fm-bass" |
    "wobble" | "lead" | "sync-lead" | "pluck" | "theremin" | "reed" | "pad" | "strings" |
    "sweep-pad" | "brass-pad" | "trumpet-cup" | "pianoroll" | "punchcard" | "spiral" |
    "scope" | "spectrum"
    // END GENERATED BuiltinName
  }

  Symbol { identStart identChar* }

  identStart { @asciiLetter | "-" | "_" | "!" | "?" | "+" | "*" | "/" | "=" | "<" | ">" | "." | "'" | "~" | "&" }
  identChar  { @asciiLetter | @digit | "-" | "_" | "!" | "?" | "+" | "*" | "/" | "=" | "<" | ">" | "." | "'" | "~" | "&" }

  @precedence { Number, BuiltinName, Symbol }

  space { @whitespace+ | "," }
}

@skip { space }
