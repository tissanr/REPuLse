# REPuLse — environment variables for the serverless functions in api/
#
# Only needed for sign-in, community snippets and the AI proxy (`vercel dev`).
# Patterns, audio, the editor and plugins work without any of these.
#
# Easiest: `vercel link` then `vercel env pull .env.local` to fetch the real values.
# Otherwise: copy this file to .env.local and fill in your own Supabase project.
# .env*.local files are gitignored — never commit real values.

# Supabase project URL — Project Settings → API
SUPABASE_URL=https://your-project.supabase.co

# Supabase anon (public) key — also served to the browser via /api/env; RLS enforces access
SUPABASE_ANON_KEY=your-anon-key

# Supabase service-role key — server-side only, never expose to the client
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional: extra origins allowed to call /api/* (comma-separated).
# Same-origin requests, localhost and the project's *.vercel.app previews are always allowed.
# ALLOWED_ORIGINS=https://repulse.example.com

# GitHub sign-in is configured in Supabase (Authentication → Providers → GitHub),
# not here — see docs/DEPLOYMENT.md.
# VERCEL_URL / VERCEL_BRANCH_URL are set automatically by Vercel.
